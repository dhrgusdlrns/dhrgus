#. EDID: [0106BE28]
#. REC: INFO:NAM1
msgctxt "001BBC"
msgid "Always good to see you, my friend."
msgstr "언제 봐도 반갑네요. 손님."

#. List: 2
#. QuestName = SFFL_BE_EC03
#. SceneName = SFFL_BE_EC03_55_Bobby_Greeting
#. DialogCallType = NPCResponse
#. Speaker = Bobby
#. VoiceType = SFFL_BE_EC03_Bobby_Voice
#. Face = Confident
