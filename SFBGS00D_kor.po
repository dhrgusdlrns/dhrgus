#. VoiceType = SFFL_NPCFDanicaVolkov
#. Face = Friendly
#. SoundFileID = 00B4B71D
#. ScriptNotes = The player has suddenly stopped talking mid-conversation. Are they okay?
#. EDID: [0104EDC7]
#. REC: INFO:NAM1
msgctxt "002239"
msgid "Uh oh! Looks like your jaw quit working. Should I call Maddie? She can fix just about anything."
msgstr "어어! 턱이라도 다친 거야? 매디를 부를까? 웬만한 건 다 고치거든."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMChanHuang
#. VoiceType = SFFL_NPCMChanHuang
#. Face = Confident
#. SoundFileID = 00C9EA30
#. ScriptNotes = The player has suddenly stopped talking mid-conversation. Are they okay?
#. EDID: [0104EDBB]
#. REC: INFO:NAM1
msgctxt "00223A"
msgid "Are we done here?"
msgstr "이제 끝났나?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_IntroScene
#. DialogCallType = NPCResponse
#. Speaker = RishiSaint
#. VoiceType = SFFL_NPCMRishiSaint
#. Face = Confident
#. SoundFileID = 000949AE
#. ScriptNotes = Grave, in danger / to ChanHuang
#. DialogueAfter = ChanHuang: I still think we should consider evacuating.
#. EDID: [010266FC]
#. REC: INFO:NAM1
msgctxt "00223B"
msgid "The Spacers will likely be coming in force."
msgstr "스페이서들이 대규모로 몰려올 가능성이 높습니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_IntroScene
#. DialogCallType = NPCResponse
#. Speaker = RishiSaint
#. VoiceType = SFFL_NPCMRishiSaint
#. Face = Confident
#. SoundFileID = 00EACDB7
#. ScriptNotes = Direct, firm / to ChanHuang
#. EDID: [010266FC]
#. REC: INFO:NAM1
msgctxt "00223C"
msgid "In the meantime, make sure your team is ready."
msgstr "그전에 당신 팀을 준비시켜 두도록 하세요."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_IntroScene
#. DialogCallType = NPCResponse
#. Speaker = RishiSaint
#. VoiceType = SFFL_NPCMRishiSaint
#. Face = Confident
#. SoundFileID = 00C72C26
#. ScriptNotes = Concerned, mulling options / to ChanHuang
#. DialogueBefore = RishiSaint: Damn. We can't risk sending any of your people while we're under imminent threat. &&& ChanHuang: To attack a Spacer stronghold head-on?|No way in hell I'd give that order.|Our contract is security only.
#. EDID: [010266FC]
#. REC: INFO:NAM1
msgctxt "00223D"
msgid "Maybe we offer the job to one of the patrons, then."
msgstr "그럼 고객분들 중 한 명에게 일을 맡겨 보는 게 낫겠군요."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_IntroScene
#. DialogCallType = NPCResponse
#. Speaker = ChanHuang
#. VoiceType = SFFL_NPCMChanHuang
#. Face = Confident
#. SoundFileID = 00EE2554
#. DialogueAfter = RishiSaint: Maybe we offer the job to one of the patrons, then.
#. EDID: [010266FB]
#. REC: INFO:NAM1
msgctxt "00223E"
msgid "Our contract is security only."
msgstr "우리 계약은 경비 업무뿐입니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_IntroScene
#. DialogCallType = NPCResponse
#. Speaker = ChanHuang
#. VoiceType = SFFL_NPCMChanHuang
#. Face = Confident
#. SoundFileID = 007E869C
#. ScriptNotes = Firm refusal
#. EDID: [010266FB]
#. REC: INFO:NAM1
msgctxt "00223F"
msgid "No way in hell I'd give that order."
msgstr "절대 그런 명령은 못 내립니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_IntroScene
#. DialogCallType = NPCResponse
#. Speaker = ChanHuang
#. VoiceType = SFFL_NPCMChanHuang
#. Face = Confident
#. SoundFileID = 00CEA5D9
#. ScriptNotes = Defiant, incredulous
#. DialogueBefore = ChanHuang: None. The warning was vague, probably to keep us off-balance and afraid. &&& RishiSaint: Damn. We can't risk sending any of your people while we're under imminent threat.
#. EDID: [010266FB]
#. REC: INFO:NAM1
msgctxt "002240"
msgid "To attack a Spacer stronghold head-on?"
msgstr "스페이서 거점을 정면으로 공격하란 말입니까?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_IntroScene
#. DialogCallType = NPCResponse
#. Speaker = RishiSaint
#. VoiceType = SFFL_NPCMRishiSaint
#. Face = Confident
#. SoundFileID = 005AFBE0
#. ScriptNotes = Concerned, frustrated. The "Damn" can be a whisper to yourself. / to ChanHuang
#. DialogueBefore = RishiSaint: Did the Spacers give any indication of when they plan to hit us? &&& ChanHuang: None. The warning was vague, probably to keep us off-balance and afraid.
#. DialogueAfter = ChanHuang: To attack a Spacer stronghold head-on?
#. EDID: [010266FA]
#. REC: INFO:NAM1
msgctxt "002241"
msgid "Damn. We can't risk sending any of your people while we're under imminent threat."
msgstr "젠장. 당장 위협을 받는 상황에서 당신 휘하 사람들을 보내는 위험은 감수할 수 없습니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_IntroScene
#. DialogCallType = NPCResponse
#. Speaker = RishiSaint
#. VoiceType = SFFL_NPCMRishiSaint
#. Face = Confident
#. SoundFileID = 00A45B10
#. ScriptNotes = Concerned, thinking, making plans / to ChanHuang
#. DialogueAfter = ChanHuang: None. The warning was vague, probably to keep us off-balance and afraid.
#. EDID: [010266F8]
#. REC: INFO:NAM1
msgctxt "002242"
msgid "Did the Spacers give any indication of when they plan to hit us?"
msgstr "스페이서들이 언제 우리를 치려는 낌새라도 보입니까?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
