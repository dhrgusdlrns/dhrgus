#. EDID: [0105CEB8]
#. REC: INFO:NAM1
msgctxt "001540"
msgid "Hey, Atka, can I borrow a few credits?"
msgstr "저기, 아트카, 크레딧 좀 빌릴 수 있어?"

#. List: 2
#. QuestName = SFFL_MS03_RC_AtkaYura01
#. SceneName = SFFL_MS03_RC_AtkaYura01Scene
