#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Grateful
#. SoundFileID = 00016BF4
#. ScriptNotes = grateful, hopeful, but scared - captive in a dungeon / Grateful / to Player Default
#. DialogueAfter = Player Default: [Attack] You have bad luck. Someone wants you dead, and I'm here to make sure that happens.
#. EDID: [01045E9F]
#. REC: INFO:NAM1
msgctxt "000D0E"
msgid "Thank god, you came to save me, didn't you?"
msgstr "다행이다, 날 구하러 온 거지?"

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_Intro
#. DialogCallType = NPCResponse
#. Speaker = TheArbitrator
#. VoiceType = SFFL_R02_NPCMTheArbitrator
#. Face = Serious
#. SoundFileID = 007ADE2A
#. ScriptNotes = Serious / to Player Default
#. DialogueAfter = Player Default: No need to explain yourself. We've been through this before, you and I.
#. EDID: [01045E9A]
#. REC: INFO:NAM1
msgctxt "000D0F"
msgid "If you're looking for work, I need someone to do a job for me. Preferably someone that isn't burdened by morality. "
msgstr "일거리를 찾고 있다면, 처리해 줬으면 하는 일이 있다. 도덕 따위에 연연하지 않는 녀석이면 좋겠군. "

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_TurnIn_ArbitratorMad
#. DialogCallType = NPCResponse
#. Speaker = TheArbitrator
#. VoiceType = SFFL_R02_NPCMTheArbitrator
#. Face = Serious
#. SoundFileID = 0029138E
#. ScriptNotes = Serious / to Player Default
#. Prompt = It won't happen again.
#. DialogueBefore = Player Default: It won't happen again.
#. DialogueAfter = TheArbitrator: If this happens again and I find out, that will be the end of our dealings together.
#. EDID: [01045E96]
#. REC: INFO:NAM1
msgctxt "000D10"
msgid "It had better not."
msgstr "또 그러면 안 될 거다."

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_TurnIn_ArbitratorMad
#. DialogCallType = NPCResponse
#. Speaker = TheArbitrator
#. VoiceType = SFFL_R02_NPCMTheArbitrator
#. Face = Serious
#. SoundFileID = 00DE104C
#. ScriptNotes = Serious / to Player Default
#. Prompt = I don't know what this is about.
#. DialogueBefore = Player Default: I don't know what this is about.
#. DialogueAfter = TheArbitrator: Explain to me why my intel shows that one of the targets I hired you to kill is still breathing.
#. EDID: [01045EAF]
#. REC: INFO:NAM1
msgctxt "000D11"
msgid "Shut up. "
msgstr "닥쳐. "

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_TurnIn_ArbitratorMad
#. DialogCallType = NPCResponse
#. Speaker = TheArbitrator
#. VoiceType = SFFL_R02_NPCMTheArbitrator
#. Face = Serious
#. SoundFileID = 003D2002
#. ScriptNotes = Serious / to Player Default
#. DialogueBefore = TheArbitrator: Don't get fucking cute with me.
#. DialogueAfter = Player Default: I thought I could get away with it.
#. EDID: [01045EB3]
#. REC: INFO:NAM1
msgctxt "000D12"
msgid "Explain to me why my intel shows that one of the targets I hired you to kill is still breathing. "
msgstr "내 정보에 따르면 내가 죽여달라고 명령한 목표물이 아직 숨이 붙어 있다던데, 이유를 설명해 주실까. "

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_Intro
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = TheArbitrator
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00492873
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: No need to explain yourself. We've been through this before, you and I. &&& TheArbitrator: If that's the case, I guess I'll skip the preamble. &&& TheArbitrator: I'm not gonna beat around the bush. I'm looking for someone that is willing to kill people - people that may or may not deserve it - for money. No questions asked.|Are you that special someone?
#. DialogueAfter = Player Default: However much their life was worth.
#. EDID: [010590C5]
#. REC: INFO:NAM1
msgctxt "000D13"
msgid "How much will you pay me for this?"
msgstr "일을 맡으면 얼마나 줄 건데?"

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_TurnIn_ArbitratorMad
#. DialogCallType = NPCResponse
#. Speaker = TheArbitrator
#. VoiceType = SFFL_R02_NPCMTheArbitrator
#. Face = Serious
#. SoundFileID = 003EACBD
#. ScriptNotes = Serious / to Player Default
#. Prompt = No, I don't think you're stupid.
#. DialogueBefore = Player Default: No, I don't think you're stupid.
#. DialogueAfter = TheArbitrator: Explain to me why my intel shows that one of the targets I hired you to kill is still breathing.
#. EDID: [01045EA4]
#. REC: INFO:NAM1
msgctxt "000D14"
msgid "I'm not convinced. "
msgstr "못 믿겠군. "

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_Intro
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = TheArbitrator
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00BC8AF8
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: No need to explain yourself. We've been through this before, you and I. &&& TheArbitrator: If that's the case, I guess I'll skip the preamble. &&& TheArbitrator: I'm not gonna beat around the bush. I'm looking for someone that is willing to kill people - people that may or may not deserve it - for money. No questions asked.|Are you that special someone?
#. DialogueAfter = Player Default: Good.
#. EDID: [010590CA]
#. REC: INFO:NAM1
msgctxt "000D15"
msgid "I'm used to this type of work. I'm in."
msgstr "이런 일은 자주 해봤지. 할게."

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralCaptiveNPC_Scene
#. DialogCallType = NPCResponse
#. Speaker = CaptiveNPC
