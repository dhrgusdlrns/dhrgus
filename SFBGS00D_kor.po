msgid "You accused me of joking."
msgstr "너는 내가 농담한다고 했지."

#. List: 2
#. QuestName = SFFL_SE01
#. SceneName = SFFL_SE01_250_GrandmaTalk
#. DialogCallType = NPCResponse
#. Speaker = Grandma
#. VoiceType = SFFL_SE01_NPCFGrandma
#. Face = Spaceship / Neutral
#. SoundFileID = 007BDE70
#. ScriptNotes = deadpan, almost ghostly. / Neutral / to Player Default
#. Prompt = Look, I'm just here because you promised food.
#. DialogueBefore = Player Default: Look, I'm just here because you promised food.
#. DialogueAfter = Grandma: I would like to inhabit a body like yours. My current body... I can feel it deteriorating. I feel my skin about to split, my teeth about to burst. I can feel itching behind my eyes.
#. EDID: [0102FCA4]
#. REC: INFO:NAM1
msgctxt "0017BB"
msgid "Allow an old... woman, to speak a moment longer on their own ship. "
msgstr "이...노파가 자기 우주선에서 조금만 더 말하게 해 주겠니. "

#. List: 2
#. QuestName = SFFL_SE01
#. SceneName = SFFL_SE01_250_GrandmaTalk
#. DialogCallType = NPCResponse
