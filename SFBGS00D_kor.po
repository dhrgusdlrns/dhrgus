#. DialogueAfter = Roman: Nice doing business with you.
#. EDID: [01035D92]
#. REC: INFO:NAM1
msgctxt "001CC6"
msgid "Here's the key to Milli's room."
msgstr "밀리 방 열쇠야."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_MainBranchYura01Scene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = SinisterSmile
