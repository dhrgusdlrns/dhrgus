msgctxt "000EBC"
msgid "Account authentication in progress...\n\nAccount verified, checking balance...\n\nInsufficient funds. Transaction canceled."
msgstr ""
"계정 인증 진행 중...\n"
"\n"
"계정 확인 완료, 잔액 확인 중...\n"
"\n"
"잔액 부족. 거래가 취소되었습니다."

#. List: 0
#. EDID: SFFL_Anchorpoint_RishiSaintTerminal_HouseVerifySub
#. REC: TMLM:ITXT
msgctxt "000EBD"
msgid "Pay <Token.Name=AsteroidManorCost> credits"
msgstr "<Token.Name=AsteroidManorCost> 크레딧 주기"

#. List: 0
#. EDID: SFFL_Anchorpoint_RishiSaintTerminal_HouseVerifySub
