#. DialogueAfter = Player Default: He killed Caruso. This was retribution.
#. EDID: [01027CFD]
#. REC: INFO:NAM1
msgctxt "0008A2"
msgid "It's true. I checked his cell. Hal... Hal's dead."
msgstr "사실이야. 감방을 확인했어. 할이... 할이 죽었어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2920_BernhardKilledZenaGreet
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 0056C7B6
