#. SceneName = SFFL_AnchorpointZ03_SC04Medium
#. DialogCallType = NPCResponse
#. Speaker = MilesCutler
#. VoiceType = SFFL_NPCMMilesCutler
#. Face = Irritated
#. SoundFileID = 00676AA2
#. ScriptNotes = A rebuke / Irritated / to Player Default
#. EDID: [0106BBF8]
