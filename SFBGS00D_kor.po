#. Face = Neutral
#. SoundFileID = 007C4845
#. EDID: [0102180C]
#. REC: INFO:NAM1
msgctxt "000237"
msgid "Farewell! Only God knows when we shall meet again, the secretive bastard."
msgstr "잘 가! 우리가 언제 다시 만날지는 신만이 알겠지, 비밀 많은 자식 같으니."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
