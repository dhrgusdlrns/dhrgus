#. EDID: [01053585]
#. REC: INFO:NAM1
msgctxt "001BBF"
msgid "It's a pleasure to see you again, traveler."
msgstr "다시 뵙게 되어 기쁩니다/ 여행자님."

#. List: 2
#. QuestName = SFFL_BE_EC03
#. SceneName = SFFL_BE_EC03_55_Bobby_Greeting
#. DialogCallType = NPCResponse
#. Speaker = Bobby
#. VoiceType = SFFL_BE_EC03_Bobby_Voice
#. Face = Defiant
#. SoundFileID = 00BDD666
