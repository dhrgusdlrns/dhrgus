#. DialogueAfter = Ivica: Hvala puno. You've done this entire outpost a service.
#. EDID: [0102154F]
#. REC: INFO:NAM1
msgctxt "000463"
msgid "[Robot Parts] I've got the parts you requested."
msgstr "[로봇 부품] 네가 요청한 부품을 가져왔어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_b1000_IvicaGreet
#. DialogCallType = NPCResponse
#. Speaker = Ivica
#. VoiceType = SFFL_MS01_NPCMIvicaVukovic
#. Face = Neutral
#. SoundFileID = 004F6B6E
#. DialogueBefore = Ivica: You'll need a power cell to turn it on. Here, this should do the trick.
#. EDID: [010216CE]
#. REC: INFO:NAM1
msgctxt "000464"
msgid "Come back to me when it's done, and we'll upgrade the generator."
msgstr "끝나면 내게 돌아와. 발전기를 업그레이드하자."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_b1000_IvicaGreet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Ivica
