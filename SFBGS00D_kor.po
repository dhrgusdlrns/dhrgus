#. List: 2
#. QuestName = SFFL_MS01_DoctorDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFGraceKim
#. VoiceType = SFFL_MS01_NPCFGraceKim
#. Face = Friendly
#. SoundFileID = 0099D046
#. ScriptNotes = doctor diagnosing patient / Friendly
#. EDID: [010276E2]
#. REC: INFO:NAM1
msgctxt "015FF5"
msgid "Eh. You could probably tough this out if you wanted."
msgstr "음. 원한다면 그냥 버텨도 될 것 같은데."

#. List: 2
#. QuestName = SFFL_MS01_DoctorDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFGraceKim
#. VoiceType = SFFL_MS01_NPCFGraceKim
#. Face = Apologetic
#. SoundFileID = 0080AE89
#. ScriptNotes = doctor explaining to patient who can't pay / Apologetic
#. EDID: [010276EF]
#. REC: INFO:NAM1
msgctxt "015FF6"
