#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0067392A
#. ScriptNotes = / to Player Default
#. DialogueBefore = Sawyer: What just happened...?
#. DialogueAfter = Player Default: You did what? Shit, man... You did that just to leave? Yeah. Yeah, sure. I'll take you back to Anchorpoint... Jackass...
#. EDID: [0104E2A6]
#. REC: INFO:NAM1
msgctxt "0015CF"
msgid "I think I just destroyed your friend group. I want to go now, please."
msgstr "내가 네 친구 무리를 망가뜨린 것 같아. 이제 가고 싶어, 제발."

#. List: 2
#. QuestName = SFFL_MS02
#. SceneName = SFFL_MS02_0480_PARTY
#. DialogCallType = NPCResponse
#. Speaker = Cooper
#. VoiceType = SFFL_NPCCooperCarr
#. Face = Concentrating
#. SoundFileID = 00B6D056
#. ScriptNotes = Quick to comfort his sister. Soft and gentle. / Concentrating / to Wren
#. DialogueBefore = Sadie: Cooper, you're done with that two-faced snake! &&& ... &&& Sawyer: Woah, woah, what's going on here? &&& Sadie: What's going on is my family and I are heading home. Go on, Sawyer, take us home in your new ride. &&& Wren: I'm sorry...
#. DialogueAfter = Cooper: We're going home.
#. EDID: [0104E241]
#. REC: INFO:NAM1
msgctxt "0015D0"
msgid "You don't have to say anything."
msgstr "아무 말 하지 않아도 돼."

#. List: 2
#. QuestName = SFFL_MS02
#. SceneName = SFFL_MS02_0480_PARTY
#. DialogCallType = NPCResponse
#. Speaker = Sadie
#. VoiceType = SFFL_NPCSadieCarr
#. Face = VeryAngry
#. SoundFileID = 00974862
#. ScriptNotes = Very angry. / VeryAngry / to Opal
#. DialogueBefore = Sadie: I know you're the one that's been tormenting my sister! &&& Opal: We've talked about this. I didn't do anything. Why would I be mean to Wren?
#. DialogueAfter = Cooper: Opal, what did Sadie just say?!
#. EDID: [0104E28A]
#. REC: INFO:NAM1
msgctxt "0015D1"
msgid "You keep my sister's name out of your mouth! It doesn't matter who told me. You've been lying to me and been saying who knows what to Wren."
msgstr ""
"내 여동생 이름을 네 입에 올리지 마! 누가 말했는지는 상관없어. 넌 나한테 거짓말을 해 왔고, 렌에게는 무슨 말을 했는지 누가 알아."

#. List: 2
#. QuestName = SFFL_MS02
#. SceneName = SFFL_MS02_0480_PARTY
#. DialogCallType = NPCResponse
#. Speaker = Sadie
#. VoiceType = SFFL_NPCSadieCarr
#. Face = VeryAngry
#. SoundFileID = 0085FB81
#. ScriptNotes = Angry. ignoring what Cooper said and going straight at Opal. / VeryAngry / to Opal
#. DialogueBefore = Sadie: Cooper, you're done with that two-faced snake!
#. DialogueAfter = Opal: We've talked about this. I didn't do anything. Why would I be mean to Wren?
#. EDID: [0104E24E]
#. REC: INFO:NAM1
msgctxt "0015D2"
msgid "I know you're the one that's been tormenting my sister!"
msgstr "네가 내 여동생을 괴롭혀 온 사람이란 거 알아!"

#. List: 2
