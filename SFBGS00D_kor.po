#. EDID: [010217E6]
#. REC: INFO:NAM1
msgctxt "000394"
msgid "Stupid, I know. "
msgstr "멍청했다는 건 알아."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2320_Caspian_Scene
