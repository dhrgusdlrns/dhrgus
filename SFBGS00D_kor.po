#. DialogueBefore = PirateShip03:
#. EDID: [0106C46C]
#. REC: INFO:NAM1
msgctxt "001F2D"
msgid "A third ship has joined the fight. Watch out!"
msgstr "세 번째 우주선이 전투에 합류했습니다. 조심하세요!"

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_150_CompanionInterjection
#. DialogCallType = NPCResponse
#. Speaker = ActiveCompanion
#. VoiceType = NPCMSamCoe
#. Face = Smug
#. SoundFileID = 000EC79F
#. ScriptNotes = Companion reacting to the sudden arrival of two pirate ships as the player's ship is ambushed. / Smug
#. EDID: [0106C46A]
#. REC: INFO:NAM1
msgctxt "001F2E"
msgid "Y'see, what did I tell you? The hair on the back of my neck is never wrong!"
msgstr "봐, 내가 뭐랬어? 내 목덜미 털은 틀리는 법이 없다니까!"

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_150_CompanionInterjection
#. DialogCallType = NPCResponse
#. Speaker = ActiveCompanion
#. VoiceType = NPCMBarrett
#. Face = Angry
#. SoundFileID = 0097E0BD
#. ScriptNotes = Companion reacting to the sudden arrival of two pirate ships as the player's ship is ambushed. / Angry
#. EDID: [0106C469]
#. REC: INFO:NAM1
msgctxt "001F2F"
msgid "We have two bogeys incoming! I knew there was something wrong..."
msgstr "적 우주선 두 척이 접근 중입니다! 뭔가 이상하다는 걸 알고 있었어..."

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_150_CompanionInterjection
#. DialogCallType = NPCResponse
#. Speaker = ActiveCompanion
#. VoiceType = NPCFAndreja
#. Face = Shocked
#. SoundFileID = 00803818
#. ScriptNotes = Companion reacting to the sudden arrival of two pirate ships as the player's ship is ambushed. / Shocked
#. EDID: [0106C467]
#. REC: INFO:NAM1
msgctxt "001F30"
msgid "By the Great Serpent, I was right! Two pirate ships inbound!"
msgstr "위대한 뱀의 이름으로, 내가 맞았어! 해적선 두 척이 접근 중이야!"

#. List: 2
#. QuestName = SFFL_SE04
#. DialogCallType = NPCResponse
#. Speaker = NPCFGenericFemale
#. VoiceType = SFFL_NPCFGenericFemale04
#. Face = Neutral
#. SoundFileID = 00701672
#. EDID: [0106B979]
#. REC: INFO:NAM1
msgctxt "001F32"
msgid "HopeTech vessel to pilot. Please acknowledge. "
msgstr "호프테크 우주선이 조종사에게. 응답 바랍니다."

#. List: 2
#. QuestName = SFFL_SE04
