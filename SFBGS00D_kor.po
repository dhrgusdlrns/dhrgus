#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_x1CarusoDiesArc_160_CarusoDead_Zena01
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 006602B8
#. ScriptNotes = / to Player Default
#. Prompt = Your man attacked me without provocation. It was self-defense.
#. DialogueBefore = Player Default: Your man attacked me without provocation. It was self-defense. &&& Caspian: Liar!
#. DialogueAfter = Player Default: [Attack] I'm done talking. You're all dead.
#. EDID: [01021744]
#. REC: INFO:NAM1
msgctxt "0004C4"
msgid "The Hal we know wouldn't attack anyone unprovoked. So you'll excuse us if we find it hard to believe."
msgstr "우리가 아는 할은 이유 없이 누구를 공격할 사람이 아니야. 그러니 우리가 믿기 어렵다고 해도 이해해 줘."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_200_CarusoTL01
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0098A07C
#. DialogueAfter = Caruso: Human labor is costly. There are a number of processes we need to automate.
#. EDID: [010215E4]
#. REC: INFO:NAM1
msgctxt "0004C5"
msgid "Why the need for a robot?"
msgstr "왜 로봇이 필요한 거지?"

#. List: 2
