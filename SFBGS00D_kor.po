msgid "*Sigh* No, don't be. It's not you."
msgstr "*한숨* 아닙니다. 사과하지 마세요. 당신이 잘못한 것도 아니지 않습니까."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = NPCResponse
#. Speaker = Cutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 0052D901
#. ScriptNotes = / to Player Default
#. DialogueAfter = Player Default: Talking about a problem is the first step in solving it.
#. EDID: [01040487]
#. REC: INFO:NAM1
msgctxt "0013AE"
msgid "What the hell do you care?"
msgstr "근데 그게 당신과 무슨 상관이죠?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = NPCResponse
