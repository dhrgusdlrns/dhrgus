#. Face = Neutral
#. SoundFileID = 0057F7C5
#. DialogueAfter = Yeats: I am accused of stealing supplies. But I contest that notion.
#. EDID: [010216EB]
#. REC: INFO:NAM1
msgctxt "0003C8"
msgid "What are you in here for?"
msgstr "무슨 일로 여기 들어왔죠?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2300_YeatsTL02_Prison
#. DialogCallType = NPCResponse
#. Speaker = Yeats
#. VoiceType = SFFL_MS01_NPCMYeats
#. Face = Neutral
