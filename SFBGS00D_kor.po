#. ScriptNotes = / to Player Default
#. DialogueBefore = CaptiveNPC: Thank god, you came to save me, didn't you?
#. DialogueAfter = Player Default: What? Oh no... haven't I been through enough?
#. EDID: [01045E97]
#. REC: INFO:NAM1
msgctxt "001347"
msgid "Someone really wants you dead, and sent me to kill you."
msgstr "누군가가 널 정말 죽이고 싶어 해서, 날 보내 널 죽이게 했어."

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_Intro
#. DialogCallType = NPCResponse
#. Speaker = TheArbitrator
#. VoiceType = SFFL_R02_NPCMTheArbitrator
#. Face = Serious
#. SoundFileID = 0067FA13
#. ScriptNotes = Serious / to Player Default
#. Prompt = Burdened by morality? What do you mean by that?
#. DialogueAfter = TheArbitrator: No need to explain yourself. We've been through this before, you and I.
#. EDID: [010590C6]
#. REC: INFO:NAM1
msgctxt "001348"
msgid "I need someone that doesn't lie awake at night tortured after having to use their gun."
msgstr "총 좀 쏜 거 가지고 밤마다 괴로워하며 뒤척이는 녀석은 필요 없다."

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_Intro
#. DialogCallType = NPCResponse
#. Speaker = TheArbitrator
#. VoiceType = SFFL_R02_NPCMTheArbitrator
#. Face = Serious
#. SoundFileID = 00970FB6
#. ScriptNotes = Serious / to Player Default
#. Prompt = Burdened by morality? What do you mean by that?
#. DialogueBefore = Player Default: "Burdened by morality?" What do you mean by that?
#. EDID: [010590C6]
#. REC: INFO:NAM1
msgctxt "001349"
msgid "Don't be obtuse. You know what I mean."
msgstr "일부러 못 알아듣는 척하지 마시지. 무슨 말인지 다 알잖나."

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_Intro
#. DialogCallType = NPCResponse
#. Speaker = TheArbitrator
#. VoiceType = SFFL_R02_NPCMTheArbitrator
#. Face = Serious
#. SoundFileID = 008E446E
#. ScriptNotes = Serious / to Player Default
#. Prompt = I'm not looking for work right now.
#. DialogueBefore = Player Default: I'm not looking for work right now.
#. DialogueAfter = TheArbitrator: I'm not gonna beat around the bush. I'm looking for someone that is willing to kill people - people that may or may not deserve it - for money. No questions asked.
#. EDID: [01045EAE]
#. REC: INFO:NAM1
msgctxt "00134A"
msgid "We're done talking, then."
msgstr "그럼 더 할 말이 없군."

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_Intro
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = TheArbitrator
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
