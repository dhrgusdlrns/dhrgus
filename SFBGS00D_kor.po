msgctxt "001C00"
msgid "I can't turn them off."
msgstr "난 그걸 끌 수 없어."

#. List: 2
#. QuestName = SFFL_MS02
#. DialogCallType = NPCResponse
#. Speaker = NPCSadieCarr
#. VoiceType = SFFL_NPCSadieCarr
#. Face = Angry
#. SoundFileID = 00E56004
#. ScriptNotes = In combat. Angry. Trying to fight off Sawyer's turret system on the ship that suddenly turned on and attacked guests. / Angry
#. EDID: [0106B342]
#. REC: INFO:NAM1
msgctxt "001C01"
msgid "They must have been turned on."
msgstr "누군가 켜 놓은 게 분명해."

#. List: 2
#. QuestName = SFFL_MS02
#. DialogCallType = NPCResponse
#. Speaker = NPCSadieCarr
#. VoiceType = SFFL_NPCSadieCarr
#. Face = Angry
#. SoundFileID = 0016DD65
#. ScriptNotes = In combat. Angry. Trying to fight off Sawyer's turret system on the ship that suddenly turned on and attacked guests. / Angry
#. EDID: [0106B341]
#. REC: INFO:NAM1
msgctxt "001C02"
msgid "The system shouldn't be doing this."
msgstr "시스템이 이러면 안 되는데."

#. List: 2
#. QuestName = SFFL_MS02
#. DialogCallType = NPCResponse
#. Speaker = NPCSadieCarr
#. VoiceType = SFFL_NPCSadieCarr
#. Face = Angry
#. SoundFileID = 00F008E4
#. ScriptNotes = In combat. Angry. / Angry
#. EDID: [0106B33E]
#. REC: INFO:NAM1
msgctxt "001C03"
msgid "I can't wait to be rid of you."
msgstr "네가 없어질 날이 기다려져."

#. List: 2
#. QuestName = SFFL_MS02
#. DialogCallType = NPCResponse
#. Speaker = NPCSadieCarr
#. VoiceType = SFFL_NPCSadieCarr
#. Face = Angry
#. SoundFileID = 009B497C
#. ScriptNotes = In combat. Angry. / Angry
#. EDID: [0106B33D]
#. REC: INFO:NAM1
msgctxt "001C04"
msgid "Trust me. You won't be alive for long."
msgstr "날 믿어. 넌 오래 살아 있지 못할 거야."

#. List: 2
#. QuestName = SFFL_MS02
#. DialogCallType = NPCResponse
#. Speaker = NPCOpalWoods
#. VoiceType = SFFL_NPCOpalWoods
#. Face = Angry
#. SoundFileID = 00FD45B2
#. ScriptNotes = In combat. Angry. / Angry
#. EDID: [0106B334]
#. REC: INFO:NAM1
msgctxt "001C05"
msgid "I don't like to start shit, but I'll finish you."
msgstr "난 먼저 시비 거는 건 싫어하지만, 넌 끝장내 주지."

#. List: 2
#. QuestName = SFFL_MS02
#. DialogCallType = NPCResponse
#. Speaker = NPCOpalWoods
#. VoiceType = SFFL_NPCOpalWoods
#. Face = Angry
#. SoundFileID = 001EEF83
#. ScriptNotes = In combat. Angry. / Angry
#. EDID: [0106B331]
#. REC: INFO:NAM1
msgctxt "001C06"
msgid "Why do you have to be so much trouble?"
msgstr "넌 왜 이렇게 골칫거리여야 해?"

#. List: 2
#. QuestName = SFFL_MS02
#. DialogCallType = NPCResponse
#. Speaker = NPCWrenCarr
#. VoiceType = SFFL_NPCWrenCarr
#. Face = InPain
#. SoundFileID = 0055C6C4
#. ScriptNotes = Dying. / InPain
#. EDID: [0106B328]
#. REC: INFO:NAM1
msgctxt "001C07"
msgid "Ngh!"
msgstr "으윽!"

#. List: 2
#. QuestName = SFFL_MS02
#. DialogCallType = NPCResponse
#. Speaker = NPCOpalWoods
#. VoiceType = SFFL_NPCOpalWoods
#. Face = InPain
#. SoundFileID = 00DB1447
#. ScriptNotes = Dying. / InPain
#. EDID: [0106B322]
#. REC: INFO:NAM1
msgctxt "001C08"
msgid "Gh... shit."
msgstr "크윽... 젠장."

#. List: 2
#. QuestName = SFFL_MS02
