#. DialogueBefore = HailingShip:
#. EDID: [010325F1]
#. REC: INFO:NAM1
msgctxt "000CAC"
msgid "No, wait! Dammit!"
msgstr "아니, 잠깐! 젠장!"

#. List: 2
#. QuestName = SFFL_Z01
#. SceneName = SFFL_Z01_120_SEHOY
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Spaceship / Neutral
#. SoundFileID = 006BB99F
#. ScriptNotes = / to Player Default
#. DialogueBefore = HailingShip: In all honesty, I am. &&& Sehoy: You seem like you're more versed in this whole flying thing than me.|Please, have you seen a cargo ship out here? Piloted by a woman named Gabrielle Baker?|I'm her wife. She went on a job and it's been months...
#. DialogueAfter = Player Default: You did? Please tell me she's alright! Where is she?
#. EDID: SFFL_Z01_StarbornDialogue
#. REC: INFO:NAM1
msgctxt "000CAE"
msgid "Yes. I found Gabrielle and her ship."
msgstr "그래. 가브리엘과 그녀의 우주선을 찾았어."

#. List: 2
#. QuestName = SFFL_Z01
#. DialogCallType = NPCResponse
#. Speaker = NPCSehoyBaker
#. VoiceType = SFFL_NPCSehoyBaker
#. Face = Spaceship / Neutral
#. SoundFileID = 00B50692
#. ScriptNotes = Worried. [Spaceship]
#. EDID: [0105663C]
#. REC: INFO:NAM1
msgctxt "000CAF"
msgid "I'll find you, my star."
msgstr "내 별이여, 널 찾아낼게."

#. List: 2
#. QuestName = SFFL_Z01
