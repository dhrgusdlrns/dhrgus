#. ScriptNotes = / to Player Default
#. DialogueBefore = Nice doing business with you. &&& Roman: Who are you?
#. DialogueAfter = Player Default: Nice doing business with you.
#. EDID: [01035883]
#. REC: INFO:NAM1
msgctxt "00128C"
msgid "[Pay <Global=SFFL_MS03_RansomCredits>] Here's your credits."
msgstr "[<Global=SFFL_MS03_RansomCredits> 크레딧 주기] 여기 크레딧이야."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_0100_Yura_IntroBranchNoScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Yura
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00B42D25
#. ScriptNotes = / to Player Default
#. DialogueBefore = Yura: So, how about that house sitting job? You in?
#. DialogueAfter = Player Default: Hard stance! Okay, I mean, I get it. I obviously don't want to do this either.
#. EDID: [0103586D]
#. REC: INFO:NAM1
msgctxt "00128D"
msgid "Now it's definitely a \"no.\""
msgstr "이제는 확실히 \"아니야.\""

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1100_Intercom_IntroScene
#. DialogCallType = NPCResponse
#. Speaker = Intercom
#. VoiceType = SFFL_NPCMGenericMale01
#. Face = Confused
