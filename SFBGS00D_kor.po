#. DialogCallType = NPCResponse
#. Speaker = Bobby
#. VoiceType = SFFL_BE_EC03_Bobby_Voice
#. Face = Question
#. SoundFileID = 0015B926
#. ScriptNotes = Bobby asking player if they want to purchase anything more "regular" items from his shop in a spaceship. / Question / to Player Default
#. DialogueBefore = Bobby: Of course. Ask my lovely wife Fanisha in the back, she'll set you up.
#. DialogueAfter = Bobby: I'd like to see the specials, please.
#. EDID: [0106BDFD]
#. REC: INFO:NAM1
msgctxt "001BC2"
msgid "Anything else for you today, my good friend?"
msgstr "오늘 더 필요한 게 있나요? 손님?"

#. List: 2
#. QuestName = SFFL_BE_EC03
#. SceneName = SFFL_BE_EC03_55_Bobby_Greeting
#. DialogCallType = NPCResponse
