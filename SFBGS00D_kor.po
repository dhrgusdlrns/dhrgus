#. ScriptNotes = About to go into combat. / SinisterSmile / to Player Default
#. Prompt = [Attack] Plan C. I'm taking Milli.
#. DialogueBefore = Player Default: [Attack] Plan C. I'm taking Milli.
#. DialogueAfter = Roman: She hates house sitting. It's boring. So we thought why not liven things up?
#. EDID: [01035D8D]
#. REC: INFO:NAM1
msgctxt "001CC7"
msgid "That's not gonna happen."
msgstr "그런 일은 없을 거야."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_SC_Generic05Scene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Confident
#. SoundFileID = 003C9FE1
#. ScriptNotes = Speech challenge lose: This is someone's pet. You should just hand her over. / Confident / to Player Default
#. EDID: [01059CF2]
#. REC: INFO:NAM1
msgctxt "001CC8"
msgid "And we will, once we get the credits."
msgstr "크레딧을 받으면 그렇게 할 거야."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_MainBranchYura01Scene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 009BA19C
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Not that I know of. &&& Roman: Great. Great! Well, this sure went south quick. &&& Roman: All right, plan B I guess. You want Milli? Do me a favor, and she's all yours.
#. DialogueAfter = Player Default: Just hear me out. You got this petnapping thing all wrong.
#. EDID: [01035D9F]
#. REC: INFO:NAM1
msgctxt "001CC9"
msgid "I don't do favors for petnappers."
msgstr "난 애완동물 납치범한테 호의를 베풀지 않아."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_MainEndScene
#. DialogCallType = NPCResponse
#. Speaker = Atka
#. VoiceType = SFFL_NPCFAtka
#. Face = Grateful
#. SoundFileID = 00AEE3C6
#. ScriptNotes = Grateful / to Player Default
#. DialogueBefore = Atka: If you ever want a little Milli of your own, that's my own personal recipe to give them all the nutrients they need.
#. EDID: [01035DAC]
#. REC: INFO:NAM1
msgctxt "001CCA"
msgid "Thanks for keeping an eye on things while I was gone."
msgstr "내가 없는 동안 잘 돌봐줘서 고마워."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_SC_Generic01Scene
