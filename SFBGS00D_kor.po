#. Face = Nervous
#. SoundFileID = 00F6E26F
#. ScriptNotes = Nervous
#. EDID: [01059D64]
#. REC: INFO:NAM1
msgctxt "000BFD"
msgid "I knew this was a bad idea."
msgstr "애초에 시작하는 게 아니었어."

#. List: 2
#. QuestName = SFFL_MS03
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale / NPCFGenericFemale
