#. Prompt = A thought.
#. DialogueBefore = Player Default: A thought.
#. EDID: [0106C7FA]
#. REC: INFO:NAM1
msgctxt "001126"
msgid "Wrong. Wrong, wrong, wrong. That's too bad."
msgstr "틀렸어. 틀렸어, 틀렸어, 틀렸어. 안됐군."

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Spaceship / Smug
#. SoundFileID = 00B214C8
