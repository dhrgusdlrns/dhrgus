msgid "Damn glad you got here when you did."
msgstr "젠장, 제때 와줘서 정말 다행이네."

#. List: 2
#. QuestName = SFFL_AnchorpointZ01
#. SceneName = SFFL_AnchorpointZ01_StartScene
#. DialogCallType = NPCResponse
