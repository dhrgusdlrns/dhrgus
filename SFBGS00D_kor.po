#. DialogueBefore = Player Default: I don't think I ever did...
#. EDID: [0104E242]
#. REC: INFO:NAM1
msgctxt "0015DB"
msgid "Oh..."
msgstr "아..."

#. List: 2
#. QuestName = SFFL_MS02
#. SceneName = SFFL_MS02_0300Z_Wren_EMP
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Wren
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
