#. VoiceType = SFFL_NPCFGenericFemale04
#. Face = Spaceship / Neutral
#. SoundFileID = 00E08048
#. ScriptNotes = Neutral
#. DialogueBefore = HailingShip: HopeTech vessel to pilot. Please respond to this hail.
#. DialogueAfter = HailingShip: Acknowledged. Stay safe out there.
#. EDID: [0106A316]
#. REC: INFO:NAM1
msgctxt "000A5F"
msgid "Please respond."
msgstr "응답해 주십시오."

#. List: 2
#. QuestName = SFFL_SE03
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Neutral
#. SoundFileID = 00909FD9
#. ScriptNotes = Neutral
#. EDID: [0106D1C4]
#. REC: INFO:NAM1
msgctxt "000A60"
msgid "Wanna play a game?"
msgstr "게임 한판 할래?"

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Spaceship / Neutral
#. SoundFileID = 00DFC866
#. ScriptNotes = Neutral
#. DialogueAfter = Player Default: A potato.
#. EDID: [0106C4CE]
#. REC: INFO:NAM1
msgctxt "000A61"
msgid "What has an eye but cannot see?"
msgstr "눈은 있지만 볼 수 없는 것은?"

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Spaceship / Smug
#. SoundFileID = 00A42811
#. ScriptNotes = Smug
#. DialogueBefore = HailingShip: Fantastic. Amazing! Let the games begin!
#. EDID: [0106C4CE]
#. REC: INFO:NAM1
msgctxt "000A62"
msgid "A classic one to start with. Perhaps you know it? Let's hope you do..."
msgstr "시작은 고전 문제로 하지. 아마 알지도 몰라? 알기를 바라야겠지..."

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Spaceship / Smug
#. SoundFileID = 0026DFB6
#. ScriptNotes = Smug
#. DialogueBefore = HailingShip: Get over here! It's the end of the line!
#. DialogueAfter = HailingShip: Before we enter our grand finale, let me just remind you what you're playing for.
#. EDID: [0106C74D]
#. REC: INFO:NAM1
msgctxt "000A63"
msgid "Hmm, you're not doing so great, buddy. Two riddles down, and two people dead. Get your head in the game!"
msgstr "음, 잘하고 있진 않네, 친구. 수수께끼 두 개가 지나갔고, 사람 둘이 죽었어. 정신 차려!"

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Spaceship / Irritated
#. SoundFileID = 0083401A
#. ScriptNotes = Irritated / to Player Default
#. Prompt = Well, before I agree to anything, I need more info.
#. DialogueBefore = Player Default: Well, before I agree to anything, I need more info.
#. DialogueAfter = HailingShip: Come here, honey, say hi to our contestant! Get over here!
#. EDID: [0106C4F0]
#. REC: INFO:NAM1
msgctxt "000A64"
msgid "More info? Yeah, I've got your info."
msgstr "정보 더 달라고? 그래, 네 정보 여기 있다."

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Spaceship / Smug
#. SoundFileID = 0058AB5E
#. ScriptNotes = Smug / to Player Default
#. Prompt = A backpack.
#. DialogueBefore = Player Default: A backpack.
#. DialogueAfter = HailingShip: Get over here! It's the end of the line!
#. EDID: [0106C745]
#. REC: INFO:NAM1
msgctxt "000A65"
msgid "No, no, no. Wrong answer. A student may very well bring their backpack into class."
msgstr "아니, 아니, 아니. 틀렸어. 학생은 수업에 가방을 가져올 수도 있지."

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Spaceship / Neutral
#. SoundFileID = 0037AE62
#. ScriptNotes = Neutral / to Player Default
#. Prompt = A grenade.
#. DialogueAfter = HailingShip: Time to say bye-bye to this one.
#. EDID: [0106C7F7]
#. REC: INFO:NAM1
msgctxt "000A66"
msgid "Anyone can hold a grenade as long as they want, so long as you don't pull the pin."
msgstr "누구든 수류탄은 원하는 만큼 들고 있을 수 있어. 핀만 뽑지 않는다면."

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Spaceship / Smug
#. SoundFileID = 00B54FD5
#. ScriptNotes = Smug / to Player Default
#. Prompt = A grenade.
#. DialogueBefore = Player Default: A grenade.
#. EDID: [0106C7F7]
#. REC: INFO:NAM1
msgctxt "000A67"
msgid "Heh, I like that answer, but it doesn't quite fit."
msgstr "하, 그 대답 마음에 드는데, 딱 맞지는 않아."

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Spaceship / Neutral
#. SoundFileID = 00D79203
#. ScriptNotes = Neutral / to Player Default
#. Prompt = Breath.
#. DialogueBefore = Player Default: Breath.
#. DialogueAfter = HailingShip: Wow, three for three. Good job. But now I have my own riddle to solve: what the hell am I supposed to do with these hostages now? I can't let 'em go to waste!
#. EDID: [0106C7F3]
#. REC: INFO:NAM1
msgctxt "000A68"
msgid "Hey, good job. That's the right answer, I knew you had it in ya."
msgstr "어이, 잘했어. 정답이야. 네가 해낼 줄 알았다니까."

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Spaceship / Irritated
#. SoundFileID = 00AACFFA
#. ScriptNotes = Irritated / to Player Default
#. Prompt = I don't know.
#. DialogueBefore = Player Default: I don't know.
#. DialogueAfter = HailingShip: Time to say bye-bye to this one.
#. EDID: [0106C7FC]
#. REC: INFO:NAM1
msgctxt "000A69"
msgid "Are you serious? You want these people to die, don't you?"
msgstr "진심이야? 이 사람들이 죽길 바라는 거지?"

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = HailingShip
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Spaceship / Neutral
#. SoundFileID = 004F04C8
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Well, before I agree to anything, I need more info. &&& ... &&& HailingShip: Come here, honey, say hi to our contestant! Get over here! &&& HailingShip: He's insane, help us! He killed the pilot, he- &&& HailingShip: All right, shut up, that's enough. Get on back with the rest of them. Move!|*Ahem* 'Scuse me. Do I have your attention now? Then allow me to explain the rules of my little game.|It's very simple, really. Three lives for three riddles. If you refuse to answer, or if you get a riddle wrong, I kill one of my little friends on board.
#. DialogueAfter = HailingShip: You thought I was bluffing? I do not bluff.
#. EDID: [01072FC1]
#. REC: INFO:NAM1
msgctxt "000A6A"
msgid "I'm not playing your game."
msgstr "네 게임은 안 해."

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = HailingShip
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Spaceship / Neutral
#. SoundFileID = 00EBAA5F
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Well, before I agree to anything, I need more info. &&& ... &&& HailingShip: Come here, honey, say hi to our contestant! Get over here! &&& HailingShip: He's insane, help us! He killed the pilot, he- &&& HailingShip: All right, shut up, that's enough. Get on back with the rest of them. Move!|*Ahem* 'Scuse me. Do I have your attention now? Then allow me to explain the rules of my little game.|It's very simple, really. Three lives for three riddles. If you refuse to answer, or if you get a riddle wrong, I kill one of my little friends on board.
#. DialogueAfter = Player Default: Do. Not. End. This. Hail!
#. EDID: [0106D1AD]
#. REC: INFO:NAM1
msgctxt "000A6B"
msgid "I'm not getting involved in this. I'm leaving."
msgstr "난 이 일에 끼지 않을 거야. 떠날게."

#. List: 2
#. QuestName = SFFL_SE03
#. SceneName = SFFL_SE03_100b_HailingAnswered
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Spaceship / Smug
#. SoundFileID = 0042626F
#. ScriptNotes = about to shoot a hostage / Smug
#. DialogueBefore = HailingShip: Heh, I like that answer, but it doesn't quite fit.|Anyone can hold a grenade as long as they want, so long as you don't pull the pin.
#. DialogueAfter = HailingShip: Wow, three for three. Good job. But now I have my own riddle to solve: what the hell am I supposed to do with these hostages now? I can't let 'em go to waste!
#. EDID: [0106D259]
#. REC: INFO:NAM1
msgctxt "000A6C"
msgid "Time to say bye-bye to this one."
msgstr "이제 이 녀석에게 작별 인사할 시간이야."

#. List: 2
#. QuestName = SFFL_ActionFigures_SarahMorgan
#. SceneName = SFFL_ActionFigures_SarahMorganScene
#. DialogCallType = NPCResponse
#. Speaker = SarahMorgan
#. VoiceType = NPCFSarahMorgan
#. Face = Confident
#. SoundFileID = 00CF76A3
#. DialogueBefore = SarahMorgan: I don't know if proud is the word I'd use. "Exploited" seems like a better fit.
#. DialogueAfter = SarahMorgan: But I also wouldn't be opposed to you tossing it into the nearest incinerator.
#. EDID: [01065C28]
#. REC: INFO:NAM1
msgctxt "000A6D"
msgid "Either way, as collectibles go, it's definitely a conversation piece, so feel free to hold on to it."
msgstr "어쨌든 수집품치고는 확실히 대화 소재가 되니, 가지고 있어도 좋아."

#. List: 2
#. QuestName = SFFL_ActionFigures_SarahMorgan
#. SceneName = SFFL_ActionFigures_SarahMorganScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = SarahMorgan
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00D09C05
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: It is. It's from a set of Colony War Heroes. &&& SarahMorgan: Hero? Is that what they're calling me? I find that term almost offensive. &&& SarahMorgan: I don't like to talk about my past. But suffice to say, my history as a soldier was not without trauma. &&& SarahMorgan: To see me in that uniform, memorialized in this way... I don't know how to feel.
#. DialogueAfter = Player Default: I don't know if I have the mental energy to pursue such a case.
#. EDID: [01065C32]
#. REC: INFO:NAM1
msgctxt "000A6E"
msgid "I'd be looking for a lawyer."
msgstr "나라면 변호사를 찾겠어."

#. List: 2
#. QuestName = SFFL_ActionFigures_SarahMorgan
#. SceneName = SFFL_ActionFigures_SarahMorganScene
#. DialogCallType = NPCResponse
#. Speaker = SarahMorgan
#. VoiceType = NPCFSarahMorgan
#. Face = Neutral
#. SoundFileID = 001EA5C1
#. ScriptNotes = Neutral
#. DialogueBefore = SarahMorgan: Hero? Is that what they're calling me? I find that term almost offensive.
#. DialogueAfter = SarahMorgan: To see me in that uniform, memorialized in this way... I don't know how to feel.
#. EDID: [01065C36]
#. REC: INFO:NAM1
msgctxt "000A6F"
msgid "I don't like to talk about my past. But suffice to say, my history as a soldier was not without trauma."
msgstr "내 과거에 대해 말하는 건 좋아하지 않아. 하지만 군인으로서의 이력이 트라우마 없이 지나가진 않았다고만 해 두지."

#. List: 2
#. QuestName = SFFL_SE_EC02
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_BE_EC02_Dax_Voice
#. Face = Confident
#. SoundFileID = 0038C805
#. ScriptNotes = Dax acting tough while aboard the player's ship as they travel to Neon. / Confident
#. EDID: [0106ACA2]
#. REC: INFO:NAM1
msgctxt "000A70"
msgid "Get me to Neon in one piece and you won't regret it."
msgstr "나를 네온까지 무사히 데려다주면 후회하지 않을 거야."

#. List: 2
#. QuestName = SFFL_SE_EC02
#. DialogCallType = NPCResponse
#. Speaker = SarahMorgan
#. VoiceType = NPCFSarahMorgan
#. Face = Concerned
#. SoundFileID = 00608D67
#. ScriptNotes = Companion commenting about the presence of Dax Shepard, likely a criminal, aboard the player's ship. / Concerned
#. EDID: [0106C81B]
#. REC: INFO:NAM1
msgctxt "000A71"
msgid "You're taking a risk bringing that man aboard."
msgstr "그 남자를 태우는 건 위험을 감수하는 거야."

#. List: 2
#. QuestName = SFFL_SE_EC02
#. DialogCallType = NPCResponse
#. Speaker = SamCoe
#. VoiceType = NPCMSamCoe
#. Face = Somber
#. SoundFileID = 00CBC727
#. ScriptNotes = Companion commenting about the presence of Dax Shepard, likely a criminal, aboard the player's ship. / Somber
#. EDID: [0106C819]
#. REC: INFO:NAM1
msgctxt "000A72"
msgid "Mark my words, he's nothin' but trouble."
msgstr "내 말 명심해. 그는 문제만 일으킬 사람이야."

#. List: 2
#. QuestName = SFFL_SE_EC02
#. DialogCallType = NPCResponse
#. Speaker = Andreja
#. VoiceType = NPCFAndreja
#. Face = Suspicious
#. SoundFileID = 00F001AE
#. ScriptNotes = Companion commenting about the presence of Dax Shepard, either a criminal or a black ops operative, on board the player's ship. / Suspicious
#. EDID: [0106C812]
#. REC: INFO:NAM1
msgctxt "000A73"
msgid "I do not trust this man, and neither should you. Keep an eye on him."
msgstr "나는 이 남자를 믿지 않아. 너도 믿지 않는 게 좋아. 감시해."

#. List: 2
#. QuestName = SFFL_SE_EC02
#. SceneName = SFFL_SE_EC02_860_SecondWarning
#. DialogCallType = NPCResponse
#. Speaker = DaxBurroughs
#. VoiceType = SFFL_BE_EC02_Dax_Voice
#. Face = Angry
#. SoundFileID = 00669AA2
#. ScriptNotes = Warning player not to follow him as he walks off into Neon, his destination. Here Dax is telling the player to move further back from him. / Angry / to Player Default
#. DialogueAfter = DaxBurroughs: Nice knowing you, pal.
#. EDID: [0106D4E6]
#. REC: INFO:NAM1
msgctxt "000A74"
msgid "Further back!"
msgstr "더 뒤로!"

#. List: 2
#. QuestName = SFFL_SE_EC02
#. SceneName = SFFL_SE_EC02_850_FirstWarning
#. DialogCallType = NPCResponse
#. Speaker = DaxBurroughs
#. VoiceType = SFFL_BE_EC02_Dax_Voice
#. Face = Serious
#. SoundFileID = 00CA3FFA
#. ScriptNotes = Warning player not to follow him as he walks off into Neon, his destination. / Serious / to Player Default
#. DialogueAfter = DaxBurroughs: Do you have a death wish, or something? Walk away. Now.
#. EDID: [0106D4EC]
#. REC: INFO:NAM1
msgctxt "000A75"
msgid "I told you not to follow me. I'm not going to tell you again."
msgstr "따라오지 말라고 했지. 다시 말하지 않겠어."

#. List: 2
#. QuestName = SFFL_SE_EC02
#. SceneName = SFFL_SE_EC02_50_CompanionComment
#. DialogCallType = NPCResponse
#. Speaker = ActiveCompanion
#. VoiceType = NPCMBarrett
#. Face = Neutral
#. SoundFileID = 00C63025
#. ScriptNotes = Aboard player's ship, companion commenting on a seeming abandoned derelict ship floating in space in front of them. / Neutral
#. EDID: [0106C80E]
#. REC: INFO:NAM1
msgctxt "000A76"
msgid "Looks like an abandoned ship. Not sure it's worth our time to go inside, but it's your call."
msgstr "버려진 우주선 같아. 안에 들어갈 가치가 있을지는 모르겠지만, 네 판단에 맡길게."

#. List: 2
#. QuestName = SFFL_SE_EC02
#. SceneName = SFFL_SE_EC02_800_WalkingAway
#. DialogCallType = NPCResponse
#. Speaker = DaxBurroughs
#. VoiceType = SFFL_BE_EC02_Dax_Voice
#. Face = Sarcastic
#. SoundFileID = 00221F2D
#. ScriptNotes = Dax walking away from the player and into Neon. Is he sincere? Maybe. / Sarcastic / to DaxDestination
#. DialogueBefore = DaxBurroughs: Don't worry about your money, you'll get it as soon as I talk to my boss.
#. DialogueAfter = DaxBurroughs: I told you not to follow me. I'm not going to tell you again.
#. EDID: [0106D4F2]
#. REC: INFO:NAM1
msgctxt "000A77"
msgid "It's been fun."
msgstr "재미있었어."

#. List: 2
#. QuestName = SFFL_BE_EC02
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_BE_EC02_Dax_Voice
#. Face = Dying
#. SoundFileID = 0073BCBF
#. ScriptNotes = Dying
#. EDID: [0106AD49]
#. REC: INFO:NAM1
msgctxt "000A78"
msgid "You're... a better fighter than you look."
msgstr "너... 보기보다 싸움을 잘하는군."

#. List: 2
#. QuestName = SFFL_BE_EC02
#. SceneName = SFFL_BE_EC02_Dax_SC_Starborn
#. DialogCallType = NPCResponse
#. Speaker = DaxBurroughs
#. VoiceType = SFFL_BE_EC02_Dax_Voice
#. Face = Surprised
#. SoundFileID = 002E4802
#. ScriptNotes = Dax is troubled by the Starborn Player's prophetic-sounding words. / Surprised / to Player Default
#. EDID: [0106AC5C]
#. REC: INFO:NAM1
msgctxt "000A79"
msgid "What...what do you mean by that?"
msgstr "그게... 그게 무슨 뜻이야?"

#. List: 2
#. QuestName = SFFL_BE_EC02
#. SceneName = SFFL_BE_EC02_Dax_SC_Hard03
#. DialogCallType = NPCResponse
#. Speaker = DaxBurroughs
#. VoiceType = SFFL_BE_EC02_Dax_Voice
#. Face = Sarcastic
#. SoundFileID = 00A2D1E7
#. ScriptNotes = Dax giving himself high fives for his own intimidation attempt against the player. Not taking himself as seriously, starting to open up to player. / Sarcastic / to Player Default
#. EDID: [0106AC61]
#. REC: INFO:NAM1
msgctxt "000A7A"
msgid "Well I thought it was impressive."
msgstr "난 인상적이라고 생각했어."

#. List: 2
#. QuestName = SFFL_BE_EC02
#. SceneName = SFFL_BE_EC02_Dax_SC_Intimidate
#. DialogCallType = NPCResponse
#. Speaker = DaxBurroughs
#. VoiceType = SFFL_BE_EC02_Dax_Voice
#. Face = Serious
#. SoundFileID = 00C98301
#. ScriptNotes = Starting to consider taking a different, less violent approach to the confrontation with the player. / Serious / to Player Default
#. EDID: [0106AC6B]
#. REC: INFO:NAM1
msgctxt "000A7B"
msgid "Not really, no. That's a bit too far from home."
msgstr "별로, 아니. 집에서 좀 너무 멀어."

#. List: 2
#. QuestName = SFFL_BE_EC02
#. SceneName = SFFL_BE_EC02_Dax_SC_Med02
#. DialogCallType = NPCResponse
#. Speaker = DaxBurroughs
#. VoiceType = SFFL_BE_EC02_Dax_Voice
#. Face = Defiant
#. SoundFileID = 00EDE504
#. ScriptNotes = Dax would rather shoot it out with the player than discuss with them. / Defiant / to Player Default
#. EDID: [0106AC6A]
#. REC: INFO:NAM1
msgctxt "000A7C"
msgid "Sorry, not interested."
msgstr "미안, 관심 없어."

#. List: 2
#. QuestName = SFFL_BE_EC02
#. SceneName = SFFL_BE_EC02_Dax_SC_Med02
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 003D63C9
#. EDID: [0106AC5A]
#. REC: INFO:NAM1
msgctxt "000A7D"
msgid "I'm sure we can find a mutually beneficial solution."
msgstr "서로에게 이로운 해결책을 찾을 수 있을 겁니다."

#. List: 2
#. QuestName = SFFL_BE_EC02
#. SceneName = SFFL_BE_EC02_Dax_SC_Med01
#. DialogCallType = NPCResponse
#. Speaker = DaxBurroughs
#. VoiceType = SFFL_BE_EC02_Dax_Voice
#. Face = Irritated
#. SoundFileID = 005DBEF0
#. ScriptNotes = Dax acknowledges that the player looks tough, and respects him a bit more for it. / Irritated / to Player Default
#. EDID: [0106AC54]
#. REC: INFO:NAM1
msgctxt "000A7E"
msgid "Yeah, I can tell this isn't your first tussle."
msgstr "그래, 이번이 네 첫 싸움은 아닌 것 같네."

#. List: 2
#. QuestName = SFFL_BE_EC02
#. SceneName = SFFL_BE_EC02_Dax_SC_Easy02
#. DialogCallType = NPCResponse
#. Speaker = DaxBurroughs
#. VoiceType = SFFL_BE_EC02_Dax_Voice
#. Face = Confident
#. SoundFileID = 00CD5B29
#. ScriptNotes = Dax lightening up a bit her as he relaxes and lowers his gun slightly after the player told them it wasn't necessary to point it at them. / Confident / to Player Default
#. EDID: [0106AC65]
#. REC: INFO:NAM1
msgctxt "000A7F"
msgid "Well, one can never be too careful."
msgstr "음, 조심해서 나쁠 건 없지."

#. List: 2
#. QuestName = SFFL_BE_EC02
#. SceneName = SFFL_BE_EC02_200_DaxIntro
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = DaxBurroughs
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00E76914
#. ScriptNotes = / to Player Default
#. DialogueBefore = DaxBurroughs: Move a muscle and I'll shoot. &&& DaxBurroughs: No one needs to get hurt. I just need your ship.
#. DialogueAfter = Player Default: Pretty sure that's none of your business.
#. EDID: [0106AC60]
#. REC: INFO:NAM1
msgctxt "000A80"
msgid "What do you need my ship for?"
msgstr "내 우주선이 왜 필요한 거지?"

#. List: 2
#. QuestName = SFFL_BE_EC02
#. SceneName = SFFL_BE_EC02_300_DaxLowersWeapon
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = DaxBurroughs
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00AE840B
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Let's talk this through. &&& ... &&& DaxBurroughs: All right, we'll do it your way then. &&& DaxBurroughs: I need to get to Neon as fast as possible without being seen. Think you can handle that? &&& DaxBurroughs: I took the fall for someone else after a bank robbery went wrong. I ended up inside for a while.|One day there was an opportunity to get out, and I took it. Then I took this piece of crap ship.|Then I had a grav jump failure, ended up with just enough power for life support, then you showed up.|Is that enough for you? Can we go now?
#. DialogueAfter = Player Default: So that's how it's going to be, huh? All right, I get it.
#. EDID: [0106AC96]
#. REC: INFO:NAM1
msgctxt "000A81"
msgid "Pay me now or die here. It's your choice."
msgstr "지금 돈을 내거나 여기서 죽어. 선택은 네 몫이야."

#. List: 2
#. QuestName = SFFL_SE_EC07_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Friendly
#. SoundFileID = 00E301BE
#. ScriptNotes = Meeting player on the street. Sincerely grateful to the player for rescuing her. / Friendly
#. EDID: [01064826]
#. REC: INFO:NAM1
msgctxt "000A82"
msgid "Hi there!"
msgstr "안녕하세요!"

#. List: 2
#. QuestName = SFFL_SE_EC07_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Friendly
#. SoundFileID = 004BBA88
#. ScriptNotes = Sincerely grateful to the player for rescuing her, if in a hurry. / Friendly
#. EDID: [01064818]
#. REC: INFO:NAM1
msgctxt "000A83"
msgid "I have to run, but if you're ever at GalBank, come and say hi!"
msgstr "가 봐야 하지만, 갤뱅크에 들르면 꼭 인사하러 오세요!"

#. List: 2
#. QuestName = SFFL_SE_EC07_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Happy
#. SoundFileID = 00F219F9
#. ScriptNotes = Sincerely grateful to the player for rescuing her, if in a hurry. / Happy
#. EDID: [01064818]
#. REC: INFO:NAM1
msgctxt "000A84"
msgid "Hi there! So great to see you again!"
msgstr "안녕하세요! 다시 만나서 정말 반가워요!"

#. List: 2
#. QuestName = SFFL_SE_EC07_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Ruby_Voice
#. Face = Confident
#. SoundFileID = 000F93E3
#. ScriptNotes = Ruby meeting the player in the street. / Confident
#. EDID: [0106480F]
#. REC: INFO:NAM1
msgctxt "000A85"
msgid "Why hello there."
msgstr "아, 안녕하세요."

#. List: 2
#. QuestName = SFFL_SE_EC07_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Ruby_Voice
#. Face = Confident
#. SoundFileID = 001D5F89
#. ScriptNotes = Ruby meeting the player in the street. A bit dismissive. / Confident
#. EDID: [0106480A]
#. REC: INFO:NAM1
msgctxt "000A86"
msgid "I should have a free spot somewhere in the next few months."
msgstr "앞으로 몇 달 안에 빈 시간이 하나쯤은 있을 겁니다."

#. List: 2
#. QuestName = SFFL_SE_EC07_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Ruby_Voice
#. Face = Smug
#. SoundFileID = 00BE7CB5
#. ScriptNotes = Ruby meeting the player in the street. / Smug
#. EDID: [0106480A]
#. REC: INFO:NAM1
msgctxt "000A87"
msgid "I'm sorry, I don't have to talk right now, but ask Hannah to book a meeting."
msgstr "죄송하지만 지금은 얘기할 시간이 없습니다. 한나에게 회의 일정을 잡아 달라고 하세요."

#. List: 2
#. QuestName = SFFL_BE_EC07
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Grateful
#. SoundFileID = 0094BFCE
#. ScriptNotes = Sincerely grateful to the player for coming to rescue them. / Grateful
#. EDID: [0106A4DE]
#. REC: INFO:NAM1
msgctxt "000A89"
msgid "I can't tell you how relieved we are to see you."
msgstr "당신을 보니 얼마나 안심되는지 말로 다 못 하겠어요."

#. List: 2
#. QuestName = SFFL_BE_EC07
#. SceneName = SFFL_BE_EC07_120_HannahDialogue
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00BC3D68
#. ScriptNotes = / to Player Default
#. DialogueBefore = HannahFrye: &&& HannahFrye: Thank you so much for coming to our rescue! &&& HannahFrye: Can you find a way to open the door?
#. DialogueAfter = Player Default: That's great! Thank you so much!
#. EDID: [010655D6]
#. REC: INFO:NAM1
msgctxt "000A8A"
msgid "Don't worry, this shouldn't take long."
msgstr "걱정 마, 오래 걸리지 않을 거야."

#. List: 2
#. QuestName = SFFL_BE_EC07
#. SceneName = SFFL_BE_EC07_100_HannahDialogue
#. DialogCallType = NPCResponse
#. Speaker = HannahFrye
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Worried
#. SoundFileID = 00C04B58
#. ScriptNotes = Calling out to the player from behind a large ship door that's been locked. / Worried / to Player Default
#. DialogueAfter = HannahFrye: Thank you so much for coming to our rescue!
#. EDID: [010655D8]
#. REC: INFO:NAM1
msgctxt "000A8B"
msgid "We're in here!"
msgstr "우리 여기 있어요!"

#. List: 2
#. QuestName = SFFL_BE_EC07
#. SceneName = SFFL_BE_EC07_120_HannahDialogue
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = HannahFrye
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00ADEF0D
#. ScriptNotes = / to Player Default
#. DialogueBefore = HannahFrye: &&& HannahFrye: Thank you so much for coming to our rescue! &&& HannahFrye: Can you find a way to open the door?
#. DialogueAfter = Player Default: A few pirates from the first ship we encountered managed to get on board.
#. EDID: [01065FA7]
#. REC: INFO:NAM1
msgctxt "000A8C"
msgid "What happened here?"
msgstr "여기서 무슨 일이 있었죠?"

#. List: 2
#. QuestName = SFFL_BE_EC07
#. SceneName = SFFL_BE_EC07_210_RubyOnly
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = RubyKrause
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00396930
#. ScriptNotes = / to Player Default
#. DialogueBefore = HannahFrye: &&& ... &&& RubyKrause: Thank you, Hannah, I'll handle it from here. &&& RubyKrause: On behalf of the GalBank consortium, thank you for coming to our assistance.|We are in need of a temporary transportation service, as it were. &&& RubyKrause: Are you done thinking now?
#. DialogueAfter = Player Default: I'll have an adequate reward deposited in your account as soon as we land at destination.
#. EDID: [01068032]
#. REC: INFO:NAM1
msgctxt "000A8D"
msgid "What about my compensation for this?"
msgstr "제가 이 일을 하면 받게 될 보상은 뭔가요?"

#. List: 2
#. QuestName = SFFL_BE_EC07
#. SceneName = SFFL_BE_EC07_210_RubyOnly
#. DialogCallType = NPCResponse
#. Speaker = RubyKrause
#. VoiceType = SFFL_SE_EC07_Ruby_Voice
#. Face = Confident
#. SoundFileID = 00B9D594
#. ScriptNotes = Friendly, but business-like. / Confident / to Player Default
#. Prompt = What about my compensation for this?
#. DialogueBefore = Player Default: What about my compensation for this?
#. DialogueAfter = RubyKrause: All right, let's go.
#. EDID: [01068035]
#. REC: INFO:NAM1
msgctxt "000A8E"
msgid "I'll have an adequate reward deposited in your account as soon as we land at destination."
msgstr "목적지에 착륙하는 대로 적절한 보상을 당신 계좌에 입금하겠습니다."

#. List: 2
#. QuestName = SFFL_BE_EC07
#. SceneName = SFFL_BE_EC07_210_RubyOnly
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Ruby_Voice
#. Face = Confident
#. SoundFileID = 00855AF6
#. ScriptNotes = Easygoing, as long as they don't take too much time... / Confident / to Player Default
#. Prompt = All right, let's go.
#. DialogueBefore = Player Default: All right, let's go.
#. DialogueAfter = HannahFrye: Wait, what?
#. EDID: [01068030]
#. REC: INFO:NAM1
msgctxt "000A8F"
msgid "I'm right behind you."
msgstr "바로 뒤에 있어요."

#. List: 2
#. QuestName = SFFL_BE_EC07
#. SceneName = SFFL_BE_EC07_215_HannahReacts
#. DialogCallType = NPCResponse
#. Speaker = RubyKrause
#. VoiceType = SFFL_SE_EC07_Ruby_Voice
#. Face = Confident
#. SoundFileID = 007D42EA
#. ScriptNotes = Ruby trying to reassure the player that Hannah will be fine, while not actually listening to Hannah anymore. / Confident / to Player Default
#. DialogueBefore = RubyKrause: This is a very expensive ship, we can't just abandon it.|You'll be fine. I'll send for you as soon as I get back. &&& HannahFrye: We're in the middle of a minefield!
#. DialogueAfter = RubyKrause: On behalf of the GalBank consortium, thank you for coming to our assistance.
#. EDID: [0106802C]
#. REC: INFO:NAM1
msgctxt "000A90"
msgid "She'll be fine. She's a real trooper."
msgstr "괜찮을 거야. 정말 씩씩한 사람이니까."

#. List: 2
#. QuestName = SFFL_BE_EC07
#. SceneName = SFFL_BE_EC07_230_HannahDialogue
#. DialogCallType = NPCResponse
#. Speaker = HannahFrye
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Nervous
#. SoundFileID = 006285F2
#. ScriptNotes = Hannah wants to get off the derelict ship and away from the minefield as fas as possible, but wants to appear in control. / Nervous / to Player Default
#. DialogueBefore = HannahFrye: Thanks again for taking me with you.
#. EDID: [01069D97]
#. REC: INFO:NAM1
msgctxt "000A91"
msgid "We should probably get on to your ship now."
msgstr "이제 당신 우주선으로 가야 할 것 같아요."

#. List: 2
#. QuestName = SFFL_MS03_RC_RomanYuraFriends01
#. SceneName = SFFL_MS03_RC_RomanYuraFriends01Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Amused
#. SoundFileID = 0050DF0C
#. ScriptNotes = Playful tone. / Amused / to Roman
#. DialogueBefore = Yura: &&& Roman:
#. EDID: [0105CEF6]
#. REC: INFO:NAM1
msgctxt "000A92"
msgid "Hey, at least we got out of there, even if we did have to spend the night hiding in a dumpster."
msgstr "적어도 거기서 빠져나오긴 했잖아. 쓰레기통에 숨어 밤을 보내야 했지만."

#. List: 2
#. QuestName = SFFL_MS03_RC_RomanYuraFriends01
#. SceneName = SFFL_MS03_RC_RomanYuraFriends01Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Friendly
#. SoundFileID = 0052A072
#. ScriptNotes = Friendly / to Roman
#. EDID: [0105CF23]
#. REC: INFO:NAM1
msgctxt "000A93"
msgid "You're welcome to come if you want. Never know what might go down out there."
msgstr "원하면 같이 와도 돼. 밖에서 무슨 일이 벌어질지 모르잖아."

#. List: 2
#. QuestName = SFFL_MS03_RC_RomanYuraFriends01
#. SceneName = SFFL_MS03_RC_RomanYuraFriends01Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Friendly
#. SoundFileID = 00D13241
#. ScriptNotes = Friendly / to Roman
#. DialogueBefore = Roman:
#. EDID: [0105CF23]
#. REC: INFO:NAM1
msgctxt "000A94"
msgid "Just thinking of cruising the Free Lanes. Seeing if there's any jobs out there."
msgstr "그냥 자유 항로를 돌아다녀 볼 생각이야. 일거리가 있나 보려고."

#. List: 2
#. QuestName = SFFL_MS03_RC_RomanYuraFriends01
#. SceneName = SFFL_MS03_RC_RomanYuraFriends01Scene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Happy
#. SoundFileID = 004F8427
#. ScriptNotes = Happy / to Yura
#. DialogueBefore = Roman: &&& Yura:
#. EDID: [0105CED3]
#. REC: INFO:NAM1
msgctxt "000A95"
msgid "You know I always got your back."
msgstr "내가 늘 널 보고 있는 거 알잖아."

#. List: 2
#. QuestName = SFFL_MS03_RC_RomanYuraFriends01
#. SceneName = SFFL_MS03_RC_RomanYuraFriends01Scene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Friendly
#. SoundFileID = 00EDE4CF
#. ScriptNotes = Friendly / to Yura
#. EDID: [0105CEA7]
#. REC: INFO:NAM1
msgctxt "000A96"
msgid "Got any plans later?"
msgstr "나중에 뭐 해?"

#. List: 2
#. QuestName = SFFL_MS03_RC_RomanYuraTogether01
#. SceneName = SFFL_MS03_RC_RomanYuraTogether01Scene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Amused
#. SoundFileID = 00685DF7
#. ScriptNotes = Amused / to Yura
#. DialogueBefore = Roman: &&& Yura:
#. EDID: [0105CEEF]
#. REC: INFO:NAM1
#, fuzzy
msgctxt "000A97"
msgid "Sounds good to me. "
msgstr "좋아. "

#. List: 2
#. QuestName = SFFL_MS03_RC_RomanYuraTogether01
#. SceneName = SFFL_MS03_RC_RomanYuraTogether01Scene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Question
#. SoundFileID = 00F81CC3
#. ScriptNotes = Question / to Yura
#. EDID: [0105CECE]
#. REC: INFO:NAM1
msgctxt "000A98"
msgid "What do you want to do? "
msgstr "뭘 하고 싶어? "

#. List: 2
#. QuestName = SFFL_MS03_RC_AtkaYura03
#. SceneName = SFFL_MS03_RC_AtkaYura03Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Confident
#. SoundFileID = 00A6A775
#. ScriptNotes = Confident / to Atka
#. DialogueBefore = Yura: But she's never really alone. You know I'll watch her. &&& Atka: Are you kidding me right now?
#. DialogueAfter = Atka: *sigh*
#. EDID: [0105CE93]
#. REC: INFO:NAM1
msgctxt "000A99"
msgid "Hey, I love Milli like she was my own. The plants are a different story."
msgstr "난 밀리를 친자식처럼 사랑해. 식물들은 얘기가 다르지만."

#. List: 2
#. QuestName = SFFL_MS03_RC_AtkaYura04
#. SceneName = SFFL_MS03_RC_AtkaYura04Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Happy
#. SoundFileID = 007C3474
#. ScriptNotes = Happy / to Atka
#. DialogueBefore = Atka:
#. EDID: [0105CEB3]
#. REC: INFO:NAM1
msgctxt "000A9A"
msgid "I think we're saving up for a trip to Neon. A real one, you know? "
msgstr "네온으로 여행 갈 돈을 모으는 중인 것 같아. 제대로 된 여행 말이야."

#. List: 2
#. QuestName = SFFL_SE_EC07
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Grateful
#. SoundFileID = 0061B373
#. ScriptNotes = Hannah expressing gratitude to the player after the latter took them back to New Atlantis. / Grateful
#. EDID: [0106A505]
#. REC: INFO:NAM1
msgctxt "000A9B"
msgid "Thanks again for everything. I'll never forget it."
msgstr "모든 일에 다시 한 번 감사해요. 절대 잊지 않을게요."

#. List: 2
#. QuestName = SFFL_SE_EC07
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Ruby_Voice
#. Face = Confident
#. SoundFileID = 00F88272
#. ScriptNotes = Trying to convince herself that she did right by leaving Hannah behind in the minefield. And succeeding. / Confident
#. EDID: [0106A4FC]
#. REC: INFO:NAM1
msgctxt "000A9C"
msgid "I just know that Hannah is going to be all right."
msgstr "한나가 괜찮을 거라는 건 알아요."

#. List: 2
#. QuestName = SFFL_SE_EC07
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Relieved
#. SoundFileID = 005D8BAF
#. ScriptNotes = Hannah is calming down as they leave the minefield behind. / Relieved
#. EDID: [0106A4F6]
#. REC: INFO:NAM1
msgctxt "000A9D"
msgid "Thank you for letting us aboard your ship."
msgstr "당신 우주선에 태워 줘서 고마워요."

#. List: 2
#. QuestName = SFFL_SE_EC07
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Sad
#. SoundFileID = 0030C245
#. ScriptNotes = Inside the player's ship, Hannah reacts in fear as pirate ships attack them. / Sad
#. EDID: [0106A4F3]
#. REC: INFO:NAM1
msgctxt "000A9E"
msgid "Why can't they just leave us alone!"
msgstr "왜 저들은 우리를 그냥 내버려 두지 않는 거야!"

#. List: 2
#. QuestName = SFFL_SE_EC07
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Afraid
#. SoundFileID = 00F73436
#. ScriptNotes = Inside the player's ship, Hannah reacts in fear as pirate ships attack them. / Afraid
#. EDID: [0106A4F2]
#. REC: INFO:NAM1
msgctxt "000A9F"
msgid "Please get us out of here!"
msgstr "제발 여기서 데려가 주세요!"

#. List: 2
#. QuestName = SFFL_SE_EC07
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Worried
#. SoundFileID = 009355A8
#. ScriptNotes = Hannah expresses nervousness about more pirates after she has boarded the player's ship. / Worried
#. EDID: [0106A4EE]
#. REC: INFO:NAM1
msgctxt "000AA0"
msgid "We should leave as soon as we can."
msgstr "가능한 한 빨리 떠나야 해요."

#. List: 2
#. QuestName = SFFL_SE_EC07
#. SceneName = SFFL_SE_EC07_100_HailAccepted
#. DialogCallType = NPCResponse
#. Speaker = GalBankShip
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Spaceship / Question
#. SoundFileID = 00F62D9B
#. ScriptNotes = On the radio: having already talked to the player, Hannah hopes that they will help them out of their dire situation. / Question / to Player Default
#. DialogueBefore = GalBankShip:
#. DialogueAfter = Player Default: Hold on tight, I'm coming aboard.
#. EDID: [010643A0]
#. REC: INFO:NAM1
msgctxt "000AA1"
msgid "Hello again! Have you decided to assist the VP of Acquisitions?"
msgstr "다시 안녕하세요! 인수 담당 부사장을 돕기로 결정하셨나요?"

#. List: 2
#. QuestName = SFFL_SE_EC07
#. SceneName = SFFL_SE_EC07_100_HailAccepted
#. DialogCallType = NPCResponse
#. Speaker = GalBankShip
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Spaceship / Confident
#. SoundFileID = 005F5B8B
#. ScriptNotes = Speaking on the radio: trying to sound as official as possible. / Confident
#. DialogueBefore = GalBankShip: Thank you so much!|Also, um, a pirate or two *may* have already boarded our ship, so... be careful.
#. DialogueAfter = GalBankShip: Hold on tight, I'm coming aboard.
#. EDID: [01064396]
#. REC: INFO:NAM1
msgctxt "000AA2"
msgid "The VP of Acquisitions, Miss Krause, pledges to give you a generous reward if you help her."
msgstr "인수 담당 부사장 크라우스 씨는 도와주시면 후한 보상을 드리겠다고 약속하셨습니다."

#. List: 2
#. QuestName = SFFL_SE_EC07
#. SceneName = SFFL_SE_EC07_100_HailAccepted
#. DialogCallType = NPCResponse
#. Speaker = GalBankShip
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
