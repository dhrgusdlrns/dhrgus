#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00215CDC
#. EDID: [01083C73]
#. REC: INFO:NAM1
msgctxt "01FCD5"
msgid "Might wanna check our weapons."
msgstr "우리 무기 좀 확인해 보는 게 좋겠어."

#. List: 2
#. QuestName = SFFL_MS01_DoctorDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFGraceKim
#. VoiceType = SFFL_MS01_NPCFGraceKim
#. Face = Puzzled
#. SoundFileID = 000E6551
#. ScriptNotes = doctor telling patient there's nothing wrong with them (lightly annoyed/suspicious, but its possible the player isn't aware of that. so go easy.) ;) / Puzzled
#. EDID: [010276DD]
#. REC: INFO:NAM1
msgctxt "020128"
msgid "You seem in perfect health to me. But a little rest and relaxation might help if you are feeling off."
msgstr "내 눈엔 완벽하게 건강해 보여. 그래도 몸이 안 좋다면 조금 쉬는 게 도움이 될지도 몰라."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Puzzled
#. SoundFileID = 00A9A8CB
#. ScriptNotes = Puzzled
#. EDID: [01083DD8]
#. REC: INFO:NAM1
msgctxt "02016F"
msgid "I must be imagining things. Good."
msgstr "내 상상인가 봐. 잘됐네."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = InPain
#. SoundFileID = 00DE335F
#. ScriptNotes = InPain
#. EDID: [01083DBF]
#. REC: INFO:NAM1
msgctxt "020170"
msgid "Oof!"
msgstr "윽!"

#. List: 2
#. QuestName = SFFL_MS01_DoctorDialogue
