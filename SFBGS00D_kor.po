#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2909_CaspianTalkHimDown
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 006CCC19
#. ScriptNotes = / to Sasha
#. DialogueBefore = Zena: Cass, listen to me. I've known you all my life. You're not a killer. Do what's right, and put the gun down. &&& Caspian: You're right Zena. I'm sorry.
#. DialogueAfter = Zena: What was that?
#. EDID: [01027CEB]
#. REC: INFO:NAM1
msgctxt "0008C1"
msgid "Sasha, escort the prisoner to his cell. Regardless of how the vote went down, he'll have to answer for Hal's death."
msgstr "사샤, 죄수를 감방으로 호송해. 투표 결과가 어땠든, 그는 할의 죽음에 대해 책임져야 해."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2909_CaspianTalkHimDown
#. DialogCallType = NPCResponse
#. Speaker = Caspian
