#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Neutral
#. SoundFileID = 00A73130
#. ScriptNotes = Neutral / to Player Default
#. Prompt = Those aren't the same. Loans like that are way worse.
#. EDID: [01083BE1]
#. REC: INFO:NAM1
msgctxt "000110"
msgid "I really do love banks."
msgstr "은행이 참 너무 좋더라고요."

