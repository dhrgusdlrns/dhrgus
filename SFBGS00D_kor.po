#. Face = SinisterSmile
#. SoundFileID = 0019F21A
#. ScriptNotes = SinisterSmile
#. EDID: [0105B43D]
#. REC: INFO:NAM1
msgctxt "0016AB"
msgid "Must be nice having that many credits to blow."
msgstr "그렇게 크레딧을 펑펑 쓸 수 있다니 좋겠네."

#. List: 2
#. QuestName = SFFL_MS03
#. DialogCallType = NPCResponse
#. Speaker = GenericMaleEvenToned / GenericFemaleEvenToned
#. VoiceType = GenericMaleEvenToned / GenericFemaleEvenToned
#. Face = Friendly
#. SoundFileID = 00F09C47
#. ScriptNotes = Friendly
#. EDID: [01059D5F]
#. REC: INFO:NAM1
msgctxt "0016AC"
msgid "Just say the word if you change your mind."
msgstr "마음이 바뀌면 말만 해."

#. List: 2
