#. VoiceType = SFFL_NPCFValeriaHahn
#. Face = Friendly
#. SoundFileID = 009E58FB
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Heard any interesting news lately?
#. EDID: [01031425]
#. REC: INFO:NAM1
msgctxt "000D77"
msgid "Not exactly news, but I'll give you a heads-up anyway."
msgstr "딱히 새 소식은 아니지만, 그래도 미리 알려줄게."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
