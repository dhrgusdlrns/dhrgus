#. SoundFileID = 00E1CB6A
#. ScriptNotes = Apologetic
#. EDID: [0105BFBF]
#. REC: INFO:NAM1
msgctxt "001D3A"
msgid "I'm sorry Yura got you involved in all this."
msgstr "유라 때문에 이런 일에 휘말리게 해서 정말 미안해."

#. List: 2
#. QuestName = SFFL_MS03_Support
