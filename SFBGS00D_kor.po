#. DialogCallType = NPCResponse
#. Speaker = ActiveCompanion
#. VoiceType = NPCMSamCoe
#. Face = Sarcastic
#. SoundFileID = 00A369CE
#. ScriptNotes = Companion reactive after the ship hit a few space mines. / Sarcastic
#. EDID: [0105C392]
#. REC: INFO:NAM1
msgctxt "00155B"
msgid "That one hurt. Are you sure you don't want me to pilot us out of here?"
msgstr "그건 좀 아팠어. 정말 내가 조종해서 여기서 빠져나가게 하지 않을 거야?"

#. List: 2
#. QuestName = SFFL_SE_EC08
#. SceneName = SFFL_SE_EC08_200_SelfDestructCompanion
