#. DialogCallType = NPCResponse
#. Speaker = Cutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 0059299B
#. ScriptNotes = / to Player Default
#. DialogueAfter = Player Default: I understand.
#. EDID: [0104049A]
#. REC: INFO:NAM1
msgctxt "000D8F"
msgid "Anyway, just thought you should know."
msgstr "어쨌든, 그냥 알아둬야 할 것 같아서."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = NPCResponse
#. Speaker = Cutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 0079E01F
#. ScriptNotes = / to Player Default
#. EDID: [0104049A]
#. REC: INFO:NAM1
msgctxt "000D90"
msgid "If you mention me, I'm not sure how he'll react. It might be better not to."
msgstr "내 얘기를 꺼내면 그가 어떻게 반응할지 모르겠어. 안 하는 편이 나을지도 몰라."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = NPCResponse
#. Speaker = Cutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 0001859B
#. ScriptNotes = / to Player Default
#. EDID: [0104049A]
#. REC: INFO:NAM1
msgctxt "000D91"
msgid "My son and I had a falling out. We haven't spoken in years."
msgstr "내 아들과 난 사이가 틀어졌어. 몇 년째 말도 안 했지."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = NPCResponse
#. Speaker = Cutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 0037E532
#. ScriptNotes = / to Player Default
#. DialogueBefore = Cutty: You would do that? Really?|Sorry if I seem a little in shock. Most people around here don't stick their neck out for others.|But thank you. Sincerely.
#. EDID: [0104049A]
#. REC: INFO:NAM1
msgctxt "000D92"
msgid "There's one more thing."
msgstr "한 가지 더 있어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 003B9ACF
#. ScriptNotes = / to Player Default
#. Prompt = I'll get your son back.
#. DialogueAfter = Cutty: There's one more thing.
#. EDID: [0104048B]
#. REC: INFO:NAM1
msgctxt "000D93"
msgid "But thank you. Sincerely."
msgstr "그래도 고마워. 진심으로."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00D196F8
#. ScriptNotes = / to Player Default
#. Prompt = I'll get your son back.
#. EDID: [0104048B]
#. REC: INFO:NAM1
msgctxt "000D94"
msgid "Sorry if I seem a little in shock. Most people around here don't stick their neck out for others."
msgstr "내가 조금 충격받은 것처럼 보인다면 미안해. 여기 사람들 대부분은 남을 위해 위험을 무릅쓰지 않거든."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 0038E379
#. ScriptNotes = / to Player Default
#. Prompt = I'll get your son back.
#. DialogueBefore = Player Default: I'll get your son back.
#. EDID: [0104048B]
#. REC: INFO:NAM1
msgctxt "000D95"
msgid "You would do that? Really?"
msgstr "네가 그렇게 해주겠다고? 정말?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Cutty
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 004C4307
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Are you okay? You seem to be in a bad mood. &&& Cutty: Yeah? Well I just got some bad news.|What the hell do you care?
#. DialogueAfter = Player Default: Already forgotten.
#. EDID: [0104049D]
#. REC: INFO:NAM1
msgctxt "000D96"
msgid "Never mind. Forget I asked."
msgstr "아닙니다. 방금 물어본 건 잊어주시길."

#. List: 2
#. EDID: [0104048C]
#. REC: INFO:NAM1
msgctxt "000D97"
msgid "Text"
msgstr "텍스트"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 008F917E
#. ScriptNotes = / to Player Default
#. Prompt = Talking about a problem is the first step in solving it.
#. DialogueAfter = Cutty: It's my son Miles. He's a cargo pilot. Makes some dangerous runs.
#. EDID: [010404B2]
#. REC: INFO:NAM1
msgctxt "000D98"
msgid "*Sigh* Maybe... maybe you're right."
msgstr "*한숨* 어쩌면... 어쩌면 당신 말이 맞을지도 모르겠군요."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 002F120E
#. ScriptNotes = / to Player Default
#. Prompt = Talking about a problem is the first step in solving it.
#. DialogueBefore = Player Default: Talking about a problem is the first step in solving it.
#. EDID: [010404B2]
#. REC: INFO:NAM1
msgctxt "000D99"
msgid "What are you, a psychiatrist?"
msgstr "뭡니까? 정신과 의사라도 되십니까?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0097CE47
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Are you okay? You seem to be in a bad mood. &&& Cutty: Yeah? Well I just got some bad news.|What the hell do you care?
#. DialogueAfter = Player Default: What are you, a psychiatrist?
#. EDID: [010404AA]
#. REC: INFO:NAM1
msgctxt "000D9A"
msgid "Talking about a problem is the first step in solving it."
msgstr "문제를 털어놓는 것부터 시작해야 문제를 해결을 할 수 있습니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = KillianBrice
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 004875BC
#. ScriptNotes = / to Player Default
#. DialogueBefore = KillianBrice: Killian Brice. I offer various items for a fair price.
#. DialogueAfter = Player Default: Of course. But if you'll give me a moment, there's something else I'd like to talk about.
#. EDID: [01045E63]
#. REC: INFO:NAM1
msgctxt "000D9B"
msgid "I'll take a look at what you've got."
msgstr "뭐가 있는지 한번 볼게."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = KillianBrice
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00A29FE1
#. ScriptNotes = / to Player Default
#. DialogueBefore = KillianBrice: Killian Brice. I offer various items for a fair price.
#. DialogueAfter = Player Default: Then perhaps I can interest you in a unique opportunity.
#. EDID: [01045E5F]
#. REC: INFO:NAM1
msgctxt "000D9C"
msgid "I'm not really looking to buy anything right now."
msgstr "지금은 딱히 뭘 살 생각이 없어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = KillianBrice
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00F749D0
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: So you need a smuggler. &&& KillianBrice: Not quite. There's a little more to it. &&& KillianBrice: Occasionally, in dire circumstances, pilots have to jettison their illicit cargo.|I have the location of one such lost shipment, and I need someone to retrieve it.|There could be other interested parties, so danger is a possibility.
#. DialogueAfter = Player Default: When word gets out that valuable cargo has been lost, one never knows who might come looking.
#. EDID: [0104714B]
#. REC: INFO:NAM1
msgctxt "000D9D"
msgid "Other interested parties?"
msgstr "선적물을 노리는 다른 놈들이라고?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 00455C9B
#. ScriptNotes = / to Player Default
#. Prompt = What exactly are your buyers planning to do with these chemicals?
#. DialogueAfter = KillianBrice: So you need a smuggler.
#. EDID: [01047149]
#. REC: INFO:NAM1
msgctxt "000D9E"
msgid "I neither need, nor want, to know more than that."
msgstr "난 그 이상 알 필요도 없고, 알고 싶지도 않아."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 00DA28E6
#. ScriptNotes = / to Player Default
#. Prompt = What exactly are your buyers planning to do with these chemicals?
#. EDID: [01047149]
#. REC: INFO:NAM1
msgctxt "000D9F"
msgid "Compounds such as these can be mixed into all manner of lethal toxins and recreational substances."
msgstr "이런 화합물은 온갖 치명적인 독소와 오락용 화합물을 섞어 만들지."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 00F7A7BC
#. ScriptNotes = / to Player Default
#. Prompt = What exactly are your buyers planning to do with these chemicals?
#. DialogueBefore = Player Default: What exactly are your buyers planning to do with these chemicals?
#. EDID: [01047149]
#. REC: INFO:NAM1
msgctxt "000DA0"
msgid "It's bad for business to ask such questions, but it's not hard to guess."
msgstr "사업을 하면서 그런 걸 묻는 건 좋지 않은 버릇이라고. 짐작하긴 어렵지 않을 텐데."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_RishiTL02_History
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = RishiSaint
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0081B1DE
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: What's the history of this place? &&& RishiSaint: The station was built over eighty years ago as part of a failed business venture.|The intent was to create a jumping-off point to star systems not yet accessible by grav jump.|When the expected advances in Grav Drive technology didn't happen, the station was abandoned and forgotten.|I stumbled across a reference in some old business records and came for a look.|I found it in a decaying orbit around Algorab II and had it towed here, into the Free Lanes.
#. DialogueAfter = Player Default: It's certainly better off than it was when I found it.
#. EDID: [010516CE]
#. REC: INFO:NAM1
msgctxt "000DA1"
msgid "After all this time, it's impressive the place is still in one piece."
msgstr "그 오랜 시간이 지났는데도 이곳은 아직 멀쩡하다니 인상적이군요."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_RishiTL02_History
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00D59AFE
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: What's the history of this place? &&& RishiSaint: The station was built over eighty years ago as part of a failed business venture.|The intent was to create a jumping-off point to star systems not yet accessible by grav jump.|When the expected advances in Grav Drive technology didn't happen, the station was abandoned and forgotten.|I stumbled across a reference in some old business records and came for a look.|I found it in a decaying orbit around Algorab II and had it towed here, into the Free Lanes.
#. DialogueAfter = Player Default: I called in a few favors to keep costs reasonable.
#. EDID: [010516D8]
#. REC: INFO:NAM1
msgctxt "000DA2"
msgid "You had it towed? That couldn't have been cheap."
msgstr "견인했다고요? 비용이 만만치 않았을 텐데요."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianTL02Job
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Irritated
#. SoundFileID = 00F39340
#. ScriptNotes = Scorn / Irritated / to companion
#. DialogueAfter = companion: Hey, no judgement here.
#. EDID: [01052F1E]
#. REC: INFO:NAM1
msgctxt "000DA3"
msgid "But of course, the simplest minds are always the easiest to entertain."
msgstr "뭐, 대가리가 나쁜 놈들일수록 아무거나 던져줘도 신나라 좋아하거든."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianTL02Job
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Sarcastic
#. SoundFileID = 00D42D83
#. ScriptNotes = Biting sarcasm. / Sarcastic / to companion
#. DialogueBefore = KillianBrice: Nobody else was. |I was grateful for the extended hand of friendship. &&& companion: I wasn't going to say anything, but yeah, I know who you are.|Big embezzling scandal at Vanguard. We had a good laugh about it at the Rock.
#. EDID: [01052F1E]
#. REC: INFO:NAM1
msgctxt "000DA4"
msgid "A Ranger, then? Well, I'm happy to have provided you with some amusement."
msgstr "레인저신가? 뭐, 즐거웠다니 기쁘군."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianTL02Job
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCMSamCoe
#. Face = Confident
#. SoundFileID = 003004F7
#. ScriptNotes = / to KillianBrice
#. DialogueAfter = KillianBrice: *Sigh* Yes, that was me. I made mistakes, but I have paid my debt to society
#. EDID: [01052F36]
#. REC: INFO:NAM1
msgctxt "000DA5"
msgid "Big embezzling scandal at Vanguard. We had a good laugh about it at the Rock."
msgstr "뱅가드에서 대형 횡령 스캔들이 있었어. 더 락에서 우리끼리 한참 웃었지."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianTL02Job
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCMSamCoe
#. Face = Confident
#. SoundFileID = 00796BBE
#. ScriptNotes = / to KillianBrice
#. DialogueBefore = Player Default: Good thing he was there for you. &&& KillianBrice: Nobody else was. |I was grateful for the extended hand of friendship.
#. EDID: [01052F36]
#. REC: INFO:NAM1
msgctxt "000DA6"
msgid "I wasn't going to say anything, but yeah, I know who you are."
msgstr "아무 말도 안 하려 했는데, 흠, 누군지 기억나네."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCMSamCoe
#. Face = Confident
#. SoundFileID = 00A0843C
#. ScriptNotes = Sarcasm. Sam knows this is heading into illegal territory. / to Player Default
#. DialogueBefore = Player Default: I'm <Alias=Player>. Good to meet you. &&& KillianBrice: Likewise. And may I say, your timing is fortunate. &&& KillianBrice: I have a network of buyers interested in obtaining rare and dangerous chemical compounds.|Being controlled substances, a permit is required to transport the compounds.|Of course, for the resourceful ship's captain, there are always other options.
#. DialogueAfter = Player Default: So you need a smuggler.
#. EDID: [01052F28]
#. REC: INFO:NAM1
msgctxt "000DA7"
msgid "Here we go. Kinda knew this was coming."
msgstr "시작됐네. 이럴 줄 알았어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_ValeriaTL03_Background
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCMBarrett
#. Face = Confident
#. SoundFileID = 00A9DBB2
#. ScriptNotes = / to ValeriaHahn
#. DialogueAfter = ValeriaHahn: Now that I've told you my life's story, how about a drink?
#. EDID: [01052F32]
#. REC: INFO:NAM1
msgctxt "000DA8"
msgid "But paying off those medical bills is no small thing, so maybe it's a fair trade."
msgstr "그래도 그 의료비를 갚는 건 작은 일이 아니니, 어쩌면 공정한 거래일지도 몰라."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_ValeriaTL03_Background
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCMBarrett
#. Face = Confident
#. SoundFileID = 00EC3E3D
#. ScriptNotes = / to ValeriaHahn
#. EDID: [01052F32]
#. REC: INFO:NAM1
msgctxt "000DA9"
msgid "On the one hand, he's taking advantage of a desperate mother."
msgstr "한편으로는, 그는 절박한 어머니를 이용하고 있어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_ValeriaTL03_Background
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCMBarrett
#. Face = Confident
#. SoundFileID = 00A3275B
#. ScriptNotes = Conflicted, mulling it over / to ValeriaHahn
#. DialogueBefore = Player Default: That's very generous. &&& ValeriaHahn: It might seem that way, but he's making a tidy profit.|I had to agree to pay ten percent extra as interest.|What choice did I have?
#. EDID: [01052F32]
#. REC: INFO:NAM1
msgctxt "000DAA"
msgid "I'm not sure how I feel about that."
msgstr "그걸 어떻게 받아들여야 할지 모르겠어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_DanicaTL01
#. DialogCallType = NPCResponse
#. Speaker = DanicaVolkov
#. VoiceType = SFFL_NPCFDanicaVolkov
#. Face = Friendly
#. SoundFileID = 008BD207
#. ScriptNotes = Friendly / to Player Default
#. DialogueBefore = Player Default: Have you got any ships for sale?
#. EDID: [01054A5D]
#. REC: INFO:NAM1
msgctxt "000DAB"
msgid "Yep! See for yourself."
msgstr "그럼! 직접 보라고."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_DanicaTL01
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00365313
#. ScriptNotes = / to Player Default
#. EDID: [01054A4C]
#. REC: INFO:NAM1
msgctxt "000DAC"
msgid "Have you got any ships for sale?"
msgstr "우주선을 거래하고 싶다. 파는 게 있나?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_DanicaTL02
#. DialogCallType = PlayerDialogue
#. Speaker = Player
