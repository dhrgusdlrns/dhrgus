#. EDID: [0106BE21]
#. REC: INFO:NAM1
msgctxt "001BC0"
msgid "Please traveler, do come in. Don't be shy."
msgstr "여행자님, 부디 들어오세요. 부끄러워하지 마시고요."

#. List: 2
#. QuestName = SFFL_BE_EC03
#. SceneName = SFFL_BE_EC03_55_Bobby_Greeting
#. DialogCallType = NPCResponse
#. Speaker = Bobby
#. VoiceType = SFFL_BE_EC03_Bobby_Voice
