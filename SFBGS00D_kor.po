#. VoiceType = SFFL_NPCFValeriaHahn
#. Face = Friendly
#. SoundFileID = 007131C2
#. ScriptNotes = / to Actor02
#. DialogueAfter = Actor02: No, we should not.
#. EDID: [01031722]
#. REC: INFO:NAM1
msgctxt "0017AA"
msgid "Maybe we should charge less for the drinks, at least until the quality improves."
msgstr "적어도 품질이 나아질 때까진 술값을 좀 낮춰야 할지도 몰라."

#. List: 2
#. QuestName = SFFL_Anchorpoint_RandConv03_RishiValeria
#. SceneName = SFFL_Anchorpoint_RandConv02_SceneCOPY0000
#. DialogCallType = NPCResponse
#. Speaker = Actor01
