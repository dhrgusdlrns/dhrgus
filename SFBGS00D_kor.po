#. EDID: [0106BE24]
#. REC: INFO:NAM1
msgctxt "001BBE"
msgid "Good to see you again, traveler! Please come in!"
msgstr "다시 만나 반갑습니다. 여행자님! 어서 들어오세요!"

#. List: 2
#. QuestName = SFFL_BE_EC03
#. SceneName = SFFL_BE_EC03_55_Bobby_Greeting
#. DialogCallType = NPCResponse
#. Speaker = Bobby
