#. EDID: SFFL_SE_EC06SharedInfo01
#. REC: INFO:NAM1
msgctxt "001F28"
msgid "Mayday! Mayday! We are in need of immediate assistance."
msgstr "메이데이! 메이데이! 즉각적인 지원이 필요합니다."

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_Pirate01_Scene
