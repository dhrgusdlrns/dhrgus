#. EDID: [010343BB]
#. REC: INFO:NAM1
msgctxt "000C9B"
msgid "Sounds like you've got experience with this kind of thing."
msgstr "이런 일에 경험이 좀 있나 보군."

#. List: 2
#. QuestName = SFFL_AnchorpointZ01
#. SceneName = SFFL_AnchorpointZ01_StartScene
