#. Face = Serious
#. SoundFileID = 009CEE47
#. ScriptNotes = Serious / to Player Default
#. DialogueAfter = Player Default: Nothing I haven't done before. Give me the details.
#. EDID: [0102A434]
#. REC: INFO:NAM1
msgctxt "00133C"
msgid "Are you that special someone? "
msgstr "너는 그런 특별한 부류의 인간인가? "

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_Intro
#. DialogCallType = NPCResponse
#. Speaker = TheArbitrator
#. VoiceType = SFFL_R02_NPCMTheArbitrator
#. Face = Serious
#. SoundFileID = 00C55D89
#. ScriptNotes = stoic - obviously not bothered by how evil what he is saying could come across / Serious / to Player Default
#. DialogueBefore = TheArbitrator: If that's the case, I guess I'll skip the preamble.
#. EDID: [0102A434]
#. REC: INFO:NAM1
msgctxt "00133D"
msgid "I'm not gonna beat around the bush. I'm looking for someone that is willing to kill people - people that may or may not deserve it - for money. No questions asked."
msgstr ""
"빙빙 돌려 말하지 않겠다. 돈을 받고 사람을 죽일 녀석을 찾고 있다. 죽을 만한 사람이든 아니든 상관 않고 죽일 녀석 말이다. 질문은 "
"받지 않겠다."

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralNPC_Scene
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale / NPCFGenericFemale
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
