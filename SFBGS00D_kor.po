#. DialogueAfter = ActiveCompanion: A third ship has joined the fight. Watch out!
#. EDID: [0106B166]
#. REC: INFO:NAM1
msgctxt "000A5A"
msgid "Let me at 'em!"
msgstr "내가 해치우게 해!"

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_Pirate01_Scene
#. DialogCallType = NPCResponse
#. Speaker = PirateShip02
#. VoiceType = SFFL_NPCFGenericFemale02
#. Face = Spaceship / Angry
#. SoundFileID = 0004862A
#. ScriptNotes = Aggressive pirates grav jumping into the area to attach the player's ship in an ambush. / Angry
#. DialogueBefore = PirateShip01:
#. EDID: [0106B16C]
#. REC: INFO:NAM1
msgctxt "000A5B"
msgid "Nowhere to run, nowhere to hide!"
msgstr "도망칠 곳도, 숨을 곳도 없다!"

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_100_HailAccepted
