#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Thinking
#. SoundFileID = 00E2DD4B
#. ScriptNotes = Speech challenge win: We're talking about a milliwhale here, right? / Thinking / to Player Default
#. EDID: [01059D17]
#. REC: INFO:NAM1
