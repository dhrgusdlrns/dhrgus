#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00167430
#. EDID: [01083D0A]
#. REC: INFO:NAM1
msgctxt "01C0E9"
msgid "Got any fungi?"
msgstr "아무 버섯이나 있어요?"

#. List: 2
#. QuestName = SFFL_MS01_DoctorDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFGraceKim
#. VoiceType = SFFL_MS01_NPCFGraceKim
#. Face = Apologetic
#. SoundFileID = 00E62864
#. ScriptNotes = doctor bracing patient for painful procedure about to happen / Apologetic
#. EDID: [010276ED]
#. REC: INFO:NAM1
msgctxt "01C505"
msgid "I won't lie. You're gonna feel this. But try your best to sit still..."
msgstr "거짓말은 안 할게. 좀 아플 거야. 그래도 최대한 가만히 있어..."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00BAB480
#. EDID: [01083C7B]
#. REC: INFO:NAM1
msgctxt "01C539"
msgid "Weapon's busted. I'll go get my wrench."
msgstr "무기가 고장 났어. 렌치 가져올게."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00B261B4
#. EDID: [01083E4F]
#. REC: INFO:NAM1
msgctxt "01CA1F"
msgid "They're dead. Good for them."
msgstr "죽었네. 잘됐네."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Surprised
#. SoundFileID = 008DDC05
#. ScriptNotes = Surprised
#. EDID: [01083CFF]
#. REC: INFO:NAM1
msgctxt "01CA20"
msgid "Must've been my imagination. It does that."
msgstr "내 상상이었나 봐. 원래 그래."

#. List: 2
#. QuestName = SFFL_MS01_DoctorDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFGraceKim
#. VoiceType = SFFL_MS01_NPCFGraceKim
#. Face = Neutral
#. SoundFileID = 00D1FDD4
#. ScriptNotes = asking to sell some of your healing supplies
#. EDID: [010276E9]
#. REC: INFO:NAM1
msgctxt "01CE3A"
msgid "I trust you'll put this to good use."
msgstr "이걸 잘 써먹을 거라고 믿어."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00B99852
#. EDID: [01083D71]
#. REC: INFO:NAM1
msgctxt "01CE6D"
msgid "Oh you're back. Everyone here's been talking about you behind it. Not me though. I don't care."
msgstr "오, 돌아왔네. 여기 있는 모두가 네 뒤에서 네 얘기하고 있었어. 난 아니지만. 관심 없거든."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 003245CC
#. EDID: [01083D74]
#. REC: INFO:NAM1
msgctxt "01CE6E"
msgid "Bore me. I dare you."
msgstr "나를 지루하게 해 봐. 어디 한번."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Angry
#. SoundFileID = 00D2311E
#. ScriptNotes = Angry
#. EDID: [01083D25]
#. REC: INFO:NAM1
msgctxt "01CE6F"
msgid "Grenade."
msgstr "수류탄."

#. List: 2
#. QuestName = SFFL_SE_KT02_SailingHighSeas
#. DialogCallType = NPCResponse
#. Speaker = AudioOnly
#. VoiceType = SFFL_NPCMGenericMale02
#. Face = Neutral
#. SoundFileID = 001D2927
#. EDID: [010388DC]
#. REC: INFO:NAM1
msgctxt "01CEFE"
msgid "If I don't see a pirate in the next hour, I'm shooting one of the help."
msgstr "다음 한 시간 안에 해적이 안 보이면, 일꾼 중 하나를 쏠 거야."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 0007DFBA
#. EDID: [01083CF0]
#. REC: INFO:NAM1
msgctxt "01D2CC"
msgid "Nice, you repaired the weapon."
msgstr "좋아, 무기를 고쳤네."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 005CFAA5
#. EDID: [01083CE2]
#. REC: INFO:NAM1
msgctxt "01D2CD"
msgid "Death marches on. So should we."
msgstr "죽음은 계속해서 전진해요. 우리도 그래야죠."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 004D7998
#. EDID: [01083C82]
#. REC: INFO:NAM1
msgctxt "01D2CE"
msgid "Uh huh. I'm sure you have your reasons."
msgstr "응, 그래. 네 나름의 이유가 있겠지."

#. List: 2
#. QuestName = SFFL_MS01_DoctorDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFGraceKim
#. VoiceType = SFFL_MS01_NPCFGraceKim
#. Face = Puzzled
#. SoundFileID = 007D8897
#. ScriptNotes = doctor telling patient there's nothing wrong with them (lightly annoyed/suspicious, but its possible the player isn't aware of that. so go easy.) ;) / Puzzled
#. EDID: [010276DC]
#. REC: INFO:NAM1
msgctxt "01D79F"
msgid "I see nothing here that needs healing. Nothing physical anyway."
msgstr "치료가 필요한 건 여기 없어 보여. 적어도 육체적으로는."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 002B9E2C
#. EDID: [01083D70]
#. REC: INFO:NAM1
msgctxt "01D7CF"
msgid "Yeah, I'm bored."
msgstr "그래, 지루해."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = InPain
#. SoundFileID = 0067552D
#. ScriptNotes = InPain
#. EDID: [01083C19]
#. REC: INFO:NAM1
msgctxt "01D7D0"
msgid "I-I need...help..."
msgstr "도... 도움이... 필요해..."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = InPain
#. SoundFileID = 0005C1A2
#. ScriptNotes = InPain
#. EDID: [01083DBB]
#. REC: INFO:NAM1
msgctxt "01D7D1"
msgid "Ugh!"
msgstr "으윽!"

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00CC6AB3
#. EDID: [01083CF5]
#. REC: INFO:NAM1
msgctxt "01D7D2"
msgid "Weapon's online, back to shooting stuff."
msgstr "무기가 온라인이야. 다시 쏠 시간이네."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 0091CB88
#. EDID: [01083CDF]
#. REC: INFO:NAM1
msgctxt "01D7D6"
msgid "If your watch starts beeping like that it's usually a good sign to keep going."
msgstr "시계가 그렇게 삑삑대는 건, 보통은 그냥 계속 가라는 좋은 신호죠."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00D07935
#. EDID: [01083CDB]
#. REC: INFO:NAM1
msgctxt "01D7D7"
msgid "The warnings are just suggestions, really."
msgstr "경고신호 같은 건 그냥 참고만 하는 거죠. 뭐."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 0012D427
#. EDID: [01083D0D]
#. REC: INFO:NAM1
msgctxt "01D7D8"
msgid "I've got a dead spider in my bag if you want it."
msgstr "내 가방에 죽은 거미가 있는데, 원하면 줄게요."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Angry
#. SoundFileID = 002C3566
#. ScriptNotes = Angry
#. EDID: [01083CCC]
#. REC: INFO:NAM1
msgctxt "01DC47"
msgid "Guess we're doing this."
msgstr "이걸 하게 되는 모양이네."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Nervous
#. SoundFileID = 0088B008
#. ScriptNotes = Player is about to get attacked, so combat line, but Muria-esque / Nervous
#. EDID: [01083D01]
#. REC: INFO:NAM1
msgctxt "01DC48"
msgid "Oh boy."
msgstr "오 이런."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00405550
#. ScriptNotes = Salvaging after the battle.
#. EDID: [01083C71]
#. REC: INFO:NAM1
msgctxt "01DC49"
msgid "Time for dessert."
msgstr "디저트 시간이다."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00E984B2
#. EDID: [01083C7E]
#. REC: INFO:NAM1
msgctxt "01DC4B"
msgid "Guess it was something I said."
msgstr "내가 한 말 때문이었나 보네."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00428C42
#. EDID: [01083E35]
#. REC: INFO:NAM1
msgctxt "01DC4C"
msgid "You need to introduce me to your dealer."
msgstr "중개상 좀 알려주세요."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 005C0550
#. EDID: [01083D43]
#. REC: INFO:NAM1
msgctxt "01E0F9"
msgid "The shields need more power. You should probably get on that."
msgstr "보호막에 전력이 더 필요해. 아마 네가 처리해야 할걸."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 006B4FE8
#. EDID: [01083DD1]
#. REC: INFO:NAM1
msgctxt "01E0FD"
msgid "*Sigh* Here we go..."
msgstr "*한숨* 또 시작이네요..."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 0096B468
#. EDID: [01083E37]
#. REC: INFO:NAM1
msgctxt "01E0FE"
msgid "Chems are just magic potions with different packaging."
msgstr "약물이나 마법 물약이나 포장만 다를 뿐이죠."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 001670DB
#. EDID: [01083E26]
#. REC: INFO:NAM1
msgctxt "01E0FF"
msgid "I hope you don't assign me to work on this rock. It's too... pretty."
msgstr "나를 이 바위에서 일하게 배정하지 않았으면 좋겠어. 너무... 예쁘잖아."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00E8C52B
#. EDID: [01083DE7]
#. REC: INFO:NAM1
msgctxt "01E100"
msgid "This place looks dirty."
msgstr "여긴 더러워 보이네."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00A830A9
#. EDID: [01083CE1]
#. REC: INFO:NAM1
msgctxt "01E101"
msgid "This place isn't safe. We should build a home here."
msgstr "위험한 곳이네요. 여기에 집을 짓죠."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00373143
#. EDID: [01083CDC]
#. REC: INFO:NAM1
msgctxt "01E102"
msgid "Your watch sure likes to make noise."
msgstr "그 시계 참 시끄럽게 구네요."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Neutral
#. SoundFileID = 00C560AA
#. ScriptNotes = Neutral
#. EDID: [01083D68]
#. REC: INFO:NAM1
msgctxt "01E58C"
msgid "I think for my next job, I'll be something low key, like a waitress, or a cannibal."
msgstr "다음 직장은 좀 조용한 걸로 할까 봐. 웨이트리스나 식인종 같은 거."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = InPain
#. SoundFileID = 00A697E7
#. ScriptNotes = InPain
#. EDID: [01083DC4]
#. REC: INFO:NAM1
msgctxt "01E58D"
msgid "Unh!"
msgstr "으윽!"

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 005CA239
#. EDID: [01083D23]
#. REC: INFO:NAM1
msgctxt "01E58E"
msgid " Let's hope everyone on their side dies."
msgstr "저쪽 사람들 전부 죽었으면 좋겠네."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00CD64E0
#. EDID: [01083D49]
#. REC: INFO:NAM1
msgctxt "01E58F"
msgid "Shields are overrated anyway."
msgstr "보호막은 어차피 과대평가됐어."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 0006F5B7
#. EDID: [01083E20]
#. REC: INFO:NAM1
msgctxt "01E594"
msgid "I hope we find sentient life here. I'd love to introduce them to the concept of credit cards."
msgstr "여기서 지성체를 발견하면 좋겠네. 신용카드라는 개념을 소개해 주고 싶어."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Angry
#. SoundFileID = 006D5B5F
#. ScriptNotes = Angry
#. EDID: [01083C9B]
#. REC: INFO:NAM1
msgctxt "01EA47"
msgid "Ready, fight."
msgstr "준비, 싸워."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00AD1910
#. EDID: [01083DFB]
#. REC: INFO:NAM1
msgctxt "01EA49"
msgid "Does Neon have schools? Or did they find a way to eradicate children?"
msgstr "네온에도 학교가 있나? 아니면 아이들을 없애는 방법을 찾아낸 건가?"

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Angry
#. SoundFileID = 00A47D33
#. ScriptNotes = Angry
#. EDID: [01083CB7]
#. REC: INFO:NAM1
msgctxt "01EEC7"
msgid "Try me."
msgstr "덤벼 봐."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00DD28E2
#. EDID: [01083C79]
#. REC: INFO:NAM1
msgctxt "01EEC8"
msgid "Weapons need repairs."
msgstr "무기를 수리해야 해."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00C65510
#. EDID: [01083E00]
#. REC: INFO:NAM1
msgctxt "01EECD"
msgid "I used to know soemone who worked at MAST. Talked in their sleep. So I don't trust their agents to keep secrets."
msgstr "예전에 MAST에서 일하던 사람을 알았어. 잠꼬대를 하더라. 그래서 난 MAST 요원들이 비밀을 지킨다고 믿지 않아."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Suspicious
#. SoundFileID = 00A0F810
#. ScriptNotes = Suspicious
#. EDID: [01083C52]
#. REC: INFO:NAM1
msgctxt "01F3C2"
msgid "I don't think we're the only ones here."
msgstr "우리만 있는 것 같진 않아."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00D91AC9
#. EDID: [01083DCB]
#. REC: INFO:NAM1
msgctxt "01F3C3"
msgid "Hey, beats walking."
msgstr "뭐, 걷는 것보단 낫죠."

#. List: 2
#. QuestName = SFFL_MS01_DoctorDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFGraceKim
#. VoiceType = SFFL_MS01_NPCFGraceKim
#. Face = Confident
#. SoundFileID = 0075CEC5
#. ScriptNotes = doctor sending patient on their way after treatment. "more or less" half joking / half serious, under breath / Confident
#. EDID: [010276D1]
#. REC: INFO:NAM1
msgctxt "01F780"
msgid "There, good as new. More or less."
msgstr "됐어, 새것 같아. 대충은."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Angry
#. SoundFileID = 002040D4
#. ScriptNotes = Angry
#. EDID: [01083C9A]
#. REC: INFO:NAM1
msgctxt "01F7BF"
msgid "Here they come."
msgstr "온다."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00B0614C
#. EDID: [01083E51]
#. REC: INFO:NAM1
msgctxt "01F7C0"
msgid "They're dead. Guess this place is now haunted."
msgstr "죽었네. 이제 이곳은 유령 들린 곳이겠군."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00D0E184
#. EDID: [01083DFA]
#. REC: INFO:NAM1
msgctxt "01F7C1"
msgid "You can smell vice in the air.  No, wait, that's just garbage."
msgstr "공기 중에서 악덕의 냄새가 나. 아니, 잠깐. 그냥 쓰레기 냄새네."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Puzzled
#. SoundFileID = 00A15208
#. ScriptNotes = Puzzled
#. EDID: [01083C2B]
#. REC: INFO:NAM1
msgctxt "01FCD3"
msgid "I feel like they're still close by."
msgstr "아직 가까이에 있는 것 같아."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Angry
#. SoundFileID = 009C3E2B
#. ScriptNotes = Angry
#. EDID: [01083CB0]
#. REC: INFO:NAM1
msgctxt "01FCD4"
msgid "Time's up."
msgstr "시간 끝."

#. List: 2
