#. QuestName = SFFL_SE01
#. SceneName = SFFL_SE01_260_AteFood
#. DialogCallType = NPCResponse
#. Speaker = Grandma
#. VoiceType = SFFL_SE01_NPCFGrandma
#. Face = Nervous
