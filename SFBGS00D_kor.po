msgid "And I'm sure we can't."
msgstr "우린 안될 거야 아마."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_0100_Yura_IntroMainScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Yura
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00E1ADA0
#. ScriptNotes = / to Player Default
#. DialogueBefore = Yura: So, how about that house sitting job? You in?
#. DialogueAfter = Player Default: You don't have time to care for an innocent, helpless little pet?
#. EDID: [0103587B]
#. REC: INFO:NAM1
msgctxt "001292"
msgid "I don't have time for this."
msgstr "이럴 시간 없는데."

