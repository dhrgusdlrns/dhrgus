#. Speaker = Actor02
#. VoiceType = SFFL_NPCMRishiSaint
#. Face = Confident
#. SoundFileID = 007F4D15
#. ScriptNotes = / to Actor01
#. EDID: [01031724]
#. REC: INFO:NAM1
msgctxt "0017A8"
msgid "Beverage sales are a staple of this operation. A pillar."
msgstr "음료 판매가 운영의 핵심입니다. 기둥 같은 거죠."

#. List: 2
#. QuestName = SFFL_Anchorpoint_RandConv03_RishiValeria
#. SceneName = SFFL_Anchorpoint_RandConv02_SceneCOPY0000
