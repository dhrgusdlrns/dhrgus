#. VoiceType = SFFL_NPCFYura
#. Face = Confident
#. SoundFileID = 00F5CACE
#. ScriptNotes = Confident / to Player Default
#. Prompt = A milli-what?
#. DialogueBefore = Player Default: A milli-what?
#. DialogueAfter = Yura: Count us in.
#. EDID: [01059CBC]
#. REC: INFO:NAM1
msgctxt "002133"
msgid "And don't worry, she's small, tame, doesn't even bite."
msgstr "걱정 마. 작고 온순하고, 물지도 않아."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_0100_Yura_IntroMainScene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Amused
#. SoundFileID = 00FE67BA
