#. VoiceType = SFFL_MS01_NPCMBernhardKleiber
#. Face = VeryAngry
#. SoundFileID = 0015005A
#. ScriptNotes = VeryAngry / to Player Default
#. Prompt = [Lie] Yep. It was a thriving community, what were you were blabbering about?
#. DialogueBefore = Player Default: [Lie] Yep. It was a thriving community, what were you were blabbering about?
#. DialogueAfter = Bernhard: Based on what I saw, it would've been a fine outpost, had your luck been better.
#. EDID: [01026B82]
#. REC: INFO:NAM1
msgctxt "0006C3"
msgid "Do not mock me, explorer. Not about that. I've gone to blows for far less."
msgstr "나를 조롱하지 마라, 탐험가. 그 일만은 안 된다. 나는 훨씬 사소한 일로도 주먹다짐을 한 적이 있어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3100_Bernhard_Greet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Bernhard
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00F74BD7
#. ScriptNotes = / to Player Default
#. DialogueBefore = Bernhard: You again? Did you ever find Shinar?
#. DialogueAfter = Player Default: Do not mock me, explorer. Not about that. I've gone to blows for far less.
#. EDID: [01026B79]
#. REC: INFO:NAM1
msgctxt "0006C4"
msgid "[Lie] Yep. It was a thriving community, what were you were blabbering about?"
msgstr "[거짓말] 응. 번성하던 공동체였어. 네가 지껄이던 건 뭐였지?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3100_Bernhard_Greet
#. DialogCallType = NPCResponse
#. Speaker = Bernhard
#. VoiceType = SFFL_MS01_NPCMBernhardKleiber
#. Face = Neutral
#. SoundFileID = 00A47900
#. ScriptNotes = / to Player Default
#. Prompt = I found a graveyard.
#. DialogueBefore = Player Default: I found a graveyard.
#. DialogueAfter = Bernhard: And to think, the one responsible for their deaths is still roaming free.
#. EDID: [01026C13]
#. REC: INFO:NAM1
msgctxt "0006C5"
msgid "Yes, the graves of brilliant scientists, laborers, parents and spouses."
msgstr "그래, 뛰어난 과학자들, 노동자들, 부모와 배우자들의 무덤이지."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3100_Bernhard_Greet
#. DialogCallType = NPCResponse
#. Speaker = Bernhard
#. VoiceType = SFFL_MS01_NPCMBernhardKleiber
#. Face = Angry
#. SoundFileID = 002CF3EF
#. ScriptNotes = Angry
#. DialogueBefore = Bernhard: *Scoffs* Outsiders will not know the pain that man has caused.
#. DialogueAfter = Bernhard: Understood. Give me the coordinates, and I will put the nail in his oversized coffin.
#. EDID: [01026BE7]
#. REC: INFO:NAM1
msgctxt "0006C6"
msgid "But I suppose that is why you are here. You want me to bear witness."
msgstr "하지만 그래서 네가 여기 온 거겠지. 내가 증언하길 원하는 거야."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3100_Bernhard_Greet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Bernhard
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00286AF1
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: It's okay. It's going to take time to process. &&& Bernhard: You're right. I just thought I'd feel better. But it's more complicated than that. &&& Bernhard: *Sigh* Either way, thank you, stranger. While I don't know if closure will ever come, it's good to know others will not befall the same fate.
#. DialogueAfter = Bernhard: What? You found him? And how is he? Dead? Tortured? No, neither are good enough for that man!
#. EDID: [01026C14]
#. REC: INFO:NAM1
msgctxt "0006C7"
msgid "There is a way to get closure. I found Caruso."
msgstr "마무리할 방법이 있어. 카루소를 찾았어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3100_Bernhard_Greet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00C31F0F
#. ScriptNotes = / to Player Default
