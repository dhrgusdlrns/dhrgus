#. Speaker = ActiveCompanion
#. VoiceType = NPCFAndreja
#. Face = Disbelief
#. SoundFileID = 00C0EECD
#. ScriptNotes = Disbelief
#. EDID: [01080452]
#. REC: INFO:NAM1
msgctxt "00155C"
msgid "I cannot believe you just did that. Again."
msgstr "네가 방금 또 그랬다는 게 믿기지 않아."

#. List: 2
#. QuestName = SFFL_SE_EC08
#. SceneName = SFFL_SE_EC08_200_SelfDestructCompanion
#. DialogCallType = NPCResponse
#. Speaker = ActiveCompanion
#. VoiceType = NPCFAndreja
#. Face = Nervous
#. SoundFileID = 00B2660A
#. ScriptNotes = Nervous
#. EDID: [01080451]
#. REC: INFO:NAM1
msgctxt "00155D"
msgid "What did you just do? Should we go back to the ship? I feel we should go back to the ship."
msgstr "방금 뭘 한 거야? 우주선으로 돌아가야 하나? 난 우주선으로 돌아가야 할 것 같은데."

#. List: 2
#. QuestName = SFFL_SE_EC08
#. SceneName = SFFL_SE_EC08_200_SelfDestructCompanion
#. DialogCallType = NPCResponse
#. Speaker = ActiveCompanion
#. VoiceType = NPCFSarahMorgan
#. Face = Irritated
#. SoundFileID = 007C84BD
#. ScriptNotes = Irritated
#. DialogueBefore = ActiveCompanion:
#. EDID: [01080467]
#. REC: INFO:NAM1
msgctxt "00155E"
msgid "Remind me to stay on the ship next time you want to pull off this kind of stunt."
msgstr "다음에 이런 무모한 짓을 하고 싶어지면, 난 우주선에 남아 있으라고 상기시켜 줘."

#. List: 2
#. QuestName = SFFL_SE_EC08
#. SceneName = SFFL_SE_EC08_200_SelfDestructCompanion
#. DialogCallType = NPCResponse
#. Speaker = ActiveCompanion
#. VoiceType = NPCFAndreja
#. Face = Thinking
#. SoundFileID = 003E81FE
#. ScriptNotes = Thinking
#. DialogueBefore = ActiveCompanion:
#. EDID: [0108045D]
#. REC: INFO:NAM1
msgctxt "00155F"
msgid "I thought I was one to take risks, but I can see you have me beat."
msgstr "위험 감수는 내가 좀 한다고 생각했는데, 넌 나보다 한 수 위구나."

#. List: 2
#. QuestName = SFFL_SE_EC08
#. SceneName = SFFL_SE_EC08_150_BoardingCompanionInterjection
#. DialogCallType = NPCResponse
#. Speaker = ActiveCompanion
#. VoiceType = NPCFSarahMorgan
#. Face = Nervous
#. SoundFileID = 00CC14D4
#. ScriptNotes = Nervous / to BoardableDerelict_CockpitDoor
#. EDID: [01080476]
#. REC: INFO:NAM1
msgctxt "001560"
msgid "I don't know about you, but I'm not getting a great feeling from this place."
msgstr "넌 어떤지 모르겠지만, 난 이곳 느낌이 별로 안 좋아."

#. List: 2
#. QuestName = SFFL_SE_EC08
#. SceneName = SFFL_SE_EC08_150_BoardingCompanionInterjection
#. DialogCallType = NPCResponse
#. Speaker = ActiveCompanion
#. VoiceType = NPCMSamCoe
#. Face = Serious
#. SoundFileID = 00E34717
#. ScriptNotes = Serious / to BoardableDerelict_CockpitDoor
#. EDID: [01080469]
#. REC: INFO:NAM1
msgctxt "001561"
msgid "Let's be quick about this. I'd hate for one of those mines to go off while we're in here."
msgstr "빨리 끝내자. 우리가 여기 있는 동안 저 지뢰 중 하나라도 터지면 끔찍할 거야."

#. List: 2
#. EDID: [01054A6B]
#. REC: INFO:NAM1
msgctxt "001563"
msgid "Okay, but maybe you should take a look."
msgstr "알겠어요. 그래도 한 번 봐야 할 것 같은데요."

#. List: 2
#. QuestName = SFFL_Anchorpoint_RandConv06_ChanKillian
