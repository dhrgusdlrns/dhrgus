#. Face = Defiant
#. SoundFileID = 00618747
#. ScriptNotes = Defiant
#. EDID: [0106B989]
#. REC: INFO:NAM1
msgctxt "000B8C"
msgid "Ha! You wouldn't dare!"
msgstr "하! 감히 못 할걸!"

#. List: 2
#. QuestName = SFFL_SE_EC01
#. DialogCallType = NPCResponse
#. Speaker = Voice
#. VoiceType = SFFL_BE_EC01_Gloria_Voice
#. Face = Happy
#. SoundFileID = 00B1A219
#. ScriptNotes = Sincerely grateful to player for rescuing her from deep space and a potentially angry stepfather. / Happy
#. EDID: [0104DEAB]
#. REC: INFO:NAM1
msgctxt "000B8D"
msgid "See you around, maybe."
msgstr "어쩌면 또 보자."

#. List: 2
