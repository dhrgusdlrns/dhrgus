#. EDID: [0106C8D0]
#. REC: INFO:NAM1
msgctxt "001553"
msgid "Look, that pirate ship is aiming straight for them!"
msgstr "봐, 저 해적선이 곧장 그들을 겨냥하고 있어!"

#. List: 2
#. QuestName = SFFL_Anchorpoint_RandConv10_ChanValeria_Z01
#. SceneName = SFFL_Anchorpint_RandConv10_ChanValeria_Z01_Scene
