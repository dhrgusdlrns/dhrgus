#. DialogueAfter = Player Default: Then it's a fight. So be it!
#. EDID: [0102160A]
#. REC: INFO:NAM1
msgctxt "00050C"
msgid "[Attack] I think they'll be just fine without you."
msgstr "[공격] 너 없이도 다들 괜찮을 것 같은데."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_120_Caruso_Greet
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Serious
#. SoundFileID = 005A9932
#. ScriptNotes = Serious
#. DialogueBefore = Player Default: You're a known criminal. I'm guessing there's probably a bounty on your head too. &&& companion: And surely you know what comes next.
#. DialogueAfter = Caruso: Follow me.
#. EDID: [01021639]
#. REC: INFO:NAM1
msgctxt "00050D"
msgid "Wait. Not here. Not in front of the boy."
msgstr "기다려. 여기서는 안 돼. 아이 앞에서는 안 돼."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_140_Caruso_Greet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Caruso
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0033E44D
#. ScriptNotes = / to Player Default
