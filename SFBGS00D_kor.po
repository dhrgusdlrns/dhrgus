msgctxt "000491"
msgid "Why the anger toward the robot?"
msgstr "왜 로봇에게 그렇게 화가 나 있죠?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_b1000_IvicaGreet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Ivica
