#. Prompt = I don't think I ever did...
#. EDID: [0104E242]
#. REC: INFO:NAM1
msgctxt "0015D9"
msgid "Thank you. I'm going to talk to her."
msgstr "고마워요. 그녀와 얘기해 볼게요."

#. List: 2
#. QuestName = SFFL_MS02
#. SceneName = SFFL_MS02_0300Z_Wren_EMP
