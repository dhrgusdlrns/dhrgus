#. VoiceType = SFFL_MS01_NPCFGraceKim
#. Face = Neutral
#. SoundFileID = 008F430E
#. ScriptNotes = doctor examining patient
#. EDID: [010276FA]
#. REC: INFO:NAM1
msgctxt "0205E4"
msgid "Let's take a look..."
msgstr "어디 보자..."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Suspicious
#. SoundFileID = 00C71DCA
#. ScriptNotes = Suspicious
#. EDID: [01083C4E]
#. REC: INFO:NAM1
msgctxt "020A63"
msgid "I think I hear something."
msgstr "뭔가 들리는 것 같아."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Nervous
