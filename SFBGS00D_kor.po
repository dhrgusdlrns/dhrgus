#. DialogCallType = NPCResponse
#. Speaker = NPCFYura
#. VoiceType = SFFL_NPCFYura
#. Face = Friendly
#. SoundFileID = 00372615
#. ScriptNotes = Friendly
#. EDID: [01059D57]
#. REC: INFO:NAM1
msgctxt "0016AD"
msgid "It'll be quick, I promise."
msgstr "금방 끝날 거야, 약속해."

#. List: 2
#. QuestName = SFFL_MS03
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale / NPCFGenericFemale
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Angry
#. SoundFileID = 00514F7A
#. ScriptNotes = Angry
#. EDID: [0105BFAB]
#. REC: INFO:NAM1
msgctxt "0016AE"
msgid "Just die already!"
msgstr "그냥 좀 죽어!"

#. List: 2
#. QuestName = SFFL_MS03
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale / NPCFGenericFemale
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Angry
#. SoundFileID = 00EC29EA
#. ScriptNotes = Angry
#. EDID: [0105BFAA]
#. REC: INFO:NAM1
msgctxt "0016AF"
msgid "You're dead!"
msgstr "죽어라!"

#. List: 2
#. QuestName = SFFL_MS03
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale / NPCFGenericFemale
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Angry
#. SoundFileID = 00AF9741
#. ScriptNotes = Angry
#. EDID: [0105BFA7]
#. REC: INFO:NAM1
msgctxt "0016B0"
msgid "Get him!"
msgstr "저 녀석 잡아!"

#. List: 2
#. QuestName = SFFL_MS03
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale / NPCFGenericFemale
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
