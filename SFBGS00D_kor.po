#. EDID: SFFL_AnchorpointSharedInfoQuest_MaddeB2
#. REC: INFO:NAM1
msgctxt "001B78"
msgid "*Laugh* Not a fan, huh?"
msgstr "*웃음* 마음에 안 들어?"

#. List: 2
#. QuestName = SFFL_Anchorpoint_RandConv09_MaddieTiger01
#. SceneName = SFFL_Anchorpoint_RandConv09_MaddieTigerScene
#. DialogCallType = NPCResponse
#. Speaker = Actor02
#. VoiceType = SFFL_NPCFMaddieWing
#. Face = Neutral
