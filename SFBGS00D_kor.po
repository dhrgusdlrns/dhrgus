#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_150_Caruso_Greet
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Irritated
