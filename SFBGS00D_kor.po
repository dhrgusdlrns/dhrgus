#. Face = Neutral
#. SoundFileID = 008720E3
#. ScriptNotes = / to Yura
#. DialogueAfter = Yura: House sitting? Really? There's a difference between easy and boring and I don't do boring.
#. EDID: [01059CFB]
#. REC: INFO:NAM1
msgctxt "002131"
msgid "If this job is so easy, why can't you do it? "
msgstr "그렇게 쉬운 일이면 왜 직접 못 해? "

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_0200_Yura_TL_AtkaScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Yura
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00557DF1
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Can you tell me more about your sister? &&& Yura: Atka? I like to think of her as the anti-me: responsible, keeps to herself, excelling at everything she does...|Obviously the favorite when it came to mom and dad.
#. DialogueAfter = Player Default: I don't know. Some science convention or something.
#. EDID: [01059CCA]
#. REC: INFO:NAM1
msgctxt "002132"
msgid "Where is Atka?"
msgstr "아트카는 어디 있어?"

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_0100_Yura_IntroMainScene
