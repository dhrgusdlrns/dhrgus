#. DialogueBefore = Player Default: Good luck out there, <Alias=Gloria>.
#. EDID: [0104DABC]
#. REC: INFO:NAM1
msgctxt "000B97"
msgid "Thank you. Good luck to you too!"
msgstr "고마워. 행운을 빌어줄게!"

#. List: 2
#. QuestName = SFFL_SE_EC01
#. SceneName = SFFL_SE_EC01_550_GloriaGoodbye
