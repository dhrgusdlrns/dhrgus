#. Face = Neutral
#. SoundFileID = 00CAD989
#. DialogueBefore = Player Default: I'd like to purchase supplies.
#. EDID: [01027E29]
#. REC: INFO:NAM1
msgctxt "00080A"
msgid "You got the creds, then we can do business."
msgstr "크레딧만 충분하다면, 언제든 거래해 드리지."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. SceneName = SFFL_MS01_HelpWanted_050_Ivica_TL00_Vendor
#. DialogCallType = NPCResponse
