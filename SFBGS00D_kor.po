#. EDID: [0106AD57]
#. REC: INFO:NAM1
msgctxt "001A82"
msgid "Mayday! Mayday! Please help us."
msgstr "메이데이! 메이데이! 제발 도와주세요."

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_Pirate01_Scene
#. DialogCallType = NPCResponse
#. Speaker = PirateShip02
#. VoiceType = SFFL_NPCFGenericFemale02
#. Face = Spaceship / SinisterSmile
#. SoundFileID = 00439028
#. ScriptNotes = Aggressive pirates grav jumping into the area to attach the player's ship in an ambush. / SinisterSmile
#. DialogueBefore = PirateShip01:
#. EDID: [0106B169]
#. REC: INFO:NAM1
msgctxt "001A83"
msgid "Looks like we've got ourselves a live one, girls!"
msgstr "살아 있는 놈 하나 건진 것 같네, 얘들아!"

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_250_CompanionInterjection
