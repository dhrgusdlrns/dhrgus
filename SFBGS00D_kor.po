#. DialogueBefore = Yura: And look, just in time.
#. DialogueAfter = Atka: As a Freestar Ranger, I personally looked after Milli's safety.
#. EDID: [0106C859]
#. REC: INFO:NAM1
msgctxt "001288"
msgid "Hello, back me up here."
msgstr "야, 여기서 내 편 좀 들어줘."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_0140_Yura_IntroPostRejectionScene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Friendly
#. SoundFileID = 00378E3D
#. ScriptNotes = Friendly / to Player Default
#. DialogueAfter = Player Default: Looks like I could use those credits after all.
#. EDID: [01035893]
#. REC: INFO:NAM1
msgctxt "001289"
msgid "Oh hey, finally interested in that house sitting gig? It's not too late you know."
msgstr "아, 드디어 임시 집사 일에 관심이 생긴 거야? 아직 늦지 않았어."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_MainRansomScene
