msgid "You must've had a place with a lot of sunlight."
msgstr "햇빛 잘 드는 곳에 살았나 보네."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. SceneName = CREW_EliteCrew_Muria_TopLevel_Jobs
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Muria
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00541D25
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: That doesn't sound neat to me. &&& Muria: That's because you can't die and you're jealous. It's a defense mechanism.
#. DialogueAfter = Player Default: They had me doing laundry and cleaning up blood and other viscera. They gave us a machine to suck up blobs of fat.
#. EDID: [01083CA5]
#. REC: INFO:NAM1
msgctxt "00012F"
msgid "What were your responsibilities?"
msgstr "영안실에서 무슨 일을 했어?"

