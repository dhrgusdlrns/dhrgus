#. VoiceType = SFFL_NPCSehoyBaker
#. Face = Spaceship / Neutral
#. SoundFileID = 00FE380A
#. ScriptNotes = Worried. [Spaceship]
#. EDID: [01056614]
#. REC: INFO:NAM1
msgctxt "000CB1"
msgid "Please tell me you can hear me..."
msgstr "제발 내 말이 들린다고 말해줘..."

#. List: 2
#. QuestName = SFFL_Z01
#. DialogCallType = NPCResponse
