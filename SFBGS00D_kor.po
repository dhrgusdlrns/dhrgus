#. ScriptNotes = / to Player Default
#. DialogueBefore = Grandma: Hello.|I am glad you stopped by. I was beginning to think that you were... afraid.
#. DialogueAfter = Player Default: Afraid of your kind? Never.
#. EDID: [0102FCCB]
#. REC: INFO:NAM1
msgctxt "0017BE"
msgid "My kind? What do you mean by that?"
msgstr "저 같은 부류요? 그게 무슨 뜻이죠?"

#. List: 2
#. QuestName = SFFL_SE01
#. SceneName = SFFL_SE01_250_GrandmaTalk
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Grandma
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Spaceship / Neutral
#. SoundFileID = 00B508D4
#. ScriptNotes = / to Player Default
#. DialogueBefore = Grandma: Hello.|I am glad you stopped by. I was beginning to think that you were... afraid.
#. DialogueAfter = Player Default: Afraid of your kind? Never.
#. EDID: [0102FCCA]
#. REC: INFO:NAM1
msgctxt "0017BF"
msgid "I'm not afraid of you. Are you afraid of me?"
msgstr "전 당신이 두렵지 않아요. 당신은 제가 두렵나요?"

#. List: 2
#. QuestName = SFFL_SE01
#. SceneName = SFFL_SE01_250_GrandmaTalk
#. DialogCallType = NPCResponse
#. Speaker = NPCFGrandma
