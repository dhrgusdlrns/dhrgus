#. DialogueAfter = Player Default: Nice.
#. EDID: [01043F9C]
#. REC: INFO:NAM1
msgctxt "001801"
msgid "I'll do it. "
msgstr "하겠어."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_HailAccepted_SubsequentPlaythrough
