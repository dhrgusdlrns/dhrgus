#. EDID: [01021625]
#. REC: INFO:NAM1
msgctxt "000467"
msgid "[Lie] I can do that. Just tell me how."
msgstr "[거짓말] 할 수 있어. 방법만 알려줘."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_b1000_IvicaGreet
