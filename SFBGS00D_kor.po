#. Face = Neutral
#. SoundFileID = 0017D5E7
#. EDID: [010275C3]
#. REC: INFO:NAM1
msgctxt "0006F1"
msgid "In my mind, communication's the only way to turn a wound into wisdom."
msgstr "내 생각에, 소통만이 상처를 지혜로 바꾸는 방법이야."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2940_ZenaVoteTL02
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
