#. VoiceType = SFFL_MS01_NPCFSashaAtwell
#. Face = Neutral
#. SoundFileID = 002708A7
#. EDID: [01023D34]
#. REC: INFO:NAM1
msgctxt "000234"
msgid "Try to stay on my good side while you're here."
msgstr "여기 있을 때는 제 심기를 건드리지 않는 게 좋을 겁니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
