#. List: 2
#. QuestName = SFFL_R02
#. DialogCallType = NPCResponse
#. Speaker = NPCMTheArbitrator
#. VoiceType = SFFL_R02_NPCMTheArbitrator
#. Face = Serious
#. SoundFileID = 00A2ABC0
#. ScriptNotes = Serious
#. EDID: [01045EC8]
#. REC: INFO:NAM1
msgctxt "001D98"
