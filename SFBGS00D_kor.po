#. VoiceType = SFFL_NPCMRishiSaint
#. Face = Confident
#. SoundFileID = 0062CEC8
#. ScriptNotes = The player has suddenly stopped talking mid-conversation. Are they okay?
#. EDID: [0104EDD6]
#. REC: INFO:NAM1
msgctxt "001DD9"
msgid "Is something the matter?"
msgstr "무슨 일 있습니까?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCFDanicaVolkov
#. VoiceType = SFFL_NPCFDanicaVolkov
#. Face = Friendly
#. SoundFileID = 00519F20
#. ScriptNotes = The player has suddenly stopped talking mid-conversation. Are they okay?
#. EDID: [0104EDC5]
#. REC: INFO:NAM1
msgctxt "001DDA"
msgid "You know, I had this ship once... Oh, sorry. I have a bad habit of trying to fill long silences."
msgstr "있잖아, 나도 예전에 이런 우주선이 있었는데... 아, 미안. 침묵이 길어지면 뭐라도 말해서 채우려는 나쁜 버릇이 있거든."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00ADC91B
#. ScriptNotes = The player has suddenly stopped talking mid-conversation. Are they okay?
#. EDID: [0104EDC2]
#. REC: INFO:NAM1
msgctxt "001DDB"
msgid "It's alright. There's no hurry."
msgstr "괜찮아. 서두를 필요 없어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00EFEE98
#. ScriptNotes = The player has suddenly stopped talking mid-conversation. Are they okay?
#. EDID: [0104EDC1]
#. REC: INFO:NAM1
msgctxt "001DDC"
msgid "Feeling lost? I can relate."
msgstr "길을 잃은 기분이야? 나도 알아."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCFValeriaHahn
#. VoiceType = SFFL_NPCFValeriaHahn
#. Face = Friendly
#. SoundFileID = 006976E4
#. ScriptNotes = Friendly. Saying goodbye to the player, who has just departed mid- conversation.
#. EDID: [0104EDFF]
#. REC: INFO:NAM1
msgctxt "001DDD"
msgid "Take care!"
msgstr "몸조심해!"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
