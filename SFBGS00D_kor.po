#. SoundFileID = 00D31D72
#. DialogueBefore = HailingShip:
#. DialogueAfter = HailingShip: Damn it, really? What happened?
#. EDID: [01043FA0]
#. REC: INFO:NAM1
msgctxt "0017F4"
msgid "If I have more opportunities for you in the future, I'll find you. Stay safe out there."
msgstr "앞으로 당신에게 줄 기회가 더 생기면 제가 찾아가겠습니다. 밖에서는 조심하세요."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_TurnIn
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 0069C8EF
