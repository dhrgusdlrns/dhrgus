msgstr "그 선적물을 가져올게."

#. List: 2
#. EDID: [01065741]
#. REC: INFO:NAM1
msgctxt "000DB4"
msgid "Yes"
msgstr "예"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
