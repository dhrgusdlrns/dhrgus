#. DialogueAfter = Bernhard: Why? Why volunteer for such misery?
#. EDID: [01021630]
#. REC: INFO:NAM1
msgctxt "00022D"
msgid "I'm going to enlist in the Vanguard."
msgstr "전 뱅가드에 입대할 거예요."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. SceneName = SFFL_MS01_HelpWanted_000_StartScene01
#. DialogCallType = NPCResponse
#. Speaker = Bernhard
#. VoiceType = SFFL_MS01_NPCMBernhardKleiber
#. Face = Disgust
#. SoundFileID = 0048BD42
#. ScriptNotes = Disgust / to BarPatron
#. DialogueBefore = Bernhard: Why? Why volunteer for such misery? &&& BarPatron: Because it's the right thing to do.
#. DialogueAfter = Bernhard: A pointless death.
#. EDID: [0102177E]
#. REC: INFO:NAM1
msgctxt "00022E"
msgid "Please. You know what your righteousness gets you?"
msgstr "제발 그만둬. 그놈의 정의감 때문에 결국 어떻게 되는지 몰라서 그래?"

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. SceneName = SFFL_MS01_HelpWanted_000_StartScene01
#. DialogCallType = NPCResponse
#. Speaker = BarPatron
#. VoiceType = SFFL_NPCFGenericFemale04
#. Face = Angry
#. SoundFileID = 00C57B39
#. ScriptNotes = Angry / to Bernhard
#. DialogueBefore = BarPatron: I'm going to enlist in the Vanguard. &&& Bernhard: Why? Why volunteer for such misery?
#. DialogueAfter = Bernhard: Please. You know what your righteousness gets you?
#. EDID: [0102162A]
#. REC: INFO:NAM1
msgctxt "00022F"
msgid "Because it's the right thing to do."
msgstr "왜냐면 그게 옳은 일이니까요."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. SceneName = SFFL_MS01_HelpWanted_000_StartScene01
#. DialogCallType = NPCResponse
#. Speaker = Bernhard
#. VoiceType = SFFL_MS01_NPCMBernhardKleiber
#. Face = Disgust
#. SoundFileID = 009C4C05
#. ScriptNotes = Disgust / to BarPatron
#. DialogueBefore = Bernhard: Please. You know what your righteousness gets you?
#. DialogueAfter = BarPatron: I'm sorry you feel that way. But I'm going.
#. EDID: [0102178C]
#. REC: INFO:NAM1
msgctxt "000230"
msgid "A pointless death."
msgstr "무의미한 개죽음뿐이라고."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
