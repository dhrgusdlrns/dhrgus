#. EDID: [01035A79]
#. REC: INFO:NAM1
msgctxt "001CC0"
msgid "I don't want to risk anything really..."
msgstr "사실 아무 위험도 감수하고 싶지 않아..."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_MainRansomScene
