#. DialogueAfter = Player Default: Uh, okay, we'll be right here!
#. EDID: [010643A1]
#. REC: INFO:NAM1
msgctxt "001550"
msgid "Let me think about it."
msgstr "생각 좀 해 볼게요."

#. List: 2
#. QuestName = SFFL_SE_EC07
#. SceneName = SFFL_SE_EC07_120_PostHail
