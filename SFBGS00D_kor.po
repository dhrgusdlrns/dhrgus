#. DialogueBefore = Player Default: I'd like to purchase supplies.
#. EDID: [01027E28]
#. REC: INFO:NAM1
msgctxt "00080B"
msgid "Fine. Here's what I got."
msgstr "좋아. 물건 한 번 보라고."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. SceneName = SFFL_MS01_HelpWanted_050_Ivica_TL00_Vendor
