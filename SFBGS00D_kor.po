msgid "Open this door or you're all dead."
msgstr "문 열어. 안 그러면 다 죽을 줄 알아."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_0200_Yura_TL_HouseSittingScene
