#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Angry
#. SoundFileID = 00B9E504
#. ScriptNotes = Angry
#. EDID: [01083D27]
#. REC: INFO:NAM1
