msgstr "유감이지만 오늘 진료비는 직접 부담해야겠어. 크레딧이 생기면 다시 와."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Surprised
#. SoundFileID = 0067125A
#. ScriptNotes = Surprised
#. EDID: [01083CFC]
#. REC: INFO:NAM1
msgctxt "01601D"
msgid "Lost 'em."
msgstr "놓쳤어."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Angry
#. SoundFileID = 00F6FFC7
#. ScriptNotes = Angry
#. EDID: [01083CB8]
#. REC: INFO:NAM1
msgctxt "01601E"
msgid "You're done."
msgstr "넌 끝났어."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00244AF5
#. EDID: [01083C8B]
#. REC: INFO:NAM1
msgctxt "01601F"
