#. DialogueBefore = Player Default: Yes, no, and no.
#. DialogueAfter = Roman: All right, plan B I guess. You want Milli? Do me a favor, and she's all yours.
#. EDID: [01035D59]
#. REC: INFO:NAM1
msgctxt "001297"
msgid "You've got to be kidding me. "
msgstr "장난하는 거냐. "

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_MainBranchYura01Scene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Concerned
#. SoundFileID = 0034A9C8
#. ScriptNotes = Concerned / to Player Default
#. Prompt = Tell me the favor first.
#. DialogueAfter = Roman: She hates house sitting. It's boring. So we thought why not liven things up?
#. EDID: [01035D87]
#. REC: INFO:NAM1
msgctxt "001298"
msgid "You see, all this? It's just a setup. For her."
msgstr "보다시피, 이 모든 건 준비한 거야. 걔를 위해서."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_MainBranchYura01Scene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Confident
