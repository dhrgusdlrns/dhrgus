msgid "Here. Compliments of Mister Saint."
msgstr "여기. 세인트 씨가 전하라 한 거야."

#. List: 2
#. QuestName = SFFL_AnchorpointZ01
#. SceneName = SFFL_AnchorpointZ01_StartScene
#. DialogCallType = NPCResponse
#. Speaker = ChanHuang
#. VoiceType = SFFL_NPCMChanHuang
#. Face = Confident
#. SoundFileID = 0077DD12
#. ScriptNotes = / to Player Default
#. EDID: [010343A0]
#. REC: INFO:NAM1
msgctxt "001D6A"
msgid "Good luck out there."
msgstr "행운을 빌어."

#. List: 2
#. QuestName = SFFL_AnchorpointZ01
#. SceneName = SFFL_AnchorpointZ01_StartScene
#. DialogCallType = NPCResponse
#. Speaker = ChanHuang
#. VoiceType = SFFL_NPCMChanHuang
#. Face = Confident
#. SoundFileID = 00FBC891
#. ScriptNotes = / to Player Default
#. EDID: [010343A0]
#. REC: INFO:NAM1
msgctxt "001D6B"
msgid "Take out the leader, and they'll get the message."
msgstr "두목만 처리하면, 밑에 있는 놈들은 아마 말을 알아들을 거야."

#. List: 2
#. QuestName = SFFL_AnchorpointZ01
#. SceneName = SFFL_AnchorpointZ01_StartScene
#. DialogCallType = NPCResponse
#. Speaker = ChanHuang
#. VoiceType = SFFL_NPCMChanHuang
#. Face = Confident
#. SoundFileID = 0079879C
#. ScriptNotes = / to Player Default
#. DialogueBefore = ChanHuang: Believe me, I don't want to see that happen.|I wish I could spare someone to help you, but I just can't risk it.
#. EDID: [010343A0]
#. REC: INFO:NAM1
msgctxt "001D6C"
msgid "Now listen, there's no need for excessive bloodshed here."
msgstr "자, 잘 들어. 처리할 때 필요 이상으로 피를 볼 필요는 없어."

#. List: 2
#. QuestName = SFFL_AnchorpointZ01
#. SceneName = SFFL_AnchorpointZ01_Conclusion
