#. VoiceType = SFFL_NPCMChanHuang
#. Face = Impressed
#. SoundFileID = 00618D5C
#. ScriptNotes = Impressed / Impressed / to Actor01
#. DialogueAfter = Actor01: Really?
#. EDID: [01059DC1]
#. REC: INFO:NAM1
msgctxt "001B73"
msgid "Probably saved us all."
msgstr "아마 우리 모두를 구했을 거야."

#. List: 2
#. QuestName = SFFL_Anchorpoint_RandConv10_ChanValeria_Z01
#. SceneName = SFFL_Anchorpint_RandConv10_ChanValeria_Z01_Scene
