#. DialogueAfter = Player Default: In my opinion, Yeats is the supply thief.
#. EDID: [0102170E]
#. REC: INFO:NAM1
msgctxt "0002D5"
msgid "What do you think? Did he do it?"
msgstr "어떻게 생각해? 그가 한 짓일까?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2320_Caspian_Scene
#. DialogCallType = NPCResponse
