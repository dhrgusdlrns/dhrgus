#. REC: INFO:NAM1
msgctxt "002213"
msgid "Nothing I haven't done before. Give me the details. "
msgstr "전에 해본 일이네. 세부 사항이나 말해줘. "

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_Intro
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = TheArbitrator
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 008A8E39
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: No need to explain yourself. We've been through this before, you and I. &&& TheArbitrator: If that's the case, I guess I'll skip the preamble. &&& TheArbitrator: I'm not gonna beat around the bush. I'm looking for someone that is willing to kill people - people that may or may not deserve it - for money. No questions asked.|Are you that special someone?
#. DialogueAfter = Player Default: Good.
#. EDID: [010590CD]
#. REC: INFO:NAM1
msgctxt "002214"
msgid "I'll do it. Hell, sounds like fun."
msgstr "하지. 젠장, 재미있겠는데."

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralCaptiveNPC_Scene
#. DialogCallType = NPCResponse
#. Speaker = CaptiveNPC
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Angry
#. SoundFileID = 00DC7BF6
#. ScriptNotes = scared, paranoid, nervous as well as angry / Angry / to Player Default
#. DialogueBefore = CaptiveNPC:
#. EDID: [01059116]
#. REC: INFO:NAM1
msgctxt "002215"
msgid "Wait, where are you going? You... you're just gonna kill me, aren't you? No, I can't die in here!"
msgstr "잠깐, 어디 가? 너... 날 죽일 거지? 안 돼, 여기서 죽을 순 없어!"

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralCaptiveNPC_Scene
#. DialogCallType = NPCResponse
#. Speaker = CaptiveNPC
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Angry
#. SoundFileID = 00A38D8B
#. ScriptNotes = angry but also scared, paranoid / Angry / to Player Default
#. DialogueBefore = CaptiveNPC:
#. EDID: [01059114]
#. REC: INFO:NAM1
msgctxt "002216"
msgid "Where are you going? What... what the hell is going on? I'm not going to die in here!"
msgstr "어디 가는 거야? 뭐... 대체 무슨 일이야? 난 여기서 죽지 않을 거야!"

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_Intro
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00F64892
#. ScriptNotes = / to Player Default
#. DialogueBefore = TheArbitrator: If you're looking for work, I need someone to do a job for me. Preferably someone that isn't burdened by morality.
#. DialogueAfter = Player Default: If that's the case, I guess I'll skip the preamble.
#. EDID: [01059AB8]
#. REC: INFO:NAM1
msgctxt "002217"
msgid "No need to explain yourself. We've been through this before, you and I."
msgstr "설명할 필요 없어. 너와 난 전에도 이런 일을 겪었잖아."

#. List: 2
#. QuestName = SFFL_R01
#. DialogCallType = NPCResponse
#. Speaker = Smuggler
#. VoiceType = SFFL_R01_Smuggler
#. Face = Neutral
#. SoundFileID = 0015C098
#. ScriptNotes = Not threatening or angry. Said like someone that knows they're sending someone on a dangerous job
#. EDID: [0104F8F3]
#. REC: INFO:NAM1
msgctxt "002218"
msgid "Watch your back."
msgstr "뒤를 조심해."

#. List: 2
#. QuestName = SFFL_R01
#. DialogCallType = NPCResponse
#. Speaker = Smuggler
#. VoiceType = SFFL_R01_Smuggler
#. Face = Confused
#. SoundFileID = 00B30354
#. ScriptNotes = Confused
#. EDID: [0104F8F8]
#. REC: INFO:NAM1
msgctxt "002219"
msgid "Everything all right?"
msgstr "별일 없나?"

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_HailAccepted
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 00DB34A8
#. ScriptNotes = / to Player Default
#. DialogueAfter = HailingShip: If you're set up for it, and wanna go the extra mile, you can deliver the goods to the Trade Authority yourself. Hell, makes my job a whole lot easier, and you'll get more credits for the trouble.
#. EDID: [01029721]
#. REC: INFO:NAM1
msgctxt "00221A"
msgid "Thing is, I know my limits. I'm a smuggler, not a fighter. I don't like to get my hands dirty like that. So, here's the deal - I'll pay you to get the contraband and bring it back to me."
msgstr "문제는 내가 내 한계를 안다는 거야. 난 밀수업자지 전투원이 아니야. 그런 식으로 손 더럽히는 건 싫어. 그러니까 이렇게 하자. 네가 밀수품을 가져와서 내게 돌려주면 보수를 주겠어."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_HailAccepted
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 008E8008
#. ScriptNotes = / to Player Default
#. DialogueBefore = HailingShip: Perfect.
#. EDID: [01029721]
#. REC: INFO:NAM1
msgctxt "00221B"
msgid "Trade Authority is paying a pretty penny to anyone who can get the contraband from some potentially dangerous areas. "
msgstr "무역 연맹이 위험할 수도 있는 지역에서 밀수품을 가져오는 사람에게 꽤 후한 보수를 주고 있어."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_HAIL
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 00239EAE
#. EDID: [01029717]
#. REC: INFO:NAM1
msgctxt "00221C"
msgid "You there. If your pockets are feeling light, I've got an opportunity for you. "
msgstr "거기 너. 주머니가 가볍다면, 너한테 줄 기회가 있어."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_HailRefused
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 003B6B2D
#. DialogueBefore = HailingShip: You there. If your pockets are feeling light, I've got an opportunity for you.
#. EDID: [01029724]
#. REC: INFO:NAM1
msgctxt "00221D"
msgid "Suit yourself."
msgstr "마음대로 해."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_TurnIn
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 00442008
#. DialogueAfter = HailingShip: Damn it, really? What happened?
#. EDID: [01043F9F]
#. REC: INFO:NAM1
msgctxt "00221E"
msgid "Good luck out there."
msgstr "행운을 빌어."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_TurnIn
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 0011A5E4
#. EDID: [01043F9F]
#. REC: INFO:NAM1
msgctxt "00221F"
msgid "Oh, before I forget. I have some intel pointing to some valuables in another location. I'll mark it on your map as a little bonus."
msgstr "아, 잊기 전에. 다른 위치에 귀중품이 있다는 정보가 있어. 작은 보너스로 지도에 표시해 줄게."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_TurnIn
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 002A7087
#. DialogueBefore = HailingShip:
#. EDID: [01043F9F]
#. REC: INFO:NAM1
msgctxt "002220"
msgid "If I have more opportunities for you in the future, I'll find you."
msgstr "앞으로 네게 줄 기회가 더 생기면 내가 찾아가지."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_TurnIn
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 00A405B3
#. DialogueBefore = HailingShip: Well done, well done.|Pleasure working with you. Keep an eye out - I may have more opportunities for you, later.
#. DialogueAfter = HailingShip: If I have more opportunities for you in the future, I'll find you.
#. EDID: [01043FAE]
#. REC: INFO:NAM1
msgctxt "002221"
msgid "Nice work!"
msgstr "잘했어!"

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_HailAccepted
#. DialogCallType = NPCResponse
#. Speaker = Smuggler
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 0061AC8D
#. ScriptNotes = / to Player Default
#. Prompt = I bend the law all the time.
#. DialogueBefore = Player Default: I bend the law all the time.
#. DialogueAfter = HailingShip: Trade Authority is paying a pretty penny to anyone who can get the contraband from some potentially dangerous areas.
#. EDID: [01043F97]
#. REC: INFO:NAM1
msgctxt "002222"
msgid "Perfect."
msgstr "완벽해."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_TL03
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 00892615
#. ScriptNotes = Neutral / to Player Default
#. Prompt = I feel like this is a sensitive subject. It may be good for you to talk about it.
#. DialogueBefore = Player Default: I feel like this is a sensitive subject. It may be good for you to talk about it.
#. DialogueAfter = HailingShip: I was on a typical job with my pilot at the time. We worked together for, maybe, fifteen years or so? I trusted this guy with my life.
#. EDID: [01051BA3]
#. REC: INFO:NAM1
msgctxt "002223"
msgid "I... *sigh* All right. If you're gonna twist my arm so much."
msgstr "나... *한숨* 좋아. 네가 그렇게까지 압박한다면."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_TL03
#. DialogCallType = NPCResponse
#. Speaker = Smuggler
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Irritated
#. SoundFileID = 0077AB8F
#. ScriptNotes = Irritated / to Player Default
#. Prompt = I could be killed getting this contraband for you. Just answer my questions.
#. DialogueBefore = Player Default: I could be killed getting this contraband for you. Just answer my questions.
#. DialogueAfter = HailingShip: I was on a typical job with my pilot at the time. We worked together for, maybe, fifteen years or so? I trusted this guy with my life.
#. EDID: [01051BA2]
#. REC: INFO:NAM1
msgctxt "002224"
msgid "Wow, you really know how to guilt trip someone. Fine, if it means so much to you."
msgstr "와, 죄책감 들게 하는 솜씨가 대단하네. 좋아, 네게 그렇게 중요하다면."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_TL03
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 002D5E8A
#. ScriptNotes = mildly irritated. doesn't want to talk about this and shutting the convo down / Neutral / to Player Default
#. Prompt = I'd still like to hear it.
#. DialogueBefore = Player Default: I'd still like to hear it.
#. DialogueAfter = HailingShip: I was on a typical job with my pilot at the time. We worked together for, maybe, fifteen years or so? I trusted this guy with my life.
#. EDID: [01051BA0]
#. REC: INFO:NAM1
msgctxt "002225"
msgid "No. Let's just drop it."
msgstr "아니. 그냥 그만두자."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_TL03
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 00677095
#. ScriptNotes = trying to brush off a senstive subject / Neutral
#. DialogueBefore = Player Default: You said you were injured on a job before?
#. DialogueAfter = Player Default: I could be killed getting this contraband for you. Just answer my questions.
#. EDID: [01051B9B]
#. REC: INFO:NAM1
msgctxt "002226"
msgid "Yeah. It's not really a good story."
msgstr "그래. 그리 좋은 이야기는 아니야."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_TL02
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 0060F628
#. ScriptNotes = Neutral
#. EDID: [01051BA7]
#. REC: INFO:NAM1
msgctxt "002227"
msgid "I got badly injured on a job before, and that pretty much put an end to any of my gunslinging days. Not that I had very many."
msgstr "예전에 일하다 크게 다쳤고, 그걸로 총잡이 노릇은 사실상 끝났어. 뭐, 오래 한 것도 아니지만."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_TL02
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_R01_Smuggler
#. Face = Spaceship / Neutral
#. SoundFileID = 00FC8429
#. ScriptNotes = Neutral
#. DialogueBefore = Player Default: Why can't you get this contraband yourself?
#. EDID: [01051BA7]
#. REC: INFO:NAM1
msgctxt "002228"
msgid "I said it before, I'm a smuggler, not a fighter. If what the Trade Authority says is true, this contraband is in some pretty hostile locations. "
msgstr "전에도 말했지만, 난 밀수업자지 전투원이 아니야. 무역 연맹 말이 사실이라면, 이 밀수품은 꽤 험악한 곳에 있어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCFDanicaVolkov
#. VoiceType = SFFL_NPCFDanicaVolkov
#. Face = Friendly
#. SoundFileID = 0013FC51
#. ScriptNotes = A friendly greeting. Put a light chuckle between the sentences for the latter joke.
#. EDID: [0104C3EA]
#. REC: INFO:NAM1
msgctxt "002229"
msgid "I've flown pretty much everything that flies. Even a few that crashed."
msgstr "날 수 있는 건 거의 다 몰아 봤어. 추락한 적도 몇 번 있고."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCFDanicaVolkov
#. VoiceType = SFFL_NPCFDanicaVolkov
#. Face = Friendly
#. SoundFileID = 00AD9502
#. ScriptNotes = A friendly greeting
#. EDID: [0104C3E9]
#. REC: INFO:NAM1
msgctxt "00222A"
msgid "I don't know much, but I do know ships."
msgstr "아는 건 많지 않지만 우주선만큼은 알아."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCFMaddieWing
#. VoiceType = SFFL_NPCFMaddieWing
#. Face = Neutral
#. SoundFileID = 00CBCB32
#. ScriptNotes = Exasperated, shaking your head
#. EDID: [01026724]
#. REC: INFO:NAM1
msgctxt "00222B"
msgid "I fix one thing, and two other things break."
msgstr "한 군데 고치면 다른 두 군데가 고장 나."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMKillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 008202E4
#. ScriptNotes = Cool, measured
#. EDID: [0102671F]
#. REC: INFO:NAM1
msgctxt "00222C"
msgid "Opportunity can be found even in a place like this. Or perhaps especially in a place like this."
msgstr "기회는 이런 곳에서도 찾을 수 있어. 어쩌면 이런 곳일수록 더 찾을 수 있겠지."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMKillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 002F5A65
#. ScriptNotes = Amused
#. EDID: [0102671E]
#. REC: INFO:NAM1
msgctxt "00222D"
msgid "What do you need?"
msgstr "뭐가 필요하지?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCFDarcyWeber
#. VoiceType = SFFL_NPCFDarcyWeber
#. Face = Nervous
#. SoundFileID = 007531D6
#. ScriptNotes = Scatter-brained but friendly
#. EDID: [01026719]
#. REC: INFO:NAM1
msgctxt "00222E"
msgid "Hm? Yes?"
msgstr "음? 그래?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCFDarcyWeber
#. VoiceType = SFFL_NPCFDarcyWeber
#. Face = Nervous
#. SoundFileID = 00800F21
#. ScriptNotes = A friendly vendor
#. EDID: [01026718]
#. REC: INFO:NAM1
msgctxt "00222F"
msgid "Looking for something in particular?"
msgstr "특별히 찾는 게 있나?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale / NPCFGenericFemale
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Neutral
#. SoundFileID = 00DA2FA7
#. ScriptNotes = Dismissive
#. EDID: [0104EDB3]
#. REC: INFO:NAM1
msgctxt "002230"
msgid "I've been in worse dives, but not many."
msgstr "이보다 더한 구질구질한 곳도 가 봤지만, 많지는 않았어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale / NPCFGenericFemale
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Neutral
#. SoundFileID = 00D49A67
#. ScriptNotes = Dismissive
#. EDID: [01026708]
#. REC: INFO:NAM1
msgctxt "002231"
msgid "Ain't looking for company right now."
msgstr "지금은 떠들 상대 찾는 게 아닌데."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCFGenericFemale / NPCMGenericMale
#. VoiceType = SFFL_NPCFGenericFemale03 / SFFL_NPCFGenericFemale04 / SFFL_NPCMGenericMale03
#. Face = Neutral
#. SoundFileID = 00C320BE
#. ScriptNotes = Firm, a guard
#. EDID: [01026702]
#. REC: INFO:NAM1
msgctxt "002232"
msgid "Grab a drink and relax."
msgstr "한잔하면서 쉬시죠."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
