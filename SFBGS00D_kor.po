msgid "Error 0 0 3 7: Distress message index was out of bounds."
msgstr "오류 0 0 3 7: 조난 메시지 인덱스가 범위를 벗어났습니다."

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_150_CompanionInterjection
