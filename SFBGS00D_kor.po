msgid "You're leaving? You're just gonna come back and kill me when I least suspect it. I'm... I'm not gonna let that happen!"
msgstr "떠난다고? 내가 방심할 때 돌아와서 날 죽이려는 거잖아. 난... 그렇게 두지 않을 거야!"

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralNPC_Scene
#. DialogCallType = NPCResponse
#. Speaker = GenNPC
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Angry
