#. EDID: SFFL_MS03_Roman_PostIntro01
#. REC: INFO:NAM1
msgctxt "0012E4"
msgid "Did you talk to Yura? What'd she say? "
msgstr "유라랑 얘기했어? 뭐래?"

#. List: 2
#. QuestName = SFFL_MS03_Support
