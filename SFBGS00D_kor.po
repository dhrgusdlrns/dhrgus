msgctxt "0017BC"
msgid "How do you feel in your body? Do you feel alive?"
msgstr "네 몸은 어떤 느낌이니? 살아 있다고 느껴지니?"

#. List: 2
#. QuestName = SFFL_SE01
#. SceneName = SFFL_SE01_250_GrandmaTalk
