#. Speaker = NPCFAtka
#. VoiceType = SFFL_NPCFAtka
#. Face = Serious
#. SoundFileID = 00EAA686
#. ScriptNotes = Serious
#. EDID: [0105BFC3]
#. REC: INFO:NAM1
#, fuzzy
msgctxt "001D39"
msgid "I think we need to be alone."
msgstr "우리끼리 있어야 할 것 같아."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
