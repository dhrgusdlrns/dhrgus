#. DialogueBefore = Player Default: Just give me the details and let's get this over with.
#. DialogueAfter = Yura: Here's the key to Atka's house.
#. EDID: [0103585F]
#. REC: INFO:NAM1
msgctxt "001287"
msgid "You got it. "
msgstr "알았어."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_MainEndScene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Irritated
