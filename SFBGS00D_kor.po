#. DialogCallType = NPCResponse
#. Speaker = Caspian
#. VoiceType = SFFL_MS01_NPCMCaspianRoberson
#. Face = Neutral
#. SoundFileID = 009181DA
#. DialogueBefore = Caspian: The hell it doesn't! &&& Zena: My god...
#. DialogueAfter = Zena: It's a confession... written by Hal.
#. EDID: [0102157E]
#. REC: INFO:NAM1
msgctxt "0004C0"
msgid "What is it? What does it say?"
msgstr "뭔데? 뭐라고 쓰여 있어?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_150_Caruso_Greet
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 00123032
#. ScriptNotes = / to Player Default
#. Prompt = I can help with physical repairs, but people aren't my area of expertise.
#. DialogueBefore = Player Default: I can help with physical repairs, but people aren't my area of expertise.
#. DialogueAfter = Caruso: But to the matter at hand. As I mentioned, I have a list of things that I'd like to resolve.
#. EDID: [010216EF]
#. REC: INFO:NAM1
msgctxt "0004C1"
msgid "Likewise. But some things are obvious to see, if not easy to correct."
msgstr "나도 그래. 하지만 바로잡기는 쉽지 않아도, 보기에 뻔한 일들이 있지."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_150_Caruso_Greet
#. DialogCallType = NPCResponse
#. Speaker = NPCMHalCaruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 00C21BAE
#. ScriptNotes = / to Player Default
