#. Alias = Roman
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00B4F8CD
#. ScriptNotes = / to Player Default
#. DialogueBefore = Nice doing business with you. &&& Roman: Who are you?
#. DialogueAfter = Player Default: Negotiate? Sorry, I'm an all or nothing kind of guy.
#. EDID: [010358A2]
#. REC: INFO:NAM1
msgctxt "00128A"
msgid "I'm here to negotiate."
msgstr "협상하러 왔어."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_MainEndScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Atka
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00891C93
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: I don't see how the timing is my fault. &&& ... &&& Yura: And see? Milli's fine! &&& Yura: Right, "pet sitters"? &&& companion: We guarded this creature with our very lives.
#. DialogueAfter = Player Default: Well, she certainly seems fine, so I guess Yura was telling the truth for once.
#. EDID: [01035894]
#. REC: INFO:NAM1
msgctxt "00128B"
msgid "[Lie] It really was just a walk. Milli is fine."
msgstr "[거짓말] 정말 그냥 산책만 했어. 밀리는 괜찮아."

#. List: 2
#. QuestName = SFFL_MS03
