#. EDID: [01023D33]
#. REC: INFO:NAM1
msgctxt "000235"
msgid "Stay safe."
msgstr "몸조심하십쇼."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCFSashaAtwell
#. VoiceType = SFFL_MS01_NPCFSashaAtwell
#. Face = Neutral
#. SoundFileID = 0062E98C
#. EDID: [01023CB3]
#. REC: INFO:NAM1
msgctxt "000236"
msgid "Back to it then."
msgstr "하던 일 마저 끝냅시다."

