#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00E364D4
#. DialogueAfter = Zena: The ballot box is still there. See for yourself.
#. EDID: [010275E7]
#. REC: INFO:NAM1
msgctxt "0006F0"
msgid "What was the ending vote count?"
msgstr "최종 투표수는 어땠어?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2940_ZenaVoteTL02
#. DialogCallType = NPCResponse
#. Speaker = Zena
