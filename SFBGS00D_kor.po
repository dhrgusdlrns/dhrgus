#. VoiceType = SFFL_NPCFDarcyWeber
#. Face = Nervous
#. SoundFileID = 00FC322D
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: I'd like to see what you have in stock.
#. EDID: [01031704]
#. REC: INFO:NAM1
msgctxt "001872"
msgid "Okay."
msgstr "좋아."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_DarcyTL01Vend
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00676499
#. ScriptNotes = / to DarcyWeber
#. DialogueAfter = DarcyWeber: You've got it.
#. EDID: [010316FF]
#. REC: INFO:NAM1
msgctxt "001873"
msgid "I'd like to see what you have in stock."
msgstr "상품 목록을 보고 싶어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL02NeedDoctor
#. DialogCallType = NPCResponse
#. Speaker = Cutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00335D1C
#. ScriptNotes = / to Player Default
#. EDID: [01031FCC]
#. REC: INFO:NAM1
msgctxt "001874"
msgid "So yeah, this place needs a doctor."
msgstr "그래서, 예, 이곳엔 의사가 필요합니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL02NeedDoctor
#. DialogCallType = NPCResponse
#. Speaker = Cutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00DE5BE8
#. ScriptNotes = / to Player Default
#. EDID: [01031FCC]
#. REC: INFO:NAM1
msgctxt "001875"
msgid "Get a few drinks in them, and the violence always follows."
msgstr "그 인간들 위장에 술이 들어가면, 항상 폭력사태가 벌어지죠."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL02NeedDoctor
#. DialogCallType = NPCResponse
#. Speaker = Cutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 002C5E5A
#. ScriptNotes = / to Player Default
#. EDID: [01031FCC]
#. REC: INFO:NAM1
msgctxt "001876"
msgid "Spacers, pirates, outlaws, smugglers... they're all welcome here."
msgstr "스페이서, 해적, 무법자, 밀수업자... 그래도 모두 여기서는 환영받죠."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL02NeedDoctor
#. DialogCallType = NPCResponse
#. Speaker = Cutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 002F0B8A
#. ScriptNotes = / to Player Default
#. EDID: [01031FCC]
#. REC: INFO:NAM1
msgctxt "001877"
msgid "See, we get all kinds in this place."
msgstr "보시다시피 이곳엔 온갖 부류의 인간들이 옵니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL02NeedDoctor
#. DialogCallType = NPCResponse
#. Speaker = Cutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 0004810C
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Does this place really need a doctor?
#. EDID: [01031FCC]
#. REC: INFO:NAM1
msgctxt "001878"
msgid "You're either new around here, or just real lucky."
msgstr "당신은 여기 처음 오셨거나, 아니면 정말 운이 좋은 분이신가 보군요."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianTL02Job
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = KillianBrice
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0007E168
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: How did you get this job? &&& KillianBrice: I previously worked with the station's owner, Rishi Saint.|There was some unfortunate business involving my accounting duties with the Vanguard, and I served some time.|When I got out, Rishi approached me with a job opportunity.|It was the best of a very limited set of options.
#. DialogueAfter = Player Default: Ours is a business relationship.
#. EDID: [01031FCF]
#. REC: INFO:NAM1
msgctxt "001879"
msgid "How much do you trust Saint?"
msgstr "세인트를 얼마나 신뢰하지?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianTL02Job
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 00D9C78A
#. ScriptNotes = / to Player Default
#. Prompt = I'm guessing he got you cheap, given your circumstances.
#. DialogueAfter = companion: Wait a minute. Aren't you the guy behind that big Vanguard embezzling scandal?
#. EDID: [01031FC9]
#. REC: INFO:NAM1
msgctxt "00187A"
msgid "My name and face are known in the United Colonies, and not looked on favorably."
msgstr "내 이름과 얼굴은 식민지 연합에 알려져 있고, 인상이 좋진 않지."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianTL02Job
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 00D37F98
#. ScriptNotes = / to Player Default
#. Prompt = I'm guessing he got you cheap, given your circumstances.
#. EDID: [01031FC9]
#. REC: INFO:NAM1
msgctxt "00187B"
msgid "In truth, the remote location was a large part of the appeal."
msgstr "사실 외딴 곳이라는 게 마음에 쏙 들어서 온 거야."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianTL02Job
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 00127BB0
#. ScriptNotes = / to Player Default
#. Prompt = I'm guessing he got you cheap, given your circumstances.
#. DialogueBefore = Player Default: I'm guessing he got you cheap, given your circumstances.
#. EDID: [01031FC9]
#. REC: INFO:NAM1
msgctxt "00187C"
msgid "I wasn't in a position to negotiate, but I wouldn't say I was treated unfairly."
msgstr "협상할 처지는 아니었지만, 부당한 대우를 받았다고 말하긴 어렵겠는데."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianTL02Job
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0091B079
#. ScriptNotes = / to KillianBrice
#. DialogueAfter = KillianBrice: I previously worked with the station's owner, Rishi Saint.
#. EDID: [01031FCD]
#. REC: INFO:NAM1
msgctxt "00187D"
msgid "How did you get this job?"
msgstr "여기서 어떻게 일하게 됐지?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_MaddieTL04_Quest
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = MaddieWing
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00F34A5B
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: And you need me to acquire some of these prototype robot parts. &&& MaddieWing: Well ain't you smart? &&& MaddieWing: How about I quit wasting both of our time, and just level with you?|I get reports from time to time about shipments of these prototype robot parts.|I give you the info and you go pay a visit to whatever cargo ship is making the delivery.|You bring the parts back to me, and I pay you for them.
#. DialogueAfter = Player Default: Well, it ain't everyone who's got a sense of adventure.
#. EDID: [0103716D]
#. REC: INFO:NAM1
msgctxt "00187E"
msgid "Sorry, but no. I'm not a pirate."
msgstr "미안하지만, 안 할래. 난 해적이 아니야."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_MaddieTL04_Quest
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00DACDD2
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: And you need me to acquire some of these prototype robot parts. &&& MaddieWing: Well ain't you smart? &&& MaddieWing: How about I quit wasting both of our time, and just level with you?|I get reports from time to time about shipments of these prototype robot parts.|I give you the info and you go pay a visit to whatever cargo ship is making the delivery.|You bring the parts back to me, and I pay you for them.
#. DialogueAfter = Player Default: Good. Now listen up.
#. EDID: [01037168]
#. REC: INFO:NAM1
msgctxt "00187F"
msgid "You've got yourself a deal."
msgstr "거래 성립이네."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_MaddieTL04_Quest
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = MaddieWing
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 003BEB66
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: A job? I'm listening. &&& MaddieWing: That's right.|Tiger here's in need of some upgrades.|Thing is, I don't have the parts.|Now, the parts I'm talking about ain't your standard items. |I want the cutting edge stuff. Prototypes. Parts that ain't even on the market yet.
#. DialogueAfter = Player Default: Well that depends on the parts, of course, but I have a few ideas.
#. EDID: [01037170]
#. REC: INFO:NAM1
msgctxt "001880"
msgid "What kinds of modifications are we talking about?"
msgstr "어떤 개조를 말하는 거지?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00469E4A
#. ScriptNotes = / to Cutty
#. DialogueAfter = Cutty: Yeah? Well I just got some bad news.
#. EDID: [0103D1E0]
#. REC: INFO:NAM1
msgctxt "001881"
msgid "Are you okay? You seem to be in a bad mood."
msgstr "괜찮으세요? 기분이 안 좋아 보이시네요."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL03Quest
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Cutty
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00656596
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Talking about a problem is the first step in solving it. &&& Cutty: What are you, a psychiatrist?|*Sigh* Maybe... maybe you're right. &&& Cutty: It's my son Miles. He's a cargo pilot. Makes some dangerous runs.|He got ambushed by Spacers. They seized the ship and took him as a hostage.|His co-pilot Lucia managed to escape from the Spacer hideout. She sent me a message begging for help.|I just don't know who to turn to.
#. DialogueAfter = Player Default: All kinds of reasons, I guess, and every one is awful.
#. EDID: [010404AB]
#. REC: INFO:NAM1
msgctxt "001882"
msgid "Why would someone kidnap your son?"
msgstr "누가 무슨 이유로 아드님을 납치했을까요?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Friendly
#. SoundFileID = 0094A88D
#. ScriptNotes = Sly, letting up to ask for something shady / Friendly / to Player Default
#. Prompt = I'll take a look at what you've got.
#. DialogueBefore = Player Default: I'll take a look at what you've got.
#. DialogueAfter = KillianBrice: I have a network of buyers interested in obtaining rare and dangerous chemical compounds.
#. EDID: [01045E64]
#. REC: INFO:NAM1
msgctxt "001883"
msgid "Of course. But if you'll give me a moment, there's something else I'd like to talk about."
msgstr "좋을 대로. 근데 잠깐 시간을 내주면 안 될까? 따로 이야기하고 싶은 게 있어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = NPCResponse
#. Speaker = NPCMKillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Friendly
#. SoundFileID = 000803D6
#. ScriptNotes = Sly smile, setting up something / Friendly / to Player Default
#. Prompt = I'm <Alias=Player>. Good to meet you.
#. DialogueBefore = Player Default: I'm <Alias=Player>. Good to meet you.
#. DialogueAfter = KillianBrice: I have a network of buyers interested in obtaining rare and dangerous chemical compounds.
#. EDID: [01045E67]
#. REC: INFO:NAM1
msgctxt "001884"
msgid "Likewise. And may I say, your timing is fortunate."
msgstr "반가워. 그나저나, 때를 잘 맞춰 온 것 같군."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0033A2BD
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: So you need a smuggler. &&& KillianBrice: Not quite. There's a little more to it. &&& KillianBrice: Occasionally, in dire circumstances, pilots have to jettison their illicit cargo.|I have the location of one such lost shipment, and I need someone to retrieve it.|There could be other interested parties, so danger is a possibility.
#. DialogueAfter = Player Default: It could hardly be simpler.
#. EDID: [01047142]
#. REC: INFO:NAM1
msgctxt "001885"
msgid "Sounds simple enough. Sign me up."
msgstr "간단한 일 같네. 하겠어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 00D219E5
#. ScriptNotes = / to Player Default
#. Prompt = Sorry, but I like to keep things nice and legal.
#. DialogueBefore = Player Default: Sorry, but I like to keep things nice and legal.
#. DialogueAfter = KillianBrice: Occasionally, in dire circumstances, pilots have to jettison their illicit cargo.
#. EDID: [0104714E]
#. REC: INFO:NAM1
msgctxt "001886"
msgid "It's not what you think. Hear me out."
msgstr "그쪽이 생각하는 그런 일이 아냐. 내 말 좀 들어 보라고."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 00CD295A
#. ScriptNotes = / to Player Default
#. DialogueAfter = Player Default: Sounds simple enough. Sign me up.
#. EDID: [01047140]
#. REC: INFO:NAM1
msgctxt "001887"
msgid "There could be other interested parties, so danger is a possibility."
msgstr "선적물을 노리는 다른 놈들이 더 있을지도 몰라. 그러니까 위험해질 수도 있어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 003489BC
#. ScriptNotes = / to Player Default
#. EDID: [01047140]
#. REC: INFO:NAM1
msgctxt "001888"
msgid "I have the location of one such lost shipment, and I need someone to retrieve it."
msgstr "그런 내던져진 선적물의 위치를 알고 있는데, 누군가가 그것을 회수해 줬으면 해."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 002BBE56
#. ScriptNotes = / to Player Default
#. DialogueBefore = KillianBrice: Not quite. There's a little more to it.
#. EDID: [01047140]
#. REC: INFO:NAM1
msgctxt "001889"
msgid "Occasionally, in dire circumstances, pilots have to jettison their illicit cargo."
msgstr "때때로, 절박한 상황에 닥치면, 조종사들은 불법 화물을 그냥 밖에 내던져두곤 하지."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = NPCResponse
#. Speaker = NPCMKillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 00D17C0E
#. ScriptNotes = / to Player Default
#. Prompt = So you need a smuggler.
#. DialogueBefore = Player Default: So you need a smuggler.
#. DialogueAfter = KillianBrice: Occasionally, in dire circumstances, pilots have to jettison their illicit cargo.
#. EDID: [01047141]
#. REC: INFO:NAM1
msgctxt "00188A"
msgid "Not quite. There's a little more to it."
msgstr "그게 다가 아니야. 그것보단 얘기가 좀 더 복잡하거든."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_RishiTL02_History
#. DialogCallType = NPCResponse
#. Speaker = RishiSaint
#. VoiceType = SFFL_NPCMRishiSaint
#. Face = Confident
#. SoundFileID = 00704EB9
#. ScriptNotes = / to Player Default
#. Prompt = Nobody contested your claim on the station?
#. DialogueAfter = RishiSaint: You had it towed? That couldn't have been cheap.
#. EDID: [010516D3]
#. REC: INFO:NAM1
msgctxt "00188B"
msgid "It was blind luck I learned that it existed at all. A very literal case of finders, keepers."
msgstr "이 우주정거장이 존재한다는 걸 알게 된 건 순전히 우연이었습니다. 그야말로 주운 사람이 임자라는 사례였죠."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_RishiTL02_History
#. DialogCallType = NPCResponse
#. Speaker = RishiSaint
#. VoiceType = SFFL_NPCMRishiSaint
#. Face = Confident
#. SoundFileID = 007913DC
#. ScriptNotes = / to Player Default
#. Prompt = Nobody contested your claim on the station?
#. DialogueBefore = Player Default: Nobody contested your claim on the station?
#. EDID: [010516D3]
#. REC: INFO:NAM1
msgctxt "00188C"
msgid "As I said, the station was abandoned and forgotten. That was many decades ago."
msgstr "말씀드렸듯이, 우주정거장은 버려지고 잊힌 상태였습니다. 수십 년 전의 일이죠."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_RishiTL02_History
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = RishiSaint
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0071A9C9
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: What's the history of this place? &&& RishiSaint: The station was built over eighty years ago as part of a failed business venture.|The intent was to create a jumping-off point to star systems not yet accessible by grav jump.|When the expected advances in Grav Drive technology didn't happen, the station was abandoned and forgotten.|I stumbled across a reference in some old business records and came for a look.|I found it in a decaying orbit around Algorab II and had it towed here, into the Free Lanes.
#. DialogueAfter = Player Default: As I said, the station was abandoned and forgotten. That was many decades ago.
#. EDID: [010516D2]
#. REC: INFO:NAM1
msgctxt "00188D"
msgid "Nobody contested your claim on the station?"
msgstr "아무도 우주정거장의 소유권에 대해 문제 삼지 않았나요?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_RishiTL02_History
#. DialogCallType = NPCResponse
#. Speaker = RishiSaint
#. VoiceType = SFFL_NPCMRishiSaint
#. Face = Confident
#. SoundFileID = 00B17AD3
#. ScriptNotes = / to Player Default
#. Prompt = After all this time, it's impressive the place is still in one piece.
#. EDID: [010516CF]
#. REC: INFO:NAM1
msgctxt "00188E"
msgid "It's true that maintenance is one of my biggest costs, but I accept it as part of the venture."
msgstr "유지보수비가 가장 비용이 많이 드는 것 중 하나인 건 사실이지만, 그것도 이 사업의 일부로 받아들이고 있습니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_RishiTL02_History
#. DialogCallType = NPCResponse
#. Speaker = RishiSaint
#. VoiceType = SFFL_NPCMRishiSaint
#. Face = Confident
#. SoundFileID = 00F84D25
#. ScriptNotes = / to Player Default
#. Prompt = After all this time, it's impressive the place is still in one piece.
#. DialogueBefore = Player Default: After all this time, it's impressive the place is still in one piece.
#. EDID: [010516CF]
#. REC: INFO:NAM1
msgctxt "00188F"
msgid "It's certainly better off than it was when I found it."
msgstr "제가 발견했을 때보다는 확실히 나아졌지요."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianGreet
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCFSarahMorgan
#. Face = Suspicious
#. SoundFileID = 00ED1C2D
#. ScriptNotes = Skeptical / Suspicious / to Player Default
#. DialogueBefore = Player Default: I'm <Alias=Player>. Good to meet you. &&& KillianBrice: Likewise. And may I say, your timing is fortunate. &&& KillianBrice: I have a network of buyers interested in obtaining rare and dangerous chemical compounds.|Being controlled substances, a permit is required to transport the compounds.|Of course, for the resourceful ship's captain, there are always other options.
#. DialogueAfter = Player Default: So you need a smuggler.
#. EDID: [01052F29]
#. REC: INFO:NAM1
msgctxt "001890"
msgid "Resourceful ship's captain sounds an awful lot like a polite way of saying criminal."
msgstr "수완 좋은 선장이라는 말, 범죄자를 정중하게 부르는 표현처럼 들리는데."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianTL02Job
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCFSarahMorgan
#. Face = Stern
#. SoundFileID = 0003179F
#. ScriptNotes = Stern / Stern / to KillianBrice
#. DialogueAfter = KillianBrice: *Sigh* Yes, that was me. I made mistakes, but I have paid my debt to society
#. EDID: [01052F37]
#. REC: INFO:NAM1
msgctxt "001891"
msgid "It was a shameful betrayal of the oath you took, and you got exactly what you deserved."
msgstr "네가 했던 맹세를 추잡하게 배신한 대가야. 아주 제대로 죗값을 치른 거지."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianTL02Job
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCFSarahMorgan
#. Face = Stern
#. SoundFileID = 00C4542C
#. ScriptNotes = Stern / Stern / to KillianBrice
#. EDID: [01052F37]
#. REC: INFO:NAM1
msgctxt "001892"
msgid "You used your position in Vanguard to covertly siphon funds into forged accounts."
msgstr "당신은 뱅가드에서의 지위를 이용해 위조 계좌로 자금을 몰래 빼돌렸지."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_KillianTL02Job
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCFSarahMorgan
#. Face = Confident
#. SoundFileID = 00714EEB
#. ScriptNotes = / to KillianBrice
#. DialogueBefore = Player Default: Good thing he was there for you. &&& KillianBrice: Nobody else was. |I was grateful for the extended hand of friendship.
#. EDID: [01052F37]
#. REC: INFO:NAM1
msgctxt "001893"
msgid "I knew your name sounded familiar, but I've only just placed it."
msgstr "이름이 낯익다 했는데, 이제야 떠올랐네."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_ValeriaTL03_Background
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCMSamCoe
#. Face = Confident
#. SoundFileID = 00404631
#. ScriptNotes = / to ValeriaHahn
#. DialogueAfter = ValeriaHahn: Now that I've told you my life's story, how about a drink?
#. EDID: [01052F33]
#. REC: INFO:NAM1
msgctxt "001894"
msgid "This guy's a real piece of work."
msgstr "이 사람 정말 보통이 아니군."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_ValeriaTL03_Background
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCMSamCoe
#. Face = Irritated
#. SoundFileID = 00BE403D
#. ScriptNotes = Incredulous, a little angry / Irritated / to ValeriaHahn
#. DialogueBefore = Player Default: That's very generous. &&& ValeriaHahn: It might seem that way, but he's making a tidy profit.|I had to agree to pay ten percent extra as interest.|What choice did I have?
#. EDID: [01052F33]
#. REC: INFO:NAM1
msgctxt "001895"
msgid "Charging that kind of interest to a mother with a sick child?"
msgstr "아픈 아이를 둔 어머니에게 그런 이자를 물리다니?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_MaddieTL02_Background
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = MaddieWing
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 001B91DF
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: You said Rishi helped you out. What happened? &&& MaddieWing: I grew up in HopeTown. Parents were engineers. They worked for the company, like everyone else.|As a kid, I was always tinkering. I started building robots out of dumpster parts.|Got to a point where I needed better parts, so I started stealing them from transport ships.|I got caught and the local Ranger locked me up. My parents lost their jobs.|Still feel guilty about that part.
#. DialogueAfter = Player Default: Oh sure, I was real resourceful, until the day I wasn't resourceful enough.
#. EDID: [01052F2A]
#. REC: INFO:NAM1
msgctxt "001896"
msgid "Stealing from cargo ships? You must have been pretty resourceful to pull that off."
msgstr "화물선에서 훔쳤다고? 그걸 해냈다니 재주가 꽤 좋았나 보군."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_MaddieTL02_Background
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = MaddieWing
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00077A24
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: You said Rishi helped you out. What happened? &&& MaddieWing: I grew up in HopeTown. Parents were engineers. They worked for the company, like everyone else.|As a kid, I was always tinkering. I started building robots out of dumpster parts.|Got to a point where I needed better parts, so I started stealing them from transport ships.|I got caught and the local Ranger locked me up. My parents lost their jobs.|Still feel guilty about that part.
#. DialogueAfter = Player Default: It's true that I was alone a lot back then.
#. EDID: [01052F21]
#. REC: INFO:NAM1
msgctxt "001897"
msgid "I'd say it falls on your parents for not raising you better."
msgstr "부모님이 가정 교육을 제대로 하지 못한 탓이라고 치도록 하지."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_MaddieTL02_Background
#. DialogCallType = NPCResponse
#. Speaker = NPCFMaddieWing
#. VoiceType = SFFL_NPCFMaddieWing
#. Face = Irritated
#. SoundFileID = 00517DF0
#. ScriptNotes = Irritated. / Irritated / to Player Default
#. Prompt = You should feel guilty.
#. DialogueBefore = Player Default: You should feel guilty.
#. DialogueAfter = MaddieWing: Anyway, I busted myself out, stowed away aboard a courier ship and spent a few years on the lam.
#. EDID: [01052F20]
#. REC: INFO:NAM1
msgctxt "001898"
msgid "I just said that I do. You don't need to pile on."
msgstr "방금 죄책감이 든다고 말했잖아. 자꾸 말해줄 필요는 없어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_ChanTL02
#. DialogCallType = NPCResponse
#. Speaker = ChanHuang
#. VoiceType = SFFL_NPCMChanHuang
#. Face = Confident
#. SoundFileID = 001D8C57
#. ScriptNotes = Pride comes through at the end / to Player Default
#. EDID: [01054A67]
#. REC: INFO:NAM1
msgctxt "001899"
msgid "Nothing boring about being out here. Besides, I get to be in charge."
msgstr "여기 있으면 전혀 지루하지 않아. 게다가 여기선 내가 책임자잖아."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_ChanTL02
#. DialogCallType = NPCResponse
#. Speaker = ChanHuang
#. VoiceType = SFFL_NPCMChanHuang
#. Face = Somber
#. SoundFileID = 0078A4B9
#. ScriptNotes = Somber / Somber / to Player Default
#. EDID: [01054A67]
#. REC: INFO:NAM1
msgctxt "00189A"
msgid "Every day was the same, staring at walls and counting the hours. A living death by boredom."
msgstr "매일이 똑같았어. 벽만 멍하니 쳐다보며 시간만 때웠어. 시시해 죽을 것 같았지."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_ChanTL02
#. DialogCallType = NPCResponse
#. Speaker = ChanHuang
#. VoiceType = SFFL_NPCMChanHuang
#. Face = Confident
#. SoundFileID = 00B49164
#. ScriptNotes = / to Player Default
#. EDID: [01054A67]
#. REC: INFO:NAM1
msgctxt "00189B"
msgid "I retired, but the pension was next to nothing. "
msgstr "은퇴했지만 연금은 거의 없는 거나 마찬가지였어. "

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_ChanTL02
#. DialogCallType = NPCResponse
#. Speaker = ChanHuang
#. VoiceType = SFFL_NPCMChanHuang
#. Face = Confident
#. SoundFileID = 00424D91
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: What made you want to work in such a remote place?
#. EDID: [01054A67]
#. REC: INFO:NAM1
msgctxt "00189C"
msgid "I used to be Freestar Security. Got wounded in the line of duty."
msgstr "예전에 자유항성 경비대였어. 임무 중 부상을 입었지."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_DanicaTL01
#. DialogCallType = NPCResponse
#. Speaker = DanicaVolkov
#. VoiceType = SFFL_NPCFDanicaVolkov
#. Face = Friendly
#. SoundFileID = 005570C5
#. ScriptNotes = Friendly / to Player Default
#. DialogueBefore = Player Default: Have you got any ships for sale?
#. EDID: [01054A5E]
#. REC: INFO:NAM1
msgctxt "00189D"
msgid "As a matter of fact, I have."
msgstr "사실, 있어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_DanicaTL02
#. DialogCallType = NPCResponse
#. Speaker = DanicaVolkov
#. VoiceType = SFFL_NPCFDanicaVolkov
#. Face = Friendly
#. SoundFileID = 0015D16D
#. ScriptNotes = Enthusiastic / Friendly / to Player Default
#. DialogueBefore = Player Default: I'd like to view and modify my ships.
#. EDID: [01054A6F]
#. REC: INFO:NAM1
msgctxt "00189E"
msgid "Can do!"
msgstr "물론 할 수 있지!"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_MaddieReofferZ02
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = MaddieWing
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00CC95BE
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Got any leads on more of those prototype robot parts? &&& MaddieWing:
#. DialogueAfter = Player Default: You're going to get me some prototype robot parts from a cargo ship. They'll be in the captain's locker.
#. EDID: [0105F4C7]
#. REC: INFO:NAM1
msgctxt "00189F"
msgid "Refresh my memory. What is it you want me to do?"
msgstr "다시 설명해 줘. 내가 뭘 해 주길 원하는 거지?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_MaddieReofferZ02
#. DialogCallType = NPCResponse
#. Speaker = MaddieWing
#. VoiceType = SFFL_NPCFMaddieWing
#. Face = SinisterSmile
#. SoundFileID = 00C054E8
#. ScriptNotes = Eager, devious / SinisterSmile / to Player Default
#. DialogueAfter = Player Default: I'll get those parts for you.
#. EDID: [0105F4D5]
#. REC: INFO:NAM1
msgctxt "0018A0"
msgid "What do you say? Ready for a daring raid on a totally unsuspecting cargo ship?"
msgstr "어때? 경계도 안 하고 있을 화물선을 상대로 대담하게 습격을 벌일 준비 됐어?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_MaddieReofferZ02
#. DialogCallType = NPCResponse
#. Speaker = MaddieWing
#. VoiceType = SFFL_NPCFMaddieWing
#. Face = Neutral
#. SoundFileID = 00412F2B
#. ScriptNotes = Halting, realizing you have to explain the joke. / to Player Default
#. EDID: [0105F4D5]
#. REC: INFO:NAM1
msgctxt "0018A1"
msgid "That's a yes, by the way."
msgstr "참고로 이건 승낙한다는 뜻이야."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_MaddieReofferZ02
#. DialogCallType = NPCResponse
#. Speaker = MaddieWing
#. VoiceType = SFFL_NPCFMaddieWing
#. Face = Friendly
#. SoundFileID = 00DF166F
#. ScriptNotes = Eager, excited / Friendly / to Player Default
#. DialogueBefore = Player Default: Got any leads on more of those prototype robot parts?
#. EDID: [0105F4D5]
#. REC: INFO:NAM1
msgctxt "0018A2"
msgid "Does the auxiliary thermal control circuit overheat every time I so much as look at it funny?"
msgstr "보조 열 제어 회로 저건 매번 슬쩍 쳐다보기만 해도 과열되더라?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_MaddieReofferZ02
#. DialogCallType = NPCResponse
#. Speaker = MaddieWing
#. VoiceType = SFFL_NPCFMaddieWing
#. Face = Irritated
#. SoundFileID = 0094FF64
#. ScriptNotes = Mildly irritated / Irritated / to Player Default
#. DialogueBefore = Player Default: Got any leads on more of those prototype robot parts?
#. DialogueAfter = Player Default: I'll get those parts for you.
#. EDID: [0105F4CF]
#. REC: INFO:NAM1
msgctxt "0018A3"
msgid "Not yet. And to be honest, I'm getting a little antsy."
msgstr "아직은 없어. 솔직히 좀 초조해지고 있어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_Killian_ReofferZ04
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 00A8A0D5
#. ScriptNotes = / to Player Default
#. Prompt = Just so I have the details straight, what's the job again?
#. DialogueAfter = KillianBrice: I'll get that shipment.
#. EDID: [0106574B]
#. REC: INFO:NAM1
msgctxt "0018A4"
msgid "I have the shipment's location and a willing buyer. I just need you to collect it."
msgstr "선적물 위치도 알고, 구매자도 구해 뒀어. 가서 회수만 해오면 돼."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_Killian_ReofferZ04
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 003C8E38
#. ScriptNotes = / to Player Default
#. Prompt = Just so I have the details straight, what's the job again?
#. DialogueBefore = Player Default: Just so I have the details straight, what's the job again?
#. EDID: [0106574B]
#. REC: INFO:NAM1
msgctxt "0018A5"
msgid "There's a lost shipment of contraband toxins, likely jettisoned to avoid piracy or seizure."
msgstr "독소 밀수품 선적물이 있어. 해적들에게 빼앗기거나 압수당하는 걸 피하려고 우주에 내던져진 선적물이지."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_Killian_ReofferZ04
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 0006F67B
#. ScriptNotes = A little disappointed / to Player Default
#. DialogueBefore = Player Default: Do you have any more leads on lost shipments?
#. DialogueAfter = Player Default: I'll get that shipment.
#. EDID: [01065751]
#. REC: INFO:NAM1
msgctxt "0018A6"
msgid "Nothing yet, but it's only a matter of time."
msgstr "아직은 정보가 퍼지진 않았지만, 시간문제일 뿐이야."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_Killian_ReofferZ04
#. DialogCallType = NPCResponse
#. Speaker = KillianBrice
#. VoiceType = SFFL_NPCMKillianBrice
#. Face = Neutral
#. SoundFileID = 00D06D34
#. ScriptNotes = / to Player Default
#. Prompt = I'll have to pass this time.
#. DialogueBefore = Player Default: I'll have to pass this time.
#. EDID: [0106573B]
#. REC: INFO:NAM1
msgctxt "0018A7"
msgid "I understand. Perhaps another time."
msgstr "알겠어. 다음 기회로 미루자고."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyMilesScene
#. DialogCallType = NPCResponse
#. Speaker = CuttyClean
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00719513
#. ScriptNotes = Disdain, maybe a chuckle to add levity / to MilesCutler
#. DialogueAfter = MilesCutler: Hey, at least it's not boring, right?
#. EDID: [0106BB7D]
#. REC: INFO:NAM1
msgctxt "0018A8"
msgid "Most of the injuries I treat result from drunken brawls."
msgstr "제가 치료하는 부상 대부분은 술 취한 난투에서 비롯됩니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyMilesScene
#. DialogCallType = NPCResponse
#. Speaker = CuttyClean
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 000762A8
#. ScriptNotes = / to MilesCutler
#. EDID: [0106BB7D]
#. REC: INFO:NAM1
msgctxt "0018A9"
msgid "We get our share of colorful characters through here, and more than a few are prone to violence."
msgstr "이곳엔 개성 강한 사람들이 꽤 드나들고, 폭력 성향이 있는 사람도 적지 않습니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyMilesScene
#. DialogCallType = NPCResponse
#. Speaker = CuttyClean
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 007D0C52
#. ScriptNotes = / to MilesCutler
#. DialogueBefore = MilesCutler: So, uh... how have you been otherwise? Does this place keep you busy?
#. EDID: [0106BB7D]
#. REC: INFO:NAM1
msgctxt "0018AA"
msgid "Reasonably so, yes."
msgstr "합리적인 정도로는, 그렇습니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL04Clean
#. DialogCallType = NPCResponse
#. Speaker = CuttyClean
#. VoiceType = SFFL_NPCMCutty
#. Face = Friendly
#. SoundFileID = 00C53E58
#. ScriptNotes = Warm, friendly / Friendly / to Player Default
#. Prompt = How are things with you and Miles?
#. DialogueAfter = CuttyClean: You can do this. I have faith in you.
#. EDID: [0106BB7F]
#. REC: INFO:NAM1
msgctxt "0018AB"
msgid "For that, I am in your debt."
msgstr "그 일에 대해서는 제가 당신께 빚을 졌습니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL04Clean
#. DialogCallType = NPCResponse
#. Speaker = CuttyClean
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 005015F0
#. ScriptNotes = / to Player Default
#. Prompt = How are things with you and Miles?
#. EDID: [0106BB7F]
#. REC: INFO:NAM1
msgctxt "0018AC"
msgid "It's a start, and more than I could have dared to hope for."
msgstr "시작으로는 충분하고, 제가 감히 바라던 것보다도 큽니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL04Clean
#. DialogCallType = NPCResponse
#. Speaker = CuttyClean
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00466F79
#. ScriptNotes = / to Player Default
#. Prompt = How are things with you and Miles?
#. EDID: [0106BB7F]
#. REC: INFO:NAM1
msgctxt "0018AD"
msgid "I would describe our relationship as cordial, at least for now."
msgstr "적어도 지금은, 우리의 관계를 우호적이라고 표현하겠습니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyTL04Clean
#. DialogCallType = NPCResponse
#. Speaker = CuttyClean
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00660892
#. ScriptNotes = / to Player Default
#. Prompt = How are things with you and Miles?
#. DialogueBefore = Player Default: How are things with you and Miles?
#. EDID: [0106BB7F]
#. REC: INFO:NAM1
msgctxt "0018AE"
msgid "He sent me a letter, and then came to visit."
msgstr "그가 편지를 보낸 뒤 직접 찾아왔습니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_IntroSceneAlternate
#. DialogCallType = NPCResponse
#. Speaker = ChanHuang
#. VoiceType = SFFL_NPCMChanHuang
#. Face = Confident
#. SoundFileID = 00230A09
#. ScriptNotes = Firm refusal. / to RishiSaint
#. DialogueBefore = ChanHuang: We should evacuate. The Spacers could already be on their way. &&& RishiSaint: And give up Anchorpoint? Hell no!|Why not send one of your people?
#. DialogueAfter = RishiSaint: Then hire someone. One of the patrons maybe. I'll pay the cost.
#. EDID: [0106C44C]
#. REC: INFO:NAM1
msgctxt "0018AF"
msgid "To attack a Spacer stronghold head-on? No way I'd give that order."
msgstr "스페이서 본거지를 정면으로 공격하란 말입니까? 그런 명령은 절대 못 내립니다."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00A3EEC3
#. ScriptNotes = Grumpy. A doctor who feels like the patient is wasting their time.
#. EDID: [01053DED]
#. REC: INFO:NAM1
msgctxt "0018B0"
msgid "In that case, you can see yourself out."
msgstr "그렇다면 알아서 나가."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00BDB37E
#. ScriptNotes = A doctor talking as he treats a patient's wounds.
#. EDID: [01053DCC]
#. REC: INFO:NAM1
msgctxt "0018B1"
msgid "This shouldn't take long."
msgstr "오래 걸리진 않을 거야."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 007DA8E5
#. ScriptNotes = A doctor talking as he treats a patient's wounds.
#. EDID: [01053DCB]
#. REC: INFO:NAM1
msgctxt "0018B2"
msgid "Hold still for a minute."
msgstr "잠깐 가만히 있어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00B63B91
#. ScriptNotes = A doctor examining a patient
#. EDID: [01053DDE]
#. REC: INFO:NAM1
msgctxt "0018B3"
msgid "Not like I've got anything better to do. Now hold still so I can have a look..."
msgstr "딱히 더 나은 할 일도 없으니까. 이제 가만히 있어, 좀 보게..."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00DD7F41
#. ScriptNotes = A doctor examining a patient who has no injuries
#. EDID: [01053DFD]
#. REC: INFO:NAM1
msgctxt "0018B4"
msgid "Come on, there's nothing wrong with you."
msgstr "이봐, 너한테 아무 문제 없어."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00E7735C
#. ScriptNotes = A doctor examining a patient who has no injuries
#. EDID: [01053DFC]
#. REC: INFO:NAM1
msgctxt "0018B5"
msgid "You're fine. Not a scratch on you."
msgstr "괜찮아. 긁힌 데 하나 없네."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00EDF9D2
#. ScriptNotes = A doctor evaluating a patient with serious injuries.
#. EDID: [01053DDA]
#. REC: INFO:NAM1
msgctxt "0018B6"
msgid "Look at this mess. What the hell kind of trouble have you been getting into?"
msgstr "이 꼴 좀 봐. 대체 무슨 문제에 휘말리고 다닌 거야?"

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00360D25
#. ScriptNotes = A doctor evaluating a patient with serious injuries.
#. EDID: [01053DD8]
#. REC: INFO:NAM1
msgctxt "0018B7"
msgid "Damn. You're a mess."
msgstr "젠장. 엉망이네."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00EE0593
#. ScriptNotes = A doctor treating a patient
#. EDID: [01053DD6]
#. REC: INFO:NAM1
msgctxt "0018B8"
msgid "Might want to bite down on something."
msgstr "뭔가 꽉 물고 있는 게 좋을 거야."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 00665F85
#. ScriptNotes = Friendly, a doctor who has just finished patching up a patient.
#. EDID: [01053DE9]
#. REC: INFO:NAM1
msgctxt "0018B9"
msgid "You're good to go."
msgstr "이제 가도 돼."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 0047589A
#. ScriptNotes = Friendly, a doctor telling a patient they don't have enough money.
#. EDID: [01053DFA]
#. REC: INFO:NAM1
msgctxt "0018BA"
msgid "How about you come back when you've got the the money."
msgstr "돈 생기면 다시 오는 게 어때."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. DialogCallType = NPCResponse
#. Speaker = NPCMCutty
#. VoiceType = SFFL_NPCMCutty
#. Face = Neutral
#. SoundFileID = 002829C7
#. ScriptNotes = Friendly, a doctor telling a patient they don't have enough money.
#. EDID: [01053DF8]
#. REC: INFO:NAM1
msgctxt "0018BB"
msgid "Can't afford to treat you for free."
msgstr "공짜로 치료해 줄 여유는 없어."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCMIvicaVukovic
#. VoiceType = SFFL_MS01_NPCMIvicaVukovic
#. Face = Neutral
#. SoundFileID = 000E314E
#. ScriptNotes = Goodbye in Croatian
#. EDID: [01031695]
#. REC: INFO:NAM1
msgctxt "0018BC"
msgid "Dovidenja."
msgstr "도비뎨냐. (또 만나.)"

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFGenericFemale
#. VoiceType = SFFL_NPCFGenericFemale04
#. Face = Neutral
#. SoundFileID = 00AF878E
#. ScriptNotes = Neutral
#. EDID: [01052F7D]
#. REC: INFO:NAM1
msgctxt "0018BD"
msgid "Hey, you're in the Vanguard, right? I can tell. I hope to join up myself someday."
msgstr "저기, 당신 뱅가드 소속 맞죠? 딱 보면 알아요. 저도 언젠가는 꼭 입대하고 싶거든요."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCMIvicaVukovic
#. VoiceType = SFFL_MS01_NPCMIvicaVukovic
#. Face = Serious
#. SoundFileID = 00D3624C
#. ScriptNotes = Serious
#. EDID: [010647AB]
#. REC: INFO:NAM1
msgctxt "0018BE"
msgid "As far as I'm concerned, it's over. Everyone should get back to work. "
msgstr "내가 보기에는 다 끝난 일이야. 다들 군말 말고 일이나 하라 그래. "

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFSunniKim
#. VoiceType = SFFL_MS01_NPCFSunniKim
#. Face = Sarcastic
#. SoundFileID = 00F498F1
#. ScriptNotes = Sarcastic
#. EDID: SFFL_MS01_QuestSharedInfo04
#. REC: INFO:NAM1
msgctxt "0018BF"
msgid "Man, I was really hoping for a guillotine."
msgstr "에이, 단두대를 보는 걸 기대했는데요."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFZenaHield
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 00DEB3F5
#. ScriptNotes = Neutral
#. EDID: [0103169B]
#. REC: INFO:NAM1
msgctxt "0018C0"
msgid "His past aside, I'm thankful Hal's still here."
msgstr "과거가 어쨌든, 할이 아직 여기 있어 줘서 고마워."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCMHalCaruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 008267DF
#. ScriptNotes = Neutral
#. EDID: [010647BD]
#. REC: INFO:NAM1
msgctxt "0018C1"
msgid "The shadows of my past will always linger, but I do feel a weight has been lifted from my shoulders."
msgstr "과거의 그림자는 언제나 남겠지만, 어깨에서 짐이 내려간 느낌은 듭니다."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFSashaAtwell
#. VoiceType = SFFL_MS01_NPCFSashaAtwell
#. Face = Neutral
#. SoundFileID = 0057A3AA
#. ScriptNotes = Neutral
#. EDID: [0103169F]
#. REC: INFO:NAM1
msgctxt "0018C2"
msgid "Exile it is. The punishment fits the crime."
msgstr "추방됐습니다. 죄에 걸맞은 처벌입니다."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCMCaspianRoberson
#. VoiceType = SFFL_MS01_NPCMCaspianRoberson
#. Face = Serious
#. SoundFileID = 00CCFDD2
#. ScriptNotes = Serious
#. EDID: [010647B6]
#. REC: INFO:NAM1
msgctxt "0018C3"
msgid "Whatever Hal's done; he's making it right here. We made the right decision."
msgstr "할이 무슨 일을 했든, 그는 여기서 바로잡고 있습니다. 우리는 옳은 결정을 내렸습니다."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFSashaAtwell
#. VoiceType = SFFL_MS01_NPCFSashaAtwell
#. Face = Neutral
#. SoundFileID = 008C98A0
#. ScriptNotes = Neutral
#. EDID: [010316AC]
#. REC: INFO:NAM1
msgctxt "0018C4"
msgid "Hal sealed his fate when he broke the law."
msgstr "할은 법을 어긴 순간 자기 운명을 결정지은 겁니다."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCMCaspianRoberson
#. VoiceType = SFFL_MS01_NPCMCaspianRoberson
#. Face = Depressed
#. SoundFileID = 00DEEC44
#. ScriptNotes = Depressed
#. EDID: [010316A6]
#. REC: INFO:NAM1
msgctxt "0018C6"
msgid "We're murderers. We murdered him with that vote."
msgstr "우린 살인자야. 그 투표로 그를 죽인 거라고."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. SceneName = SFFL_MS01_HelpWanted_050_CaspianTL03
#. DialogCallType = NPCResponse
#. Speaker = Caspian
#. VoiceType = SFFL_MS01_NPCMCaspianRoberson
#. Face = Apologetic
#. SoundFileID = 001E86C6
#. ScriptNotes = Apologetic / to Player Default
#. EDID: [01030761]
#. REC: INFO:NAM1
msgctxt "0018C7"
msgid "I just rush through things sometimes, and it always bites me in the ass."
msgstr "가끔 일을 너무 급하게 처리할 때, 항상 발등을 찍곤 하더라고요."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. SceneName = SFFL_MS01_HelpWanted_050_CaspianTL03
#. DialogCallType = NPCResponse
#. Speaker = Caspian
#. VoiceType = SFFL_MS01_NPCMCaspianRoberson
#. Face = Disgust
#. SoundFileID = 00CEB51C
#. ScriptNotes = Disgust / to Player Default
#. DialogueBefore = Player Default: Is something wrong with the water pump?
#. EDID: [01030761]
#. REC: INFO:NAM1
msgctxt "0018C8"
msgid "Yeah, I was doing maintenance on it, and I messed something up with the valve."
msgstr "네, 정비를 하다가 밸브 쪽을 좀 잘못 건드렸어요."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2410_Sasha_Greet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Sasha
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 002B266E
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Sunni wants to get kicked out. &&& Sasha: Well, it's true she's a round peg trying to fit in a square hole. And by round, I mean a cactus.
#. DialogueAfter = Player Default: Damn, I never pegged her for that. But if there's a motive AND evidence clearing this drunk, I guess he can go.
#. EDID: [01023C93]
#. REC: INFO:NAM1
msgctxt "0018C9"
msgid "She's trying to sell it on the black market."
msgstr "써니는 그걸 암시장에 팔아넘기려던 모양이더군요."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2950_CarusoEnd_Greet
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 00916982
#. DialogueAfter = Player Default: It has. The vote says you're to die for your crimes.
#. EDID: [0103CFC1]
#. REC: INFO:NAM1
msgctxt "0018CA"
msgid "You return. I trust the vote is done."
msgstr "돌아왔군요. 투표는 끝났으리라 믿습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2920_ZenaVoteCarusoShot
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 00074B38
#. ScriptNotes = If Bernhard lives / to Sasha
#. DialogueBefore = Zena: Cass, wait! &&& SunniKim: Holy shit. &&& Sasha: Goddamnit kid! What did you do?
#. DialogueAfter = Sasha: Yes ma'am!
#. EDID: [01045E52]
#. REC: INFO:NAM1
msgctxt "0018CB"
msgid "Everyone, stand down! Sasha, escort the prisoner to a holding cell, now!"
msgstr "모두 물러서! 사샤, 죄수를 감옥으로 데려가, 당장!"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2330_Caspian_Greeet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Caspian
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00DBF486
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: That may be a medical grade sedative, applied via a syringe. &&& Caspian: Oh yeah, like animal tranquilizer or something! &&& Caspian: Hal wanted to look in the dumpster bins for anything suspicious.|But then the water pump broke and uh... yeah. That's when you showed up.
#. DialogueAfter = Player Default: Yeah, Hal and I thought it best to lock it down until we could do a little sleuthing. But if you're on the case, I can give you the key.
#. EDID: [01030765]
#. REC: INFO:NAM1
msgctxt "0018CC"
msgid "Is the dumpster locked?"
msgstr "쓰레기통 잠겨 있어요?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2535_TalkToResidents_TL_YeatsExtra
#. DialogCallType = NPCResponse
#. Speaker = Yeats
#. VoiceType = SFFL_MS01_NPCMYeats
#. Face = Friendly
#. SoundFileID = 00E6EC27
#. ScriptNotes = If Yeats is no longer preaching religion / Friendly
#. DialogueBefore = Yeats: It feels divine.
#. EDID: [0103076E]
#. REC: INFO:NAM1
msgctxt "0018CD"
msgid "Of course, we don't believe in divinities, not anymore, anyway! But a feeling is not a god."
msgstr "물론 우리는 신성을 믿지 않습니다. 더는 아니죠! 하지만 느낌은 신이 아닙니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2535_TalkToResidents_TL_YeatsExtra
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0075B247
#. DialogueAfter = Yeats: It feels divine.
#. EDID: [01030770]
#. REC: INFO:NAM1
msgctxt "0018CE"
msgid "How does it feel to be out?"
msgstr "밖에 나오니 기분이 어때?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2535_TalkToResidents_TL_YeatsExtra
#. DialogCallType = NPCResponse
#. Speaker = Yeats
#. VoiceType = SFFL_MS01_NPCMYeats
#. Face = Neutral
#. SoundFileID = 00B5437E
#. DialogueBefore = Player Default: How does it feel to be out?
#. DialogueAfter = Yeats: Of course, we don't believe in divinities, not anymore, anyway! But a feeling is not a god.
#. EDID: [0103076F]
#. REC: INFO:NAM1
msgctxt "0018CF"
msgid "It feels divine."
msgstr "신성한 기분이야."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_b1100_Ivica_SceneDrilling
#. DialogCallType = NPCResponse
#. Speaker = Ivica
#. VoiceType = SFFL_MS01_NPCMIvicaVukovic
#. Face = Neutral
#. SoundFileID = 00A4B934
#. ScriptNotes = / to Cave_BreakableWall
#. EDID: [01031367]
#. REC: INFO:NAM1
msgctxt "0018D0"
msgid "Yes! Do it! Break down that wall!"
msgstr "좋아! 해! 그 벽을 부숴!"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_b1000_IvicaGreet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Ivica
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00C1CA47
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: [Lie] I can do that. Just tell me how. &&& Ivica: One word: Magnets. The robot likes to go to the junkyard, and dig for spare parts.|If you turn on the magnet while it's searching, it'll scramble its egg.
#. DialogueAfter = Player Default: The magnet will destroy the hard drive. But I only need the components. It'll be fine.
#. EDID: [01031365]
#. REC: INFO:NAM1
msgctxt "0018D1"
msgid "If the magnet damages the parts, how are they still of use?"
msgstr "자석이 부품을 손상시킨다면, 어떻게 아직 쓸 수 있는 거죠?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2909_CaspianTalkHimDown
#. DialogCallType = NPCResponse
#. Speaker = Caspian
#. VoiceType = SFFL_MS01_NPCMCaspianRoberson
#. Face = Somber
#. SoundFileID = 00194B39
#. ScriptNotes = Somber
#. DialogueBefore = Caspian: He killed Hal! You understand? He fucking killed him!
#. DialogueAfter = Player Default: It's not. But neither is this.
#. EDID: [010316BE]
#. REC: INFO:NAM1
msgctxt "0018D2"
msgid "How is any of this okay?"
msgstr "이게 어떻게 괜찮을 수 있죠?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2400_Caruso_TL09_EvidenceCOPY0000
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00F1AD8D
#. DialogueAfter = Caruso: Well, it's a chem. That doesn't means it's related to Yeats.
#. EDID: [010388B2]
#. REC: INFO:NAM1
msgctxt "0018D3"
msgid "[Chems] I found this along with other evidence."
msgstr "[약물] 다른 증거와 함께 이걸 찾았어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2920_BernhardKilledZenaGreet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00231A44
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Bernhard, the refugee from Shinar, tried to kill Caruso. I stopped him. &&& Caspian: It's true. I checked his cell. Hal... Hal's dead.
#. DialogueAfter = Player Default: And who's going to get revenge for him?
#. EDID: [010388F1]
#. REC: INFO:NAM1
msgctxt "0018D4"
msgid "He killed Caruso. This was retribution."
msgstr "그가 카루소를 죽였어. 이건 보복이었어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_d3100_CarusoZenaGreet
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 00A98B93
#. ScriptNotes = Neutral / to Player Default
#. Prompt = Why me?
#. DialogueBefore = Player Default: Why me?
#. DialogueAfter = Zena: I can do that.
#. EDID: [0103CFC5]
#. REC: INFO:NAM1
msgctxt "0018D5"
msgid "Because you're the most neutral party here. You've seen Shinar, but you've also seen what Hal's done for us here."
msgstr "당신이 여기서 가장 중립적인 사람이니까요. 시나르도 봤고, 할이 여기서 우리를 위해 한 일도 봤잖아요."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_d3100_CarusoZenaGreet
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 002B8F8F
#. ScriptNotes = Neutral / to Player Default
#. Prompt = Hopefully it doesn't come to that.
#. DialogueBefore = Player Default: Hopefully it doesn't come to that.
#. DialogueAfter = Zena: *Sigh* Regardless, it looks we have a long day ahead of us. We best get to it.
#. EDID: [0103CFBC]
#. REC: INFO:NAM1
msgctxt "0018D6"
msgid "Yeah, hopefully."
msgstr "그래, 그랬으면 좋겠어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_d3100_CarusoZenaGreet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Zena
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0061E796
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: There is someone else who would be better than me. A survivor of the Shinar Outpost. &&& Zena: If such a person exists, then their testimony would be more than welcome. &&& Zena: For my part, I'll try to get the word out about the trial and what it means for this Outpost, especially given recent events. &&& Zena: Oh, and one other thing. If the vote ends up a tie, I'd like you to break it.
#. DialogueAfter = Player Default: Yeah, hopefully.
#. EDID: [0103CFBA]
#. REC: INFO:NAM1
msgctxt "0018D7"
msgid "Hopefully it doesn't come to that."
msgstr "그렇게 되지 않았으면 좋겠어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_d3100_CarusoZenaGreet
#. DialogCallType = NPCResponse
#. Speaker = NPCFZenaHield
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 00185EB1
#. ScriptNotes = Neutral / to Player Default
#. Prompt = I can do that.
#. DialogueBefore = Player Default: I can do that.
#. DialogueAfter = Zena: *Sigh* Regardless, it looks we have a long day ahead of us. We best get to it.
#. EDID: [0103CFCC]
#. REC: INFO:NAM1
msgctxt "0018D8"
msgid "Thank you. Keep in mind, it's still a democratic process."
msgstr "감사합니다. 그래도 민주적인 절차라는 점은 기억해 주세요."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3100_Bernhard_Greet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00BAA24F
#. ScriptNotes = / to Player Default
#. DialogueBefore = Bernhard: You again? Did you ever find Shinar?
#. DialogueAfter = Player Default: Yes. The conditions were rough, but together we had tamed its hazards. It saddens me to think of all the knowledge we lost.
#. EDID: [0103D1D4]
#. REC: INFO:NAM1
msgctxt "0018D9"
msgid "Based on what I saw, it would've been a fine outpost, had your luck been better."
msgstr "제가 본 바로는, 운이 좀 더 좋았다면 훌륭한 전초기지가 됐을 겁니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2910_ZenaVoteTallyTIE
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Zena
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00BCBAFD
#. ScriptNotes = / to Player Default
#. DialogueBefore = Zena: Citizens, if all the votes are in, I'll cast my vote and we'll begin the tally. &&& ... &&& Zena: Now, to count the votes. &&& Zena: It seems we have a tie. We've decided that in this event, the visitor, as a neutral party, will break the tie. &&& Zena: The floor is yours. What say you?
#. DialogueAfter = Player Default: Very well.
#. EDID: [0103E329]
#. REC: INFO:NAM1
msgctxt "0018DA"
msgid "Exile."
msgstr "추방."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_d3200_CarusoTL03
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Caruso
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 009B842A
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: We'll see how the vote goes down. &&& Caruso: Indeed. When we first met, you said my life was forfeit. Do you still think so?
#. DialogueAfter = Caruso: I see. Then let the verdict be fair and just.
#. EDID: [0103FAED]
#. REC: INFO:NAM1
msgctxt "0018DB"
msgid "I'm not going to tell you. You'll just have to wait."
msgstr "말해 주지 않을 거야. 기다려 봐."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_b1200_Sunni_Greet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 008360E9
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: [Remain silent] &&& SunniKim: So it's the silent treatment, huh. Well, two can play that game.|...|Never mind. You win. Turns out, I don't know how to play. &&& SunniKim: Name's Sunni, with an I. I run the farm here. Also, I'm kind of a bitch.
#. DialogueAfter = Player Default: Nah, I think I just like being one. Cool thought though.
#. EDID: [010483F3]
#. REC: INFO:NAM1
msgctxt "0018DC"
msgid "I'm sure it's how you cope."
msgstr "그게 네가 견디는 방식이겠지."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_200_CarusoTL01
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCMSamCoe
#. Face = Confident
#. SoundFileID = 009FC161
#. DialogueBefore = Player Default: If I had the materials I could craft one. &&& Caruso: I had a similar thought. The junkyard might have the parts, but the magnet is hooked up to the same power source. &&& Caruso: You'll need to talk to Ivica, the supply coordinator. &&& Caruso: I've been trying to convince him to shift around the outpost's power distribution, with little luck.|Maybe you'll be able to sway him.
#. DialogueAfter = Caruso: Ivica's a stubborn man. I'm not sure force is the right tactic. But I'll leave it to your judgment.
#. EDID: [01051379]
#. REC: INFO:NAM1
msgctxt "0018DD"
msgid "We'll try our best."
msgstr "최선을 다해 볼게요."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_b1000_IvicaGreet
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCMSamCoe
#. Face = Confident
#. SoundFileID = 004DC176
#. DialogueBefore = Player Default: It's temporary. We just need the robot to help out for a time. &&& Ivica: Sranje, temporary. &&& Ivica: Robots can't be trusted to do work that was meant to be done with human hands.
#. DialogueAfter = Player Default: Human labor is superior. If anything, the robot should be scrapped.
#. EDID: [01052C8D]
#. REC: INFO:NAM1
msgctxt "0018DE"
msgid "Never trust a bucket of bolts to do a person's job. No offense to Vasco."
msgstr "고철덩어리에게 사람 일을 절대 맡기지 마. 바스코에게 악감정은 없지만."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_b1000_IvicaGreet
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCFAndreja
#. Face = Neutral
#. SoundFileID = 00181272
#. ScriptNotes = Neutral
#. DialogueBefore = Player Default: It's temporary. We just need the robot to help out for a time. &&& Ivica: Sranje, temporary. &&& Ivica: Robots can't be trusted to do work that was meant to be done with human hands.
#. DialogueAfter = Player Default: Human labor is superior. If anything, the robot should be scrapped.
#. EDID: [01052C8B]
#. REC: INFO:NAM1
msgctxt "0018DF"
msgid "It depends on how competent the hands are, robot or otherwise."
msgstr "로봇이든 아니든, 손이 얼마나 유능한지에 달려 있지."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3100_Bernhard_Greet
#. DialogCallType = NPCResponse
#. Speaker = Bernhard
#. VoiceType = SFFL_MS01_NPCMBernhardKleiber
#. Face = Somber
#. SoundFileID = 00171A74
#. ScriptNotes = Somber
#. DialogueAfter = Player Default: It's okay. It's going to take time to process.
#. EDID: [01052E9A]
#. REC: INFO:NAM1
msgctxt "0018E0"
msgid "I don't know how to feel about it."
msgstr "이걸 어떻게 받아들여야 할지 모르겠어요."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3100_Bernhard_Greet
#. DialogCallType = NPCResponse
#. Speaker = Bernhard
#. VoiceType = SFFL_MS01_NPCMBernhardKleiber
#. Face = Neutral
#. SoundFileID = 00896D03
#. ScriptNotes = Neutral
#. DialogueBefore = Bernhard: What? Really? Then he's finally dead? I... I don't know what to say.
#. EDID: [01052E9A]
#. REC: INFO:NAM1
msgctxt "0018E1"
msgid "It's strange. I've been waiting for so long to hear those words and yet..."
msgstr "이상하네요. 그 말을 듣기 위해 정말 오래 기다렸는데, 막상..."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3100_Bernhard_Greet
#. DialogCallType = NPCResponse
#. Speaker = Bernhard
#. VoiceType = SFFL_MS01_NPCMBernhardKleiber
#. Face = Confused
#. SoundFileID = 000E9AD9
#. ScriptNotes = Confused / to Player Default
#. Prompt = Maybe relief to get some closure.
#. DialogueBefore = Player Default: Maybe relief to get some closure.
#. DialogueAfter = Bernhard: *Sigh* Either way, thank you, stranger. While I don't know if closure will ever come, it's good to know others will not befall the same fate.
#. EDID: [01052E9F]
#. REC: INFO:NAM1
msgctxt "0018E2"
msgid "Perhaps those feelings will come. Now I just feel... well, I don't know how I feel."
msgstr "어쩌면 그런 감정이 찾아오겠죠. 지금은 그냥... 글쎄요, 제가 어떤 기분인지 모르겠습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3100_Bernhard_Greet
#. DialogCallType = NPCResponse
#. Speaker = Bernhard
#. VoiceType = SFFL_MS01_NPCMBernhardKleiber
#. Face = Relieved
#. SoundFileID = 00D68DE8
#. ScriptNotes = Relieved
#. DialogueBefore = Bernhard: You're right. I just thought I'd feel better. But it's more complicated than that.
#. DialogueAfter = Player Default: You should know, I found Caruso.
#. EDID: [01052E98]
#. REC: INFO:NAM1
msgctxt "0018E3"
msgid "*Sigh* Either way, thank you, stranger. While I don't know if closure will ever come, it's good to know others will not befall the same fate."
msgstr "*한숨* 어쨌든 고마워요, 낯선 분. 완전한 마무리가 찾아올지는 모르겠지만, 다른 사람들이 같은 운명을 겪지 않게 됐다는 건 다행입니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3100_Bernhard_Greet
#. DialogCallType = NPCResponse
#. Speaker = Bernhard
#. VoiceType = SFFL_MS01_NPCMBernhardKleiber
#. Face = Surprised
#. SoundFileID = 00BDAFDD
#. ScriptNotes = Surprised
#. DialogueBefore = Player Default: You should know, I found and killed Caruso.
#. DialogueAfter = Bernhard: It's strange. I've been waiting for so long to hear those words and yet...
#. EDID: [01052E9E]
#. REC: INFO:NAM1
msgctxt "0018E4"
msgid "What? Really? Then he's finally dead? I... I don't know what to say."
msgstr "뭐라고요? 정말요? 그럼 그가 마침내 죽은 건가요? 저는... 뭐라고 해야 할지 모르겠어요."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 0039E512
#. EDID: [01083DA3]
#. REC: INFO:NAM1
msgctxt "001A11"
msgid "Need something?"
msgstr "필요한 거 있어?"

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 0091532B
#. EDID: [01083D98]
#. REC: INFO:NAM1
msgctxt "001A12"
msgid "I need a beer. Maybe two."
msgstr "맥주가 필요해. 어쩌면 두 잔."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 00C3B7F6
#. EDID: [01083D92]
#. REC: INFO:NAM1
msgctxt "001A13"
msgid "Is now a good time to talk about my salary?"
msgstr "지금 내 급여 얘기하기 좋은 때인가?"

#. List: 2
