#. DialogueAfter = Ivica: Hvala puno. You've done this entire outpost a service.
#. EDID: [01021550]
#. REC: INFO:NAM1
msgctxt "000462"
msgid "[Robot Parts] Just so you know, the robot is broken. Permanently."
msgstr "[로봇 부품] 알아둬. 그 로봇은 망가졌어. 영구적으로."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_b1100_Ivica_TL01
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
