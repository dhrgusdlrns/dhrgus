#. SoundFileID = 00A30C79
#. ScriptNotes = / to Player Default
#. DialogueBefore = Captain:
#. EDID: [01053DA1]
#. REC: INFO:NAM1
msgctxt "00169F"
msgid "We won't have any problems if you don't make any."
msgstr "네가 문제를 일으키지 않으면 우리도 문제를 일으키지 않을 거야."

#. List: 2
#. QuestName = SFFL_R03
#. SceneName = SFFL_R03_175a_SpeakWithCaptain_Betrayal_ShipDamaged01
#. DialogCallType = NPCResponse
#. Speaker = Captain
#. VoiceType = SFFL_R03_NPCMCivilian01
#. Face = Angry
#. SoundFileID = 00295E5A
#. ScriptNotes = Angry / to Player Default
#. EDID: [01053D79]
#. REC: INFO:NAM1
msgctxt "0016A0"
msgid "Open fire!"
msgstr "발사!"

#. List: 2
#. QuestName = SFFL_R03
#. SceneName = SFFL_R03_175a_SpeakWithCaptain_Betrayal_ShipDamaged01
#. DialogCallType = NPCResponse
#. Speaker = Captain
#. VoiceType = SFFL_R03_NPCMCivilian01
#. Face = Neutral
#. SoundFileID = 0018AC6F
#. ScriptNotes = Neutral / to Player Default
#. EDID: [01053D79]
#. REC: INFO:NAM1
msgctxt "0016A1"
msgid "So, we're taking your ship, and you can't come with us."
msgstr "그러니까, 우리가 네 우주선을 좀 접수해야겠어. 물론 넌 같이 못 가는 거고."

#. List: 2
#. QuestName = SFFL_R03
#. SceneName = SFFL_R03_175a_SpeakWithCaptain_Betrayal_ShipDamaged01
#. DialogCallType = NPCResponse
#. Speaker = Captain
#. VoiceType = SFFL_R03_NPCMCivilian01
#. Face = Neutral
#. SoundFileID = 00D9522F
#. ScriptNotes = Neutral / to Player Default
#. DialogueBefore = Captain: The thing is, we aren't who you think we are.
#. EDID: [01053D79]
#. REC: INFO:NAM1
msgctxt "0016A2"
msgid "Look, it was nice of you to try and help us, but the people I work for aren't nice people. We're as good as dead if we don't finish our delivery."
msgstr ""
"봐, 우릴 도와주려 한 건 고마운데, 나랑 같이 일하는 사람들은 좋은 사람들이 아니야. 배송을 끝내지 못하면 우린 사실상 죽은 목숨이야."

#. List: 2
#. QuestName = SFFL_R03
#. SceneName = SFFL_R03_175a_SpeakWithCaptain_Betrayal_PilotKilled01
#. DialogCallType = NPCResponse
#. Speaker = Captain
#. VoiceType = SFFL_R03_NPCMCivilian01
#. Face = Neutral
#. SoundFileID = 0060BFC3
#. ScriptNotes = Neutral / to Player Default
#. DialogueAfter = Player Default: Sorry about your pilot.
#. EDID: [01053D68]
#. REC: INFO:NAM1
msgctxt "0016A3"
msgid "Thanks for your help. I know it's a burden but we're out of options. As you can see, we're down a pilot."
msgstr "도와줘서 고맙군. 부담되는 일인 건 알지만 선택지가 없어. 보시다시피 조종사가 없거든."

#. List: 2
#. QuestName = SFFL_R03
#. SceneName = SFFL_R03_175a_SpeakWithCaptain_Betrayal_ShipDamaged01
#. DialogCallType = NPCResponse
#. Speaker = Captain
#. VoiceType = SFFL_R03_NPCMCivilian01
#. Face = Neutral
#. SoundFileID = 0039C733
#. ScriptNotes = Neutral
#. DialogueBefore = Captain:
#. DialogueAfter = Player Default: Thanks.
#. EDID: [01053D97]
#. REC: INFO:NAM1
msgctxt "0016A4"
msgid "I just gotta say, that's a great ship you have. "
msgstr "이 말은 꼭 해야겠는데, 우주선 정말 좋네. "

#. List: 2
#. QuestName = SFFL_AnchorpointZ02A
#. SceneName = SFFL_AnchorpointZ02A_DeliveryScene
#. DialogCallType = NPCResponse
#. Speaker = MaddieWing
#. VoiceType = SFFL_NPCFMaddieWing
#. Face = Concerned
#. SoundFileID = 00B82DED
#. ScriptNotes = Disappointed / Concerned / to Player Default
#. DialogueBefore = MaddieWing: I'll just take those off your hands, thank you very much.
#. DialogueAfter = MaddieWing: And here you go, payment as promised.
#. EDID: [0105D54B]
#. REC: INFO:NAM1
msgctxt "0016A5"
msgid "You brought me damaged parts? I ain't paying full price for these."
msgstr "손상된 부품을 가져왔어? 이런 걸 제값 다 줄 순 없어."

#. List: 2
#. QuestName = SFFL_AnchorpointZ02A
#. SceneName = SFFL_AnchorpointZ02A_DeliveryScene
#. DialogCallType = NPCResponse
#. Speaker = MaddieWing
#. VoiceType = SFFL_NPCFMaddieWing
#. Face = Impressed
#. SoundFileID = 0088B237
#. ScriptNotes = Impressed / Impressed / to Player Default
#. DialogueBefore = MaddieWing: I'll just take those off your hands, thank you very much.
#. DialogueAfter = MaddieWing: And here you go, payment as promised.
#. EDID: [0105D546]
#. REC: INFO:NAM1
msgctxt "0016A6"
msgid "Shiny and new, I see. Glad you got them in good shape."
msgstr "반짝반짝한 신품이구나. 멀쩡한 상태로 가져와서 다행이야."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_MainBranchYura01Scene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Worried
#. SoundFileID = 00AC7401
#. ScriptNotes = Worried / to Player Default
#. Prompt = You should tell her how you feel yourself. It will mean more coming from you.
#. DialogueBefore = Player Default: You should tell her how you feel yourself. It will mean more coming from you.
#. DialogueAfter = Roman: Be honest, and don't trust someone else to tell her how you feel.
#. EDID: SFFL_MS03_Roman_LeadershipResponse01
#. REC: INFO:NAM1
msgctxt "0016A7"
msgid "That's what everyone keeps telling me... I just don't want to ruin everything if I make the wrong call."
msgstr "모두가 내게 그렇게 말해... 잘못된 결정을 해서 모든 걸 망치고 싶지 않을 뿐이야."

#. List: 2
#. EDID: SFFL_MS03_Roman_CreditsPaidResponse01
#. REC: INFO:NAM1
msgctxt "0016A8"
msgid "Nice doing business with you."
msgstr "거래해서 즐거웠어."

#. List: 2
#. QuestName = SFFL_MS03
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Grateful
#. SoundFileID = 003D8914
#. ScriptNotes = Grateful
#. EDID: [0105B44A]
#. REC: INFO:NAM1
msgctxt "0016A9"
msgid "Thanks for being cool. I swear this won't happen again."
msgstr "쿨하게 대해 줘서 고마워. 다시는 이런 일 없을 거라고 맹세해."

#. List: 2
#. QuestName = SFFL_MS03
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Confident
#. SoundFileID = 00ED346D
#. ScriptNotes = Confident
#. EDID: [0105B446]
#. REC: INFO:NAM1
msgctxt "0016AA"
msgid "Thanks for letting me take those credits off your hands."
msgstr "크레딧을 가져가게 해 줘서 고마워."

#. List: 2
#. QuestName = SFFL_MS03
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale / NPCFGenericFemale
