#. Face = Confused
#. SoundFileID = 003C96CA
#. ScriptNotes = Yelling at the player in combat. Confused panic. / Confused
#. EDID: [0106D5B8]
#. REC: INFO:NAM1
msgctxt "0012E5"
msgid "What did we ever do to you?"
msgstr "너한테 대체 무슨 짓을 했다고?"

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman01Scene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0031774D
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Roman wanted me to put in a good word for him with you. &&& Yura: Roman's the best. &&& Yura: I can't believe he did all this for me. &&& Yura: I really wish I deserved someone like him, but I'm just not relationship material. Not right now.
#. DialogueAfter = Player Default: Give him a chance so I can screw it all up?
#. EDID: [0105BF72]
#. REC: INFO:NAM1
msgctxt "0012E6"
msgid "He really likes you, Yura. Give him a chance."
msgstr "로만은 널 정말 좋아해. 유라. 기회를 줘봐."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Atka_TL_MilliScene
