msgstr "그래?"

#. List: 2
#. QuestName = SFFL_R02
#. DialogCallType = NPCResponse
#. Speaker = NPCMTheArbitrator
#. VoiceType = SFFL_R02_NPCMTheArbitrator
#. Face = Serious
#. SoundFileID = 007F9994
#. ScriptNotes = Serious
#. EDID: [01045EC6]
#. REC: INFO:NAM1
msgctxt "001D99"
msgid "What are you waiting for? Get going."
msgstr "뭘 기다리고 있어? 어서 가."

#. List: 2
#. QuestName = SFFL_R02
