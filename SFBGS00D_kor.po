#. SoundFileID = 00AB099E
#. ScriptNotes = Thinking about things, coming around to the player's persuasive argument. Sadness as well. / Depressed / to Player Default
#. EDID: [0106BBBB]
#. REC: INFO:NAM1
msgctxt "000BAD"
msgid "You're right. As much as I wish I could just forget all of this, I can't."
msgstr "네 말이 맞아. 이 모든 걸 그냥 잊을 수 있으면 좋겠지만, 그럴 수는 없어."

#. List: 2
#. QuestName = SFFL_AnchorpointZ03
#. SceneName = SFFL_AnchorpointZ03_SC02Easy
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00E42CA3
#. ScriptNotes = / to MilesCutler
#. EDID: [0106BB8F]
#. REC: INFO:NAM1
msgctxt "000BAE"
msgid "This rift is hurting you both every day."
msgstr "이 균열이 매일 두 사람 모두를 아프게 하고 있어."

#. List: 2
#. QuestName = SFFL_AnchorpointZ03
#. SceneName = SFFL_AnchorpointZ03_SC01Easy
#. DialogCallType = NPCResponse
#. Speaker = MilesCutler
#. VoiceType = SFFL_NPCMMilesCutler
#. Face = Neutral
#. SoundFileID = 0049A4F7
#. ScriptNotes = Skeptical / to Player Default
#. EDID: [0106BBF1]
#. REC: INFO:NAM1
msgctxt "000BAF"
msgid "You should be telling him that."
msgstr "그 말은 그에게 해야지."

#. List: 2
#. QuestName = SFFL_AnchorpointZ03
#. SceneName = SFFL_AnchorpointZ03_SC01Easy
#. DialogCallType = NPCResponse
#. Speaker = MilesCutler
#. VoiceType = SFFL_NPCMMilesCutler
#. Face = Neutral
#. SoundFileID = 006A4772
#. ScriptNotes = Thinking about things, coming around to the player's persuasive argument. / to Player Default
#. EDID: [0106BBEC]
#. REC: INFO:NAM1
msgctxt "000BB0"
msgid "You're right. So much time has already been lost."
msgstr "네 말이 맞아. 이미 너무 많은 시간이 사라졌어."

#. List: 2
#. QuestName = SFFL_AnchorpointZ03
#. SceneName = SFFL_AnchorpointZ03_MilesScene
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCFAndreja
#. Face = Sad
#. SoundFileID = 001B6DCC
#. ScriptNotes = Sympathetic / Sad / to MilesCutler
#. DialogueBefore = Player Default: If you want to talk about it, I'm listening. &&& MilesCutler: Yeah. You risked a lot coming out here, so it's the least I can do. &&& MilesCutler: He was a doctor, well-respected but arrogant.|My wife was about to give birth and there were complications. The life-threatening kind.|He demanded to do the surgery, but it wasn't his area of expertise.|His hubris cost both of their lives.|He left the very next day, and cut off all contact.
#. DialogueAfter = Player Default: He's at Anchorpoint. You should reach out, try to heal the rift.
#. EDID: [0106BBC1]
#. REC: INFO:NAM1
msgctxt "000BB1"
msgid "It's not hard to understand how such a tragedy could tear a family apart."
msgstr "그런 비극이 어떻게 가족을 갈라놓을 수 있는지 이해하기 어렵지 않아."

#. List: 2
#. QuestName = SFFL_AnchorpointZ03
#. SceneName = SFFL_AnchorpointZ03_MilesScene
#. DialogCallType = NPCResponse
#. Speaker = MilesCutler
#. VoiceType = SFFL_NPCMMilesCutler
#. Face = Somber
#. SoundFileID = 0090C769
#. ScriptNotes = Somber, bracing to talk about a difficult subject. / Somber / to Player Default
#. Prompt = What happened? I'm involved now, so I have a right to know.
#. DialogueBefore = Player Default: What happened? I'm involved now, so I have a right to know.
#. DialogueAfter = MilesCutler: He was a doctor, well-respected but arrogant.
#. EDID: [0106BB92]
#. REC: INFO:NAM1
msgctxt "000BB2"
msgid "You're right. Just know that it's not a happy tale."
msgstr "네 말이 맞아. 다만 행복한 이야기는 아니라는 것만 알아 둬."

#. List: 2
#. QuestName = SFFL_R03
#. DialogCallType = NPCResponse
#. Speaker = NPCFCivilian
#. VoiceType = SFFL_R03_NPCFCivilian01
#. Face = Confused
#. SoundFileID = 00482FAE
#. ScriptNotes = Confused
#. EDID: [0104C41F]
#. REC: INFO:NAM1
msgctxt "000BB9"
msgid "Are you saying anything? Not sure if I'm getting interference..."
msgstr "뭐라고 하고 있나요? 통신 간섭이 있는 건지 잘 모르겠군요..."

#. List: 2
#. QuestName = SFFL_R03
#. DialogCallType = NPCResponse
#. Speaker = NPCMCivilian / NPCFCivilian
#. VoiceType = SFFL_R03_NPCMCivilian01 / SFFL_R03_NPCFCivilian01
#. Face = Neutral
#. SoundFileID = 008D9AFD
#. EDID: [0104C425]
#. REC: INFO:NAM1
msgctxt "000BBA"
msgid "We appreciate the help."
msgstr "도와주셔서 감사합니다."

#. List: 2
#. QuestName = SFFL_R03
#. DialogCallType = NPCResponse
#. Speaker = NPCMCivilian
#. VoiceType = SFFL_R03_NPCMCivilian01
#. Face = Neutral
#. SoundFileID = 002B866B
#. EDID: [01050245]
#. REC: INFO:NAM1
msgctxt "000BBB"
msgid "Thanks again."
msgstr "정말 고맙습니다."

#. List: 2
#. QuestName = SFFL_R03
#. DialogCallType = NPCResponse
