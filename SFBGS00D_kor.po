#. ScriptNotes = / to Actor01
#. EDID: [01058D77]
#. REC: INFO:NAM1
msgctxt "001B9D"
msgid "We should hire more security personnel."
msgstr "경비대 인력을 더 고용해야 합니다."

#. List: 2
#. QuestName = SFFL_Anchorpoint_RandConv08_ChanRishi
#. SceneName = SFFL_Anchorpoint_RandConv06_ChanKillianSceneCOPY0000COPY0000
#. DialogCallType = NPCResponse
#. Speaker = Actor02
