msgid "Pay <Global=SFFL_MS03_RansomCredits>: Here's your credits."
msgstr "[<Global=SFFL_MS03_RansomCredits> 크레딧 주기] 여기 크레딧이야."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_SC_Repeatable02Scene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = SinisterSmile
#. SoundFileID = 00799A03
#. ScriptNotes = Speech challenge lose: I'm willing to do this the hard way. / SinisterSmile / to Player Default
#. EDID: [01059D45]
#. REC: INFO:NAM1
msgctxt "000C36"
msgid "Do I look like someone who cares?"
msgstr "내가 신경 쓸 것처럼 보여?"

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_SC_Repeatable02Scene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Nervous
