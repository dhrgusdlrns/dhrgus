#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_TruthScene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Concerned
#. SoundFileID = 00BA4040
#. ScriptNotes = Concerned / to Player Default
#. Prompt = It's hard to put yourself out there, but you can do this.
#. DialogueBefore = Player Default: It's hard to put yourself out there, but you can do this.
#. EDID: [01059CFE]
#. REC: INFO:NAM1
msgctxt "001CDF"
msgid "Easier said than done."
msgstr "말처럼 쉽진 않아."

