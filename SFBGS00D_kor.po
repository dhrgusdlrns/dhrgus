#. EDID: [01064801]
#. REC: INFO:NAM1
msgctxt "001551"
msgid "Please hurry!"
msgstr "서둘러 주세요!"

#. List: 2
#. QuestName = SFFL_SE_EC07
#. SceneName = SFFL_SE_EC07_120_PostHail
#. DialogCallType = NPCResponse
#. Speaker = GalBankShip
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Spaceship / Nervous
