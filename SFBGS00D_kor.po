#. DialogueBefore = Player Default: Give me something that I can say is proof that I killed you. Then leave, and never look back.
#. DialogueAfter = GenNPC: Wait, no! Don't do this!
#. EDID: [010590DC]
#. REC: INFO:NAM1
msgctxt "00133E"
msgid "Oh my... thank you, thank you!"
msgstr "어머... 고마워요, 고마워요!"

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralNPC_Scene
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale / NPCFGenericFemale
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
