#. EDID: [01029887]
#. REC: INFO:NAM1
msgctxt "0017F3"
msgid "Hmmph, suit yourself. "
msgstr "흠, 마음대로 해."

#. List: 2
#. QuestName = SFFL_R01
#. SceneName = SFFL_R01_TurnIn
#. DialogCallType = NPCResponse
