#. List: 2
#. QuestName = SFFL_Z01_SE1
#. SceneName = SFFL_Z01_100a_Hailing_SEHOY
#. DialogCallType = NPCResponse
#. Speaker = HailingShip
#. VoiceType = SFFL_NPCSehoyBaker
#. Face = Spaceship / Neutral
#. SoundFileID = 000E52F9
#. ScriptNotes = Nervous and desperate. Sehoy has been trying to get help for days with no results. [Spaceship]
#. EDID: [010325F2]
#. REC: INFO:NAM1
msgctxt "000CAA"
msgid "Hello? Is someone there? Please, tell me if you can hear me. This is Sehoy Baker."
msgstr "여보세요? 거기 누구 있나요? 제 말이 들리면 제발 알려주세요. 저는 세호이 베이커입니다."

#. List: 2
#. QuestName = SFFL_Z01_SE1
#. SceneName = SFFL_Z01_100b_HailingAnswered_SEHOY
#. DialogCallType = NPCResponse
#. Speaker = NPCSehoyBaker
#. VoiceType = SFFL_NPCSehoyBaker
#. Face = Spaceship / Neutral
#. SoundFileID = 0040DBB5
