#. EDID: [01027E2A]
#. REC: INFO:NAM1
msgctxt "000809"
msgid "Take a look."
msgstr "살펴 봐."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. SceneName = SFFL_MS01_HelpWanted_050_Ivica_TL00_Vendor
#. DialogCallType = NPCResponse
