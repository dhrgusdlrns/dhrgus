#. DialogueBefore = Satellite:
#. DialogueAfter = Satellite:
#. EDID: [0106B176]
#. REC: INFO:NAM1
msgctxt "001F2C"
msgid "Please wait for further messages."
msgstr "추가 메시지를 기다려 주십시오."

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_250_CompanionInterjection
