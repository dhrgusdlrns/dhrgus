#. DialogueAfter = Player Default: Yes, a lot of very good people were lost. Brilliant minds.
#. EDID: [01026BDD]
#. REC: INFO:NAM1
msgctxt "0006CD"
msgid "I did, and I'm sorry."
msgstr "그랬어. 미안해."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3100_Bernhard_Greet
#. DialogCallType = NPCResponse
#. Speaker = Bernhard
