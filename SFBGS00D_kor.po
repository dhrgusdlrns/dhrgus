#. ScriptNotes = Angry pirate on the radio after the player shot a ship from their fleet. / Rage
#. DialogueAfter = ActiveCompanion: A third ship has joined the fight. Watch out!
#. EDID: [0106D504]
#. REC: INFO:NAM1
msgctxt "001A80"
msgid "No! We just finished fixing up that ship!"
msgstr "안 돼! 방금 그 우주선 수리를 끝냈는데!"

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_Pirate03_Scene
