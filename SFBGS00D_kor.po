#. Face = Neutral
#. SoundFileID = 00352DAD
#. ScriptNotes = A painful sounding cough, like something is stuck in your throat / Neutral
#. EDID: [0104AF02]
#. REC: INFO:NAM1
msgctxt "001D89"
msgid "*Coughing*"
msgstr "*기침*"

#. List: 2
#. QuestName = SFFL_SE01
#. SceneName = SFFL_SE01_250_GrandmaTalkBranch
#. DialogCallType = NPCResponse
#. Speaker = Grandma
#. VoiceType = SFFL_SE01_NPCFGrandma
