#. REC: INFO:NAM1
msgctxt "00080C"
msgid "I'd like to purchase supplies."
msgstr "보급품을 사고 싶습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2535_TalkToResidents_TL_Grace
#. DialogCallType = NPCResponse
#. Speaker = GraceKim
#. VoiceType = SFFL_MS01_NPCFGraceKim
#. Face = Defiant
#. SoundFileID = 00492F97
#. ScriptNotes = Defiant / to Player Default
#. Prompt = I'm voting for his execution. I suggest you do the same.
#. DialogueBefore = Player Default: I'm voting for his execution. I suggest you do the same.
#. EDID: SFFL_MS01_QuestSharedInfo01
#. REC: INFO:NAM1
msgctxt "00080D"
msgid "Aye-aye captain. Say no more."
msgstr "알겠습니다, 선장님. 더는 묻지 않겠습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCFZenaHield
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 008B37E4
#. EDID: SFFL_MS01_QuestSharedInfo02
#. REC: INFO:NAM1
msgctxt "00080E"
msgid "Then we have a verdict."
msgstr "그럼 판결이 났군요."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCMBernhardKleiber
#. VoiceType = SFFL_MS01_NPCMBernhardKleiber
#. Face = Neutral
#. SoundFileID = 0058479C
#. EDID: [01027C3E]
#. REC: INFO:NAM1
msgctxt "00080F"
msgid "Let the fates decide then. Live or die, let the Tragedy of Shinar be a cross he must bear."
msgstr "그렇다면 운명에 맡기죠. 살든 죽든, 시나르의 비극이 그가 짊어져야 할 십자가가 되게 합시다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCMBernhardKleiber
#. VoiceType = SFFL_MS01_NPCMBernhardKleiber
#. Face = Neutral
#. SoundFileID = 00A3E227
#. EDID: [01027C3D]
#. REC: INFO:NAM1
msgctxt "000810"
msgid "I will meet you at this outpost. Provided Caruso hasn't razed it to the ground."
msgstr "이 전초기지에서 만나겠습니다. 카루소가 그곳을 잿더미로 만들지 않았다면요."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCMYeats
#. VoiceType = SFFL_MS01_NPCMYeats
#. Face = Neutral
#. SoundFileID = 00145BA8
#. ScriptNotes = Neutral
#. EDID: [01027D1A]
#. REC: INFO:NAM1
msgctxt "000811"
msgid "Perhaps Hal saw this coming. Now, more than ever, we need hope to guide us through."
msgstr "어쩌면 할은 이런 날이 올 줄 알고 있었을 지도 모르겠습니니다. 지금이야말로 그 어느 때보다 우리를 이끌어줄 희망이 간절합니다."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFSashaAtwell
#. VoiceType = SFFL_MS01_NPCFSashaAtwell
#. Face = Neutral
#. SoundFileID = 006F1006
#. ScriptNotes = Neutral
#. EDID: [01027D19]
#. REC: INFO:NAM1
msgctxt "000812"
msgid "Man alive, I'm gonna spend a whole month writing the reports for this."
msgstr "이런, 이거 보고서 쓰는 데만 한 달은 걸리겠습니다."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCMCaspianRoberson
#. VoiceType = SFFL_MS01_NPCMCaspianRoberson
#. Face = Sad
#. SoundFileID = 00E07DBF
#. ScriptNotes = Sad
#. EDID: [01027D18]
#. REC: INFO:NAM1
msgctxt "000813"
msgid "I can't believe Hal's dead."
msgstr "할이 죽었다니 믿을 수가 없어."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFGraceKim
#. VoiceType = SFFL_MS01_NPCFGraceKim
#. Face = Neutral
#. SoundFileID = 005EAD79
#. EDID: [01027D17]
#. REC: INFO:NAM1
msgctxt "000814"
msgid "It'll take a lot to save this place."
msgstr "이곳을 살리려면 노력이 엄청나게 필요할 거예요."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCFSunniKim
#. VoiceType = SFFL_MS01_NPCFSunniKim
#. Face = Neutral
#. SoundFileID = 003250D6
#. EDID: [01027D16]
#. REC: INFO:NAM1
msgctxt "000815"
msgid "I'm loving all this chaos."
msgstr "이 혼란이 너무 좋아요."

#. List: 2
#. QuestName = SFFL_MS01_MiscDialogue
#. DialogCallType = NPCResponse
#. Speaker = NPCMIvicaVukovic
#. VoiceType = SFFL_MS01_NPCMIvicaVukovic
#. Face = Neutral
#. SoundFileID = 00C094AA
#. EDID: [01027D15]
#. REC: INFO:NAM1
msgctxt "000816"
msgid "This outpost has gone to shit. It may be time to leave."
msgstr "이 전초기지는 끝장났어. 슬슬 떠날 때가 된 것 같군."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCMCaspianRoberson
#. VoiceType = SFFL_MS01_NPCMCaspianRoberson
#. Face = Neutral
#. SoundFileID = 00C2CA27
#. EDID: [01027B7C]
#. REC: INFO:NAM1
msgctxt "000817"
msgid "My dad founded this place, but he passed a while ago. I didn't know him well."
msgstr "우리 아버지가 이곳을 세웠지만, 오래전에 돌아가셨어. 잘 알지는 못했어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCMCaspianRoberson
#. VoiceType = SFFL_MS01_NPCMCaspianRoberson
#. Face = Neutral
#. SoundFileID = 00C1EA8F
#. EDID: [01027B7B]
#. REC: INFO:NAM1
msgctxt "000818"
msgid "I pick up a lot of the odd jobs around here that other people can't do, or won't do."
msgstr "여기서 남들이 못 하거나 안 하려는 잡일을 꽤 많이 맡아 하고 있어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCMCaspianRoberson
#. VoiceType = SFFL_MS01_NPCMCaspianRoberson
#. Face = Neutral
#. SoundFileID = 003D377C
#. EDID: [01027B7A]
#. REC: INFO:NAM1
msgctxt "000819"
msgid "Name's Caspian. Some people call me Cass for short."
msgstr "이름은 캐스피언이야. 줄여서 캐스라고 부르는 사람도 있어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCMYeats
#. VoiceType = SFFL_MS01_NPCMYeats
#. Face = Neutral
#. SoundFileID = 00F45661
#. EDID: [01027B79]
#. REC: INFO:NAM1
msgctxt "00081A"
msgid "I'm free. The air smells sweeter. Foul still, but sweeter. That may or not be my own breath."
msgstr "난 자유야. 공기 냄새가 더 달콤하군. 여전히 고약하지만, 그래도 달콤해. 아니면 내 입냄새일지도 모르고."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCFSashaAtwell
#. VoiceType = SFFL_MS01_NPCFSashaAtwell
#. Face = Neutral
#. SoundFileID = 004B2989
#. EDID: [01027C74]
#. REC: INFO:NAM1
msgctxt "00081B"
msgid "I appreciate you helping out with the whole Yeats thing, but leave investigating to the professionals, okay?"
msgstr "예이츠 일을 도와준 건 고맙지만, 수사는 전문가에게 맡기십쇼. 알겠죠?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCFZenaHield
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 0018A763
#. EDID: [01027B78]
#. REC: INFO:NAM1
msgctxt "00081C"
msgid "After a year here, Hal was voted in as a citizen unanimously. He's been invaluable."
msgstr "여기 온 지 1년 만에 할은 만장일치로 주민으로 인정받았어. 없어서는 안 될 사람이 됐지."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. DialogCallType = NPCResponse
#. Speaker = NPCMIvicaVukovic
#. VoiceType = SFFL_MS01_NPCMIvicaVukovic
#. Face = Neutral
#. SoundFileID = 00816E3D
#. EDID: [01027C73]
#. REC: INFO:NAM1
msgctxt "00081D"
msgid "Was it you who fixed that blasted robot? That thing is better as spare parts."
msgstr "그 망할 로봇을 고친 게 너야? 그건 예비 부품으로 쓰는 게 더 나아."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2600_GraceKim_TL10_Confront
#. DialogCallType = NPCResponse
#. Speaker = GraceKim
#. VoiceType = SFFL_MS01_NPCFGraceKim
#. Face = Neutral
#. SoundFileID = 0080B299
#. DialogueAfter = Player Default: So it IS Caspian's blood.
#. EDID: [0102173F]
#. REC: INFO:NAM1
msgctxt "00081E"
msgid "Which means both Ivica AND Caspian are Rh-Null? That's impossible."
msgstr "그럼 이비카와 캐스피언이 둘 다 Rh-Null이라는 뜻인가? 말도 안 돼."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2310_Caspian_TL01
#. DialogCallType = NPCResponse
#. Speaker = Caspian
#. VoiceType = SFFL_MS01_NPCMCaspianRoberson
#. Face = Neutral
#. SoundFileID = 00F96ED3
#. ScriptNotes = / to Player Default
#. Prompt = You wouldn't say that if you knew what kind of man Hal really is.
#. DialogueAfter = Caspian: So the night it all went down, I was organizing the supplies over here, trying to get my system right.
#. EDID: [01021718]
#. REC: INFO:NAM1
msgctxt "00081F"
msgid "Let me explain."
msgstr "설명하겠습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2100_Yeats_Intro
#. DialogCallType = NPCResponse
#. Speaker = Yeats
#. VoiceType = SFFL_MS01_NPCMYeats
#. Face = Neutral
#. SoundFileID = 00902B70
#. ScriptNotes = / to Player Default
#. Prompt = Well, I'm not here to lie to you.
#. DialogueAfter = Yeats: Indeed. Sasha tells me Hal Caruso is dead, by your hand. But I am not taking confessions.
#. EDID: [010216C7]
#. REC: INFO:NAM1
msgctxt "000820"
msgid "The floor is yours."
msgstr "말씀하시죠."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_x1CarusoDiesArc_160_CarusoDead_Zena01
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Zena
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0095B74C
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Your man attacked me without provocation. It was self-defense. &&& Caspian: Liar! &&& Zena: The Hal we know wouldn't attack anyone unprovoked. So you'll excuse us if we find it hard to believe.
#. DialogueAfter = Player Default: No...
#. EDID: [010215D9]
#. REC: INFO:NAM1
msgctxt "000821"
msgid "[Attack] I'm done talking. You're all dead."
msgstr "[공격] 이야기는 끝이야. 너희는 다 죽었어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_x1CarusoDiesArc_160_CarusoDead_Zena01
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00A84105
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: "Hal" was a murderer. He got what he deserved. &&& Caspian: Bullshit! Hal never hurt anyone! &&& Zena: That's a heavy accusation, stranger. Do you have proof?
#. DialogueAfter = Caspian: The hell it doesn't!
#. EDID: [01027E21]
#. REC: INFO:NAM1
msgctxt "000822"
msgid "I don't have any proof. But this doesn't have to turn into a fight."
msgstr "증거는 없어. 하지만 이게 꼭 싸움으로 번질 필요는 없어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_140_Caruso_Greet
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 009AB4B1
#. ScriptNotes = / to Player Default
#. Prompt = What do you mean, let the people decide?
#. DialogueAfter = Caruso: I've seen you die before. But things may change this time.
#. EDID: [010215A4]
#. REC: INFO:NAM1
msgctxt "000823"
msgid "I would put it to vote. Let the people of New Babylon know my crimes, and be my judge."
msgstr "투표에 부치겠습니다. 뉴바빌론 사람들에게 제 죄를 알리고, 그들이 저를 심판하게 하겠습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2535_TalkToResidents_TL_Ivica
#. DialogCallType = NPCResponse
#. Speaker = Ivica
#. VoiceType = SFFL_MS01_NPCMIvicaVukovic
#. Face = Neutral
#. SoundFileID = 00C8F26C
#. DialogueBefore = Ivica: Well, if he's done something that serious, he should answer to the law. |Still, based on his work ethic, he's a changed man. Exile might be the best option.
#. DialogueAfter = Player Default: Good workers are hard to find. Keep him around for that sake alone.
#. EDID: [01027B71]
#. REC: INFO:NAM1
msgctxt "000824"
msgid "Either way, I will do my own research and vote when I know enough."
msgstr "어쨌든 나는 직접 조사해 보고, 충분히 알게 되면 투표하겠어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3400_Zena_VoteStart
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 00C8071A
#. ScriptNotes = / to Player Default
#. Prompt = Never mind.
#. DialogueBefore = Player Default: Never mind.
#. DialogueAfter = Player Default: Someone swapped votes with their own.
#. EDID: [01026BD1]
#. REC: INFO:NAM1
msgctxt "000825"
msgid "Then we'll continue."
msgstr "그럼 계속하지."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c3400_Zena_VoteStart
#. DialogCallType = NPCResponse
#. Speaker = NPCFZenaHield
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 0097B571
#. ScriptNotes = / to Player Default
#. Prompt = I think someone messed with the vote.
#. DialogueBefore = Player Default: I think someone messed with the vote.
#. DialogueAfter = Player Default: There's an extra vote. Someone may have voted twice.
#. EDID: [01026C11]
#. REC: INFO:NAM1
msgctxt "000826"
msgid "Really? In what way?"
msgstr "정말? 어떤 식으로?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2950_CarusoEnd_Greet
#. DialogCallType = NPCResponse
#. Speaker = NPCMHalCaruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 004BB34C
#. ScriptNotes = / to Player Default
#. Prompt = All right. I can take you to Shinar.
#. DialogueAfter = Player Default: I will be honored to.
#. EDID: [010275DC]
#. REC: INFO:NAM1
msgctxt "000827"
msgid "It's a dagger I've owned since childhood, which I used to slay my first groat."
msgstr "어릴 때부터 가지고 있던 단검이야. 이걸로 내 첫 그로트를 죽였지."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2950_CarusoEnd_Greet
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 0022A301
#. DialogueAfter = Caruso: Bury me there, amongst the others.
#. EDID: [010275DF]
#. REC: INFO:NAM1
msgctxt "000828"
msgid "So it's strange now, for others to insist I continue living. I know not how."
msgstr "그래서 이상하군요. 이제 와서 남들이 계속 살아가라고 강요하다니. 어떻게 해야 할지 모르겠습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2750_ZenaVoteGreet
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 00275192
#. ScriptNotes = Neutral
#. EDID: [0102761F]
#. REC: INFO:NAM1
msgctxt "000829"
msgid "Otherwise, I assume this is goodbye."
msgstr "아니라면, 이걸로 작별인가 보군요."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2750_ZenaVoteGreet
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 00527457
#. ScriptNotes = / to Player Default
#. Prompt = The cycle of violence.
#. DialogueBefore = Player Default: The cycle of violence.
#. DialogueAfter = Zena: Things were so promising here. I actually thought I could retire.
#. EDID: [010275CD]
#. REC: INFO:NAM1
msgctxt "00082A"
msgid "But why now? We were a peaceful outpost."
msgstr "그런데 왜 지금이지? 우리는 평화로운 전초기지였어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2750_ZenaVoteGreet
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 00D738A9
#. ScriptNotes = / to Player Default
#. Prompt = I'm just as shocked as you are.
#. DialogueBefore = Player Default: I'm just as shocked as you are.
#. DialogueAfter = Zena: Things were so promising here. I actually thought I could retire.
#. EDID: [010275AE]
#. REC: INFO:NAM1
msgctxt "00082B"
msgid "I thought things were under control."
msgstr "상황이 통제되고 있다고 생각했어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2750_ZenaVoteGreet
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 00C48DAD
#. ScriptNotes = / to Player Default
#. Prompt = You have a long road ahead of you.
#. DialogueBefore = Player Default: You have a long road ahead of you.
#. DialogueAfter = Zena: Things were so promising here. I actually thought I could retire.
#. EDID: [010275F2]
#. REC: INFO:NAM1
msgctxt "00082C"
msgid "Long, and hard."
msgstr "길고도, 힘들었죠."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2910_ZenaVoteTally
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Defiant
#. SoundFileID = 00FCFE6E
#. ScriptNotes = Defiant / to BallotBoxVotingMarkerThird
#. EDID: [010275C1]
#. REC: INFO:NAM1
msgctxt "00082D"
msgid "New Babylon will continue to grow and thrive in spite of what happened today."
msgstr "오늘 일에도 불구하고 뉴바빌론은 계속 성장하고 번영할 것입니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2910_ZenaVoteTally
#. DialogCallType = NPCResponse
#. Speaker = Zena
#. VoiceType = SFFL_MS01_NPCFZenaHield
#. Face = Neutral
#. SoundFileID = 00161903
#. DialogueAfter = Zena: What's wrong? Why are you interrupting me?
#. EDID: [01027626]
#. REC: INFO:NAM1
msgctxt "00082E"
msgid "Citizens, if all the votes are in, I'll cast my vote and we'll begin the tally."
msgstr "주민 여러분, 투표가 모두 끝났다면 제가 제 표를 던지고 개표를 시작하겠습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2980_CarusoDeath
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Serious
#. SoundFileID = 0022AE52
#. ScriptNotes = Serious / to Caruso_Headtrack_Death
#. DialogueBefore = Caruso: My soul and ship adrift, I crash landed on Shinar, a refugee.
#. DialogueAfter = Caruso: Tell me hunter, will it always?
#. EDID: [01027678]
#. REC: INFO:NAM1
msgctxt "00082F"
msgid "And now I return to Shinar, and the sky still weeps."
msgstr "그리고 이제 나는 시나르로 돌아왔고, 하늘은 아직도 울고 있군."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2980_CarusoDeath
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Serious
#. SoundFileID = 002C68EF
#. ScriptNotes = Serious / to Caruso_Headtrack_Death
#. DialogueBefore = Caruso: She died in a mutiny. It rained that night too.
#. DialogueAfter = Caruso: And now I return to Shinar, and the sky still weeps.
#. EDID: [0102768D]
#. REC: INFO:NAM1
msgctxt "000831"
msgid "My soul and ship adrift, I crash landed on Shinar, a refugee. "
msgstr "영혼도 배도 표류하던 나는 난민으로서 시나르에 불시착했습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2980_CarusoDeath
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Somber
#. SoundFileID = 00EBC1AE
#. ScriptNotes = He loved her / Somber / to Caruso_Headtrack_Death
#. DialogueBefore = Caruso: At twenty, I left Va'ruun'kai, and joined the Crimson Fleet.
#. DialogueAfter = Caruso: She died in a mutiny. It rained that night too.
#. EDID: [01027677]
#. REC: INFO:NAM1
msgctxt "000832"
msgid "There I met a pirate named Auraline. Raven hair. Deep, hazel eyes. "
msgstr "그곳에서 오럴라인이라는 해적을 만났지. 까마귀 같은 머리. 깊은 헤이즐색 눈."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2980_CarusoDeath
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Somber
#. SoundFileID = 00422311
#. ScriptNotes = Somber / to Caruso_Headtrack_Death
#. DialogueBefore = Caruso: There I met a pirate named Auraline. Raven hair. Deep, hazel eyes.
#. DialogueAfter = Caruso: My soul and ship adrift, I crash landed on Shinar, a refugee.
#. EDID: [01027689]
#. REC: INFO:NAM1
msgctxt "000833"
msgid "She died in a mutiny. It rained that night too."
msgstr "그녀는 반란 중에 죽었어. 그날 밤에도 비가 내렸지."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2980_CarusoDeath
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Serious
#. SoundFileID = 00AC72EB
#. ScriptNotes = Serious / to Caruso_Headtrack_Death
#. DialogueBefore = Caruso: At seven, I slew my groat, and fashioned a dagger from its bones.
#. DialogueAfter = Caruso: There I met a pirate named Auraline. Raven hair. Deep, hazel eyes.
#. EDID: [0102768A]
#. REC: INFO:NAM1
msgctxt "000834"
msgid "At twenty, I left Va'ruun'kai, and joined the Crimson Fleet."
msgstr "스무 살에 나는 바룬카이를 떠나 크림슨 함대에 들어갔습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2950_CarusoEnd_Greet
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 00A96082
#. DialogueBefore = Player Default: I will be honored to.
#. DialogueAfter = Caruso: And when my time comes, I will kneel before the ghosts of Shinar, and put my soul on the scales.
#. EDID: [01027684]
#. REC: INFO:NAM1
msgctxt "000836"
msgid "Then lead the way."
msgstr "그럼 앞장서."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2950_CarusoEnd_Greet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Caruso
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 005662C7
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Why Shinar? &&& Caruso: One, I don't want my execution or grave site to be a distraction to the people here.|And two, I would like to see it before I die. Stand face to face with the ghosts of Shinar, and deliver them their vengeance.
#. DialogueAfter = Caruso: Then lead the way.
#. EDID: [01027683]
#. REC: INFO:NAM1
msgctxt "000837"
msgid "We'll see when we get to Shinar."
msgstr "시나르에 가 보면 알겠지."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2950_CarusoEnd_Greet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Caruso
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00522059
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: It has. The vote says you're to die for your crimes. &&& Caruso: Then I have but one request. I would like you to take me to Shinar. &&& Caruso: Bury me there, amongst the others.
#. DialogueAfter = Player Default: What is easier is not my concern.
#. EDID: [0102767F]
#. REC: INFO:NAM1
msgctxt "000838"
msgid "A gun would be so much easier."
msgstr "총이면 훨씬 쉬울 텐데."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2980_CarusoDeath
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 00E857EF
#. ScriptNotes = / to Caruso_Headtrack_Death
#. DialogueAfter = Caruso: At seven, I slew my groat, and fashioned a dagger from its bones.
#. EDID: [0102768C]
#. REC: INFO:NAM1
msgctxt "000839"
msgid "I was told the sky wept for ten days when I was born."
msgstr "내가 태어났을 때 하늘이 열흘 동안 울었다고 들었습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_d3200_CarusoTL06
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 00395F52
#. EDID: [01027679]
#. REC: INFO:NAM1
msgctxt "00083A"
msgid "All these things are true."
msgstr "이 모든 것은 사실입니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_d3200_CarusoTL06
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 0068DD07
#. EDID: [01027679]
#. REC: INFO:NAM1
msgctxt "00083B"
msgid "But I am also the man who has given his blood and sweat to this outpost."
msgstr "하지만 저는 이 전초기지에 피와 땀을 바친 사람이기도 합니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_d3200_CarusoTL06
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 00BD62B0
#. EDID: [01027679]
#. REC: INFO:NAM1
msgctxt "00083C"
msgid "And I am the one who left Shinar to die."
msgstr "그리고 저는 시나르를 죽도록 내버려 둔 자입니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_d3200_CarusoTL06
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 0012BD66
#. EDID: [01027679]
#. REC: INFO:NAM1
msgctxt "00083D"
msgid "I am the spy who deserted House Va'ruun and the pirate who stole for the Crimson Fleet."
msgstr "저는 바룬 가문을 버린 첩자이자, 크림슨 함대를 위해 훔친 해적입니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_d3200_CarusoTL06
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 006F01BB
#. DialogueBefore = Player Default: Do you think you have changed since Shinar?
#. EDID: [01027679]
#. REC: INFO:NAM1
msgctxt "00083E"
msgid "Changed? A man does not change who he is."
msgstr "변했다고? 사람은 자신이 누구인지 바꾸지 못해."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2950_CarusoEnd_Greet
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 0040501B
#. ScriptNotes = / to Player Default
#. Prompt = A gun would be so much easier.
#. DialogueBefore = Player Default: A gun would be so much easier.
#. DialogueAfter = Caruso: I will be honored to.
#. EDID: [01027681]
#. REC: INFO:NAM1
msgctxt "00083F"
msgid "What is easier is not my concern."
msgstr "더 쉬운지는 내 관심사가 아니야."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2950_CarusoEnd_Greet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Caruso
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00CFF063
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: There are plenty of other places you can die. &&& Caruso: But no other place I see as fitting. If you grant me passage, I will do my best not be a burden.
#. DialogueAfter = Caruso: Then lead the way.
#. EDID: [0102767E]
#. REC: INFO:NAM1
msgctxt "000840"
msgid "I can do that."
msgstr "그렇게 할 수 있어."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_d3200_CarusoTL06
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0075954E
#. DialogueAfter = Caruso: Changed? A man does not change who he is.
#. EDID: [0102768B]
#. REC: INFO:NAM1
msgctxt "000841"
msgid "Do you think you have changed since Shinar?"
msgstr "시나르 이후로 당신은 변했다고 생각하십니까?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2950_CarusoEnd_Greet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00727DEB
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: All right. I can take you to Shinar. &&& Caruso: Thank you. I have one more request. I would like you to execute me with this.|It's a dagger I've owned since childhood, which I used to slay my first groat.
#. DialogueAfter = Caruso: Then lead the way.
#. EDID: [0102767C]
#. REC: INFO:NAM1
msgctxt "000842"
msgid "I will be honored to."
msgstr "영광으로 알겠습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2980_CarusoDeath
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 00F3262E
#. ScriptNotes = / to Caruso_Headtrack_Death
#. DialogueBefore = Caruso: And now I return to Shinar, and the sky still weeps.
#. EDID: [0102767B]
#. REC: INFO:NAM1
msgctxt "000843"
msgid "Tell me hunter, will it always?"
msgstr "말해 보세요, 사냥꾼. 언제까지나 그럴까요?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2535_TalkToResidents_TL_SunniKim
#. DialogCallType = NPCResponse
#. Speaker = SunniKim
#. VoiceType = SFFL_MS01_NPCFSunniKim
#. Face = Neutral
#. SoundFileID = 0085A2DB
#. ScriptNotes = / to Player Default
#. Prompt = That's it? I tell you he's a criminal and it's guillotine time?
#. DialogueBefore = Player Default: That's it? I tell you he's a criminal and it's guillotine time?
#. DialogueAfter = SunniKim: That's too humane. Give him cement shoes and throw him in the river.
#. EDID: [01027B6A]
#. REC: INFO:NAM1
msgctxt "000844"
msgid "Yep! Slice 'em and dice 'em!"
msgstr "그래! 썰고 또 썰어 버려!"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2980_CarusoDeath
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 00F901C0
#. ScriptNotes = / to Caruso_Headtrack_Death
#. DialogueBefore = Caruso: I was told the sky wept for ten days when I was born.
#. DialogueAfter = Caruso: At twenty, I left Va'ruun'kai, and joined the Crimson Fleet.
#. EDID: [0102767A]
#. REC: INFO:NAM1
msgctxt "000845"
msgid "At seven, I slew my groat, and fashioned a dagger from its bones."
msgstr "일곱 살 때 나는 내 그로트를 죽이고, 그 뼈로 단검을 만들었습니다."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2535_TalkToResidents_TL_SunniKim
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = SunniKim
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 002B9245
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Hal confessed to murder. There's going to be a vote on what to do with him. &&& SunniKim: A vote sounds amaze-balls. Think of the drama. &&& SunniKim: I gotta get Ivica to build us one of those old school guillotines.|We'll stick Hal's fat head inside and it'll be just *schwoop*!|Then we can all place bets on how far it'll roll.
#. DialogueAfter = Player Default: Yep! Slice 'em and dice 'em!
#. EDID: [01027B6F]
#. REC: INFO:NAM1
msgctxt "000846"
msgid "That's it? I tell you he's a criminal and it's guillotine time?"
msgstr "그게 다야? 내가 그자가 범죄자라고 말하니까 바로 단두대행이야?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2100_Yeats_Intro
#. DialogCallType = NPCResponse
#. Speaker = Yeats
#. VoiceType = SFFL_MS01_NPCMYeats
#. Face = Neutral
#. SoundFileID = 00E5DD53
#. ScriptNotes = / to Player Default
#. DialogueAfter = Yeats: Nor dread nor hope attend, A dying animal; A man awaits his end, Dreading and hoping all...
#. EDID: [01027B96]
#. REC: INFO:NAM1
msgctxt "000847"
msgid "I feel like the poet Neruda. A lonely house whose windows ache... for alcohol!"
msgstr "네루다 시인이 된 기분이야. 창문이 술을 그리워하며 아파하는 외로운 집!"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2100_Yeats_Intro
#. DialogCallType = NPCResponse
#. Speaker = Yeats
#. VoiceType = SFFL_MS01_NPCMYeats
#. Face = Sarcastic
#. SoundFileID = 00A136B3
#. ScriptNotes = Sarcastic / to Player Default
#. DialogueAfter = Yeats: Nor dread nor hope attend, A dying animal; A man awaits his end, Dreading and hoping all...
#. EDID: [01027B95]
#. REC: INFO:NAM1
msgctxt "000848"
msgid "What I wouldn't do for a drink. I'd kill a man, or three. I'm already in prison, what's the harm?"
msgstr "술 한잔만 할 수 있다면 뭐든 하겠어. 사람 하나, 아니 셋쯤 죽일 수도 있지. 어차피 감옥인데 뭐가 문제야?"

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_c2100_Yeats_Intro
#. DialogCallType = NPCResponse
#. Speaker = Yeats
#. VoiceType = SFFL_MS01_NPCMYeats
#. Face = Neutral
#. SoundFileID = 000E2771
#. ScriptNotes = / to Player Default
#. DialogueAfter = Yeats: Nor dread nor hope attend, A dying animal; A man awaits his end, Dreading and hoping all...
#. EDID: [01027B7E]
#. REC: INFO:NAM1
msgctxt "000849"
msgid "These days I don't preach much. I mostly just cry. Like a baby."
msgstr "요즘은 설교를 별로 안 해. 대부분 그냥 울어. 아기처럼."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_b1000_IvicaGreet
#. DialogCallType = NPCResponse
#. Speaker = NPCMIvicaVukovic
#. VoiceType = SFFL_MS01_NPCMIvicaVukovic
#. Face = Neutral
#. SoundFileID = 00AE9E88
#. ScriptNotes = / to Player Default
#. Prompt = I'll do it.
#. DialogueBefore = Player Default: I'll do it.
#. DialogueAfter = Ivica: You'll need a power cell to turn it on. Here, this should do the trick.
#. EDID: [01027B64]
#. REC: INFO:NAM1
msgctxt "00084A"
msgid "Good. Blasted machines are bad for business."
msgstr "좋아. 망할 기계들은 장사에 방해만 돼."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_140_Caruso_Greet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Caruso
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00DDCCE4
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: I trust you have a proposition, then. &&& Caruso: I do. &&& Caruso: My terms are as follows. In exchange for my submission, I would like you to help me resolve some pressing issues here. &&& Caruso: When that work is done, I will turn myself in, or end my life. Whatever the people decide.
#. DialogueAfter = Player Default: Fine. But perhaps if you hear what I have to say, you'll still agree to help.
#. EDID: [01027B69]
#. REC: INFO:NAM1
msgctxt "00084B"
msgid "I don't care. Do what you want."
msgstr "상관없어. 마음대로 해."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_140_Caruso_Greet
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 00CA1BFA
#. ScriptNotes = / to Player Default
#. Prompt = I don't care. Do what you want.
#. DialogueBefore = Player Default: I don't care. Do what you want.
#. DialogueAfter = Caruso: When I arrived here, I found a place in dire straits.
#. EDID: [01027B6B]
#. REC: INFO:NAM1
msgctxt "00084C"
msgid "Fine. But perhaps if you hear what I have to say, you'll still agree to help."
msgstr "좋아. 하지만 내 말을 들어 보면 그래도 도와주겠다고 할지도 모르지."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_b1000_IvicaGreet
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 009B422B
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: [Lie] I can do that. Just tell me how. &&& Ivica: One word: Magnets. The robot likes to go to the junkyard, and dig for spare parts.|If you turn on the magnet while it's searching, it'll scramble its egg.
#. DialogueAfter = Player Default: Good. Blasted machines are bad for business.
#. EDID: [01027B67]
#. REC: INFO:NAM1
msgctxt "00084D"
msgid "I'll do it."
msgstr "내가 할게."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2980_CarusoExile
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 00129D1B
#. EDID: [01027BBA]
#. REC: INFO:NAM1
msgctxt "00084E"
msgid "I hope that I can someday return the favor. Until then, I wish you safe journeys."
msgstr "언젠가 이 은혜를 갚을 수 있기를 바랍니다. 그때까지 안전하게 여행하세요."

#. List: 2
#. QuestName = SFFL_MS01_Quest
#. SceneName = SFFL_MS01_Quest_e2980_CarusoExile
#. DialogCallType = NPCResponse
#. Speaker = Caruso
#. VoiceType = SFFL_MS01_NPCMHalCaruso
#. Face = Neutral
#. SoundFileID = 0058CA87
#. DialogueBefore = Caruso: It will not be luck, but toil.
#. EDID: [01027BBA]
#. REC: INFO:NAM1
msgctxt "00084F"
msgid "Before we part, I want to say this. I am grateful for all that you've done. For New Babylon, and for me. "
msgstr "헤어지기 전에 이 말은 하고 싶습니다. 지금까지 해 주신 일에 감사드립니다. 뉴바빌론을 위해서, 저를 위해서 해주신 일요. "

