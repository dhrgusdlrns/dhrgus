#. VoiceType = SFFL_NPCFAtka
#. Face = Nervous
#. SoundFileID = 0087558F
#. ScriptNotes = Nervous / to Player Default
#. Prompt = I think I should get paid.
#. DialogueBefore = Player Default: I think I should get paid.
#. EDID: [0105A35D]
#. REC: INFO:NAM1
msgctxt "002136"
msgid "Here. Take it. Now please, just leave us alone."
msgstr "여기. 받아. 이제 제발 우릴 내버려 둬."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_BranchEndRomanDeadScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0082F444
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Roman and his friends are dead. &&& Yura: Oh my god... you killed him? All of them? &&& Atka: Look... I... I think you should leave.
#. DialogueAfter = Player Default: Here. Take it. Now please, just leave us alone.
#. EDID: [0105A357]
#. REC: INFO:NAM1
msgctxt "002137"
msgid "I think I should get paid."
msgstr "보수를 받아야겠는데."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_BranchEndRomanDeadScene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Relieved
#. SoundFileID = 00796292
#. ScriptNotes = Relieved / to Player Default
#. Prompt = Nothing. Never mind.
#. DialogueBefore = Player Default: Nothing. Never mind.
#. DialogueAfter = Atka: Okay, great, so this was all some elaborate scheme for Roman to catch my sister's attention.
#. EDID: [0105A341]
#. REC: INFO:NAM1
msgctxt "002138"
msgid "God, don't scare me like that."
msgstr "깜짝이야. 사람 놀라게 하지 마."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_BranchEndRomanDeadScene
#. DialogCallType = NPCResponse
#. Speaker = Atka
#. VoiceType = SFFL_NPCFAtka
#. Face = Worried
#. SoundFileID = 00519A09
#. ScriptNotes = Worried / to Player Default
#. DialogueBefore = Player Default: Roman and his friends are dead. &&& Yura: Oh my god... you killed him? All of them?
#. DialogueAfter = Player Default: I think I should get paid.
#. EDID: [0105A335]
#. REC: INFO:NAM1
msgctxt "002139"
msgid "Look... I... I think you should leave."
msgstr "저기... 난... 넌 나가줘야겠어."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_BranchEndRomanDeadScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Yura
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00F4D68E
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Roman's not thinking anything anymore. &&& Yura: Hold up. What's that supposed to mean?
#. DialogueAfter = Yura: Oh my god... you killed him? All of them?
#. EDID: [0105A361]
#. REC: INFO:NAM1
msgctxt "00213A"
msgid "Petnappers don't deserve to live."
msgstr "애완동물 납치범은 살아 있을 자격이 없어."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_BranchEndRomanScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Atka
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00B9A099
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Roman likes you, Yura. He's just not sure how to tell you. &&& ... &&& Atka: That still doesn't justify what you did, Yura. &&& Yura: Oh come on, Milli is fine. Everything is fine! &&& Yura: Help me out here.
#. DialogueAfter = Player Default: I'm really sorry you got sucked into all this.
#. EDID: [0105A365]
#. REC: INFO:NAM1
msgctxt "00213B"
msgid "I'm staying out of this."
msgstr "난 이 일에서 빠질래."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_BranchEndRomanScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Atka
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 003DB20B
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Roman likes you, Yura. He's just not sure how to tell you. &&& ... &&& Atka: That still doesn't justify what you did, Yura. &&& Yura: Oh come on, Milli is fine. Everything is fine! &&& Yura: Help me out here.
#. DialogueAfter = Player Default: I agree completely.
#. EDID: [0105A35A]
#. REC: INFO:NAM1
msgctxt "00213C"
msgid "This seems like something you two need to work out on your own."
msgstr "이건 너희 둘이 직접 풀어야 할 일 같아."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_BranchEndRomanScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00FB96FF
#. ScriptNotes = / to Player Default
#. DialogueBefore = Atka: What do you mean "the pet sitter" has Milli? You were supposed to be taking care of her. &&& Yura: And I am! Hiring another pet sitter is taking care of her. &&& Yura: And look, just in time. &&& Yura: How was Roman involved in all this stuff again?
#. DialogueAfter = Player Default: Ransom? Why would he even do that?
#. EDID: [0105A351]
#. REC: INFO:NAM1
msgctxt "00213D"
msgid "Roman took Milli and was holding her for ransom."
msgstr "로만이 밀리를 데려갔고 몸값을 요구했어."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_MainEndScene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Irritated
#. SoundFileID = 009F67F1
#. ScriptNotes = Irritated / to Player Default
#. Prompt = I think your sister is trying to get your attention.
#. DialogueBefore = Player Default: I think your sister is trying to get your attention.
#. DialogueAfter = Atka: Excuse me, Yura. Are you going to tell me who these people are or what?
#. EDID: [0105A35B]
#. REC: INFO:NAM1
msgctxt "00213E"
msgid "Don't try to change the subject on me."
msgstr "내 앞에서 말 돌리려 하지 마."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_BranchEndRomanScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Atka
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00BA2E0E
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Roman took Milli and was holding her for ransom. &&& ... &&& Atka: I'm sorry. Who are you? And are you saying Roman stole Milli while I was gone? &&& Yura: Atka, this is the pet sitter I was telling you about.|And as you can see, Milli is fine! &&& Atka: Fine? She was stolen right out of our home! She could be traumatized. |What was Roman even thinking?
#. DialogueAfter = Yura: Hold up. What's that supposed to mean?
#. EDID: [0105B430]
#. REC: INFO:NAM1
msgctxt "00213F"
msgid "Roman's not thinking anything anymore."
msgstr "로만은 이제 더 이상 아무 생각도 하지 못해."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_YuraScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Roman
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00785907
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Can you tell me more about Yura? &&& Roman: Yura's great. She's like that person that makes you feel better just knowing they're around.|She always knows what to say, too. I just wish she knew how cool she really is.|I tell her all the time, but when it comes to taking compliments, she hates it.
#. DialogueAfter = Player Default: Depends if she wants to do it or not. If she's responsible for a ship load of cargo, she's as responsible as they come.
#. EDID: [0105BF90]
#. REC: INFO:NAM1
msgctxt "002140"
msgid "Is she always pawning off responsibilities on other people?"
msgstr "유라는 늘 책임을 남에게 떠넘겨?"

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_YuraScene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Depressed
#. SoundFileID = 0081DA2B
#. ScriptNotes = Depressed / to Player Default
#. Prompt = Why are you so afraid to tell her how you feel?
#. DialogueAfter = Roman: Why does she have difficulty with compliments?
#. EDID: [0105BF9D]
#. REC: INFO:NAM1
msgctxt "002141"
msgid "Every time I work up the courage, she seems to sense it and pushes me away."
msgstr "내가 용기를 낼 때마다, 유라는 그걸 눈치채고 선을 그으려는 것 같아."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_YuraScene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Concerned
#. SoundFileID = 005243C0
#. ScriptNotes = Concerned / to Player Default
#. Prompt = Why are you so afraid to tell her how you feel?
#. EDID: [0105BF9D]
#. REC: INFO:NAM1
msgctxt "002142"
msgid "But I'm afraid that even if she likes me, too, she'll still say no because she thinks she doesn't deserve to be happy."
msgstr "근데 유라가 날 좋아한다 쳐도, 자기가 행복해질 자격이 없다고 생각해서 거절할까 봐 두려워."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_YuraScene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Nervous
#. SoundFileID = 00383005
#. ScriptNotes = Nervous / to Player Default
#. Prompt = Why are you so afraid to tell her how you feel?
#. DialogueBefore = Player Default: Why are you so afraid to tell her how you feel?
#. EDID: [0105BF9D]
#. REC: INFO:NAM1
msgctxt "002143"
msgid "Well, rejection for one. I don't want to ruin the friendship we already have."
msgstr "우선 거절당하는 게 무섭지. 지금의 우정을 망치고 싶지 않아."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_YuraScene
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Irritated
#. SoundFileID = 00E76EA9
#. ScriptNotes = Irritated / to Player Default
#. Prompt = Why does she have difficulty with compliments?
#. DialogueAfter = Roman: Why does she have difficulty with compliments?
#. EDID: [0105BF8E]
#. REC: INFO:NAM1
msgctxt "002144"
msgid "If they were still alive, I'd give them a piece of my mind."
msgstr "그들이 아직 살아 있었다면, 내가 한마디 제대로 해 줬을 거야."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_YuraScene
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Nervous
#. SoundFileID = 005F6CFA
#. ScriptNotes = Nervous / to Player Default
#. Prompt = Why does she have difficulty with compliments?
#. EDID: [0105BF8E]
#. REC: INFO:NAM1
msgctxt "002145"
msgid "She's not successful like Atka, and I think her parents made her out to be some sort of failure."
msgstr "아트카만큼 잘나가지 못한다고 해서, 부모란 사람들이 유라를 무슨 실패자 취급하며 키운 모양이더라고."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_YuraScene
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Nervous
#. SoundFileID = 00DB1CA5
#. ScriptNotes = Nervous / to Player Default
#. Prompt = Why does she have difficulty with compliments?
#. DialogueBefore = Player Default: Why does she have difficulty with compliments?
#. EDID: [0105BF8E]
#. REC: INFO:NAM1
msgctxt "002146"
msgid "Yura acts like nothing can hurt her, but she really doesn't think too highly of herself. "
msgstr "유라는 아무것도 자길 상처 입힐 수 없는 것처럼 굴지만, 사실 자존감이 높지 않아."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_YuraScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 004FDBD6
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Can you tell me more about Yura? &&& Roman: Yura's great. She's like that person that makes you feel better just knowing they're around.|She always knows what to say, too. I just wish she knew how cool she really is.|I tell her all the time, but when it comes to taking compliments, she hates it.
#. DialogueAfter = Player Default: Yura acts like nothing can hurt her, but she really doesn't think too highly of herself.
#. EDID: [0105BF7F]
#. REC: INFO:NAM1
msgctxt "002147"
msgid "Why does she have difficulty with compliments?"
msgstr "왜 칭찬받는 걸 싫어해?"

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_YuraScene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Nervous
#. SoundFileID = 004D5A70
#. ScriptNotes = Nervous / to Player Default
#. DialogueAfter = Player Default: Why does she have difficulty with compliments?
#. EDID: [0105BF6F]
#. REC: INFO:NAM1
msgctxt "002148"
msgid "I tell her all the time, but when it comes to taking compliments, she hates it."
msgstr "늘 유라에게 칭찬을 하는데, 그럴 때마다 아주 몸서리를 쳐."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_YuraScene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Friendly
#. SoundFileID = 00F35C72
#. ScriptNotes = Friendly / to Player Default
#. EDID: [0105BF6F]
#. REC: INFO:NAM1
msgctxt "002149"
msgid "She always knows what to say, too. I just wish she knew how cool she really is."
msgstr "게다가 어느 때에 어떤 말을 해야 하는지 잘 알아. 자신이 얼마나 멋진지도 알았으면 좋겠어."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_YuraScene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Nervous
#. SoundFileID = 0070DDC1
#. ScriptNotes = Nervous / to Player Default
#. DialogueBefore = Player Default: Can you tell me more about Yura?
#. EDID: [0105BF6F]
#. REC: INFO:NAM1
msgctxt "00214A"
msgid "Yura's great. She's like that person that makes you feel better just knowing they're around."
msgstr "유라는 멋져. 곁에 있는 것만으로도 기분이 좋아지는 그런 사람이야."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_PetnappingScene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Nervous
#. SoundFileID = 0036FF2A
#. ScriptNotes = millies short for "milliwhales" / Nervous / to Player Default
#. EDID: [0105BF94]
#. REC: INFO:NAM1
msgctxt "00214B"
msgid "Plus Milli makes sense for a ransom. Most millies are easy to come by, but Milli's a rarity."
msgstr "게다가 몸값을 요구하기엔 밀리가 딱이었어. 밀리고래야 흔하지만, 그 중에서도 밀리는 희귀하거든."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_PetnappingScene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Amused
#. SoundFileID = 00E2C8FE
#. ScriptNotes = Amused / to Player Default
#. EDID: [0105BF94]
#. REC: INFO:NAM1
msgctxt "00214C"
msgid "We could've emptied the place out, but that would've been too much work."
msgstr "집을 싹 털 수도 있었지만, 그건 일이 너무 많았을 거야."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1300_Roman_TL_PetnappingScene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Nervous
#. SoundFileID = 000BFC8E
#. ScriptNotes = Nervous / to Player Default
#. DialogueBefore = Player Default: Of all things to impress someone, why involve Milli?
#. EDID: [0105BF94]
#. REC: INFO:NAM1
msgctxt "00214D"
msgid "Milli was the key. She's the only thing we could've taken that would've gotten Yura's attention in the first place."
msgstr "핵심은 밀리였어. 우리가 가져갈 수 있는 것 중 유라의 관심을 끌 만한 건 처음부터 밀리뿐이었지."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_StarbornScene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Thinking
#. SoundFileID = 000F08C1
#. ScriptNotes = Thinking / to Player Default
#. Prompt = It's beyond your comprehension. Just take the deal.
#. DialogueAfter = Roman: You've got yourself a deal. Here's the key to Milli's room.
#. EDID: [0105C9CA]
#. REC: INFO:NAM1
msgctxt "00214E"
msgid "I guess if you're smart enough to know what's going on, you know what you're doing."
msgstr "무슨 일이 벌어지는지 알 만큼 똑똑하다면, 알아서 잘하고 있는 거겠지."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_StarbornScene
#. DialogCallType = NPCResponse
#. Speaker = Roman
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Worried
#. SoundFileID = 00A590F0
#. ScriptNotes = Worried / to Player Default
#. Prompt = It's beyond your comprehension. Just take the deal.
#. DialogueBefore = Player Default: It's beyond your comprehension. Just take the deal.
#. EDID: [0105C9CA]
#. REC: INFO:NAM1
msgctxt "00214F"
msgid "Obviously, it's beyond my... whatever. "
msgstr "분명 내... 뭐, 아무튼 내가 이해할 수준은 아니야."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_StarbornScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Roman
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00891933
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Give me Milli and I'll put in a good word for you with Yura. &&& Roman: Whoa, what? Who are you? How would you even know anything about that?
#. DialogueAfter = Player Default: Okay, whoa, in that case, I don't have to know.
#. EDID: [0105C9CB]
#. REC: INFO:NAM1
msgctxt "002150"
msgid "If I told you, I'd have to kill you. "
msgstr "말해 주면 널 죽여야 해."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_MainEndScene
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCFSarahMorgan
#. Face = Confident
#. SoundFileID = 0037E4D1
#. ScriptNotes = Confident / to Atka
#. DialogueBefore = Player Default: I don't see how the timing is my fault. &&& ... &&& Yura: You'll be happy to know, they were just taking Milli for a walk. &&& Yura: And see? Milli's fine! &&& Yura: Right, "pet sitters"?
#. DialogueAfter = Player Default: As a Freestar Ranger, I personally looked after Milli's safety.
#. EDID: [0106B1F5]
#. REC: INFO:NAM1
msgctxt "002151"
msgid "I assure you, Milli's received only the utmost care."
msgstr "장담하는데, 최고로 정성을 들여서 밀리를 돌봤다고."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_MainEndScene
#. DialogCallType = NPCResponse
#. Speaker = companion
#. VoiceType = NPCFAndreja
#. Face = Confident
#. SoundFileID = 00CCDFB7
#. ScriptNotes = Confident / to Atka
#. DialogueBefore = Player Default: I don't see how the timing is my fault. &&& ... &&& Yura: You'll be happy to know, they were just taking Milli for a walk. &&& Yura: And see? Milli's fine! &&& Yura: Right, "pet sitters"?
#. DialogueAfter = Player Default: As a Freestar Ranger, I personally looked after Milli's safety.
#. EDID: [0106B1F2]
#. REC: INFO:NAM1
msgctxt "002152"
msgid "We guarded this creature with our very lives."
msgstr "우리가 목숨을 걸고 이 동물을 지켰지."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_1200_Roman_MainBranchYura01Scene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Roman
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00529D7D
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: I don't do favors for petnappers. &&& Roman: Just hear me out. You got this petnapping thing all wrong.|You see, this is all a setup for Yura. &&& Roman: She hates house sitting. It's boring. So we thought why not liven things up?|We figured she'd get into it, maybe even get the credits from Atka...|And then when all went according to plan, I'd have the confidence to ask her out. |But now I've lost that chance. So, plan B. I give you Milli, you put in a good word for me with Yura. &&& companion: All this setup when you should be confessing to her directly.
#. DialogueAfter = Player Default: Oh yeah, well if I recall, you don't have the credits.
#. EDID: [01084FE6]
#. REC: INFO:NAM1
msgctxt "002153"
msgid "No way, I'm not getting involved in this."
msgstr "절대 안 돼. 난 이 일에 안 끼어들어."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale / NPCFGenericFemale
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Confident
#. SoundFileID = 009894B3
#. ScriptNotes = Player told Roman that Yura is going to think about it. / Confident
#. EDID: [0106B1E4]
#. REC: INFO:NAM1
msgctxt "002158"
msgid "Thanks for helping out Roman."
msgstr "로만을 도와줘서 고마워."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCMGenericMale / NPCFGenericFemale
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Neutral
#. SoundFileID = 002BB733
#. ScriptNotes = Player told Roman that Yura said no. / Neutral
#. EDID: [0106B1E0]
#. REC: INFO:NAM1
msgctxt "002159"
msgid "Those two are never gonna get it together."
msgstr "저 둘은 절대 잘 안될걸."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Nervous
#. SoundFileID = 00F54776
#. ScriptNotes = Player has returned after putting in a good word for him with Yura. / Nervous
#. EDID: [0106B1C9]
#. REC: INFO:NAM1
msgctxt "00215A"
msgid "I'm almost afraid to ask. "
msgstr "물어보기도 겁나네. "

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Grateful
#. SoundFileID = 007AFB48
#. ScriptNotes = Grateful
#. EDID: [0105CF0E]
#. REC: INFO:NAM1
msgctxt "00215B"
msgid "Yura told me you convinced her to give me a shot. I owe you."
msgstr "유라 말로는, 네가 날 한 번 믿어 보라고 설득했다면서? 신세 졌네."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Grateful
#. SoundFileID = 00CB0925
#. ScriptNotes = Grateful
#. EDID: [0105CF0D]
#. REC: INFO:NAM1
msgctxt "00215C"
msgid "Thanks for talking to Yura. These past few days have been the best of my life."
msgstr "유라와 얘기해 줘서 고마워. 지난 며칠은 내 인생 최고의 시간이었어."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Grateful
#. SoundFileID = 00ABB2A9
#. ScriptNotes = Player used the Freestar Collective option to get Milli back, so he knows they are a ranger. / Grateful
#. EDID: SFFL_MS03_Support_PostQuestRoman03_Shared
#. REC: INFO:NAM1
msgctxt "00215D"
msgid "Thanks again for letting us off the hook."
msgstr "이번 일 눈 감아 준거 정말 고마워."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Nervous
#. SoundFileID = 00D26AFE
#. ScriptNotes = Player used the Freestar Collective option to get Milli back, so he knows they are a ranger. / Nervous
#. EDID: SFFL_MS03_Support_PostQuestRoman02_Shared
#. REC: INFO:NAM1
msgctxt "00215E"
msgid "Just another law-abiding citizen."
msgstr "그저 평범한 준법 시민이라고."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFYura
#. VoiceType = SFFL_NPCFYura
#. Face = Grateful
#. SoundFileID = 00905C49
#. ScriptNotes = Grateful
#. EDID: [0105CEFF]
#. REC: INFO:NAM1
msgctxt "00215F"
msgid "Thanks for all of your advice. You were right, and I've never been so happy."
msgstr "조언해 줘서 고마워. 네 말이 맞았고, 이렇게 행복했던 적은 없어."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFYura
#. VoiceType = SFFL_NPCFYura
#. Face = Sad
#. SoundFileID = 008EC9FB
#. ScriptNotes = Just learned the player killed her best friend. Sad, upset, angry. / Sad
#. EDID: [0105BFD3]
#. REC: INFO:NAM1
msgctxt "002160"
msgid "Just get out of here."
msgstr "그냥 여기서 나가."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFYura
#. VoiceType = SFFL_NPCFYura
#. Face = Friendly
#. SoundFileID = 0004497A
#. ScriptNotes = Friendly
#. EDID: [0105BFCE]
#. REC: INFO:NAM1
msgctxt "002161"
msgid "I told you it'd be easy credits."
msgstr "쉽게 버는 크레딧이라고 했잖아."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFYura
#. VoiceType = SFFL_NPCFYura
#. Face = Irritated
#. SoundFileID = 0096C44A
#. ScriptNotes = Irritated
#. EDID: [0105BFCD]
#. REC: INFO:NAM1
msgctxt "002162"
msgid "I guess Atka's gonna be mad at me for a while, but she'll get over it."
msgstr "아트카가 한동안 나한테 화내겠지만, 결국 풀리겠지."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFAtka
#. VoiceType = SFFL_NPCFAtka
#. Face = Depressed
#. SoundFileID = 0065AA4B
#. ScriptNotes = Depressed
#. EDID: [0105BFC6]
#. REC: INFO:NAM1
msgctxt "002163"
msgid "Roman didn't deserve to die. He was a good person."
msgstr "로만은 죽어 마땅한 녀석이 아니었어. 좋은 애였는데."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFAtka
#. VoiceType = SFFL_NPCFAtka
#. Face = Serious
#. SoundFileID = 00E86A66
#. ScriptNotes = Serious
#. EDID: [0105BFC5]
#. REC: INFO:NAM1
msgctxt "002164"
msgid "I'm sorry you had to be involved in all this, but I think we need some space."
msgstr "이 일에 휘말리게 해서 미안하지만, 우리에겐 시간이 좀 필요해."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFAtka
#. VoiceType = SFFL_NPCFAtka
#. Face = Impressed
#. SoundFileID = 00884F56
#. ScriptNotes = Impressed
#. EDID: [0105BFBC]
#. REC: INFO:NAM1
msgctxt "002165"
msgid "This is the first time I returned home to find all my plants alive and well."
msgstr "집에 돌아와서 내 식물들이 전부 멀쩡히 살아 있는 걸 본 건 처음이야."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Nervous
#. SoundFileID = 001DC69B
#. ScriptNotes = Nervous
#. EDID: [0105CEE8]
#. REC: INFO:NAM1
msgctxt "002166"
msgid "Remember to take care of Milli."
msgstr "밀리 돌보는 거 잊지 마."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Smug
#. SoundFileID = 0005C31E
#. ScriptNotes = Player just paid him 100k credits. / Smug
#. EDID: [0105CEEA]
#. REC: INFO:NAM1
msgctxt "002167"
msgid "Until next time."
msgstr "다음에 보자."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFAtka
#. VoiceType = SFFL_NPCFAtka
#. Face = Friendly
#. SoundFileID = 0006653D
#. ScriptNotes = Friendly
#. EDID: [0105CEE1]
#. REC: INFO:NAM1
msgctxt "002168"
msgid "Take care."
msgstr "몸조심해."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFAtka
#. VoiceType = SFFL_NPCFAtka
#. Face = Friendly
#. SoundFileID = 00DEB007
#. ScriptNotes = Friendly
#. EDID: [0105CEE0]
#. REC: INFO:NAM1
msgctxt "002169"
msgid "Stay safe."
msgstr "조심해."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFYura
#. VoiceType = SFFL_NPCFYura
#. Face = Friendly
#. SoundFileID = 0056CABA
#. ScriptNotes = Friendly
#. EDID: [0105CEDC]
#. REC: INFO:NAM1
msgctxt "00216A"
msgid "Catch ya later."
msgstr "나중에 봐."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCMRomanKreutz
#. VoiceType = SFFL_NPCMRomanKreutz
#. Face = Irritated
#. SoundFileID = 00687077
#. ScriptNotes = Player hasn't spoken for a while. / Irritated
#. EDID: [0105CF16]
#. REC: INFO:NAM1
msgctxt "00216B"
msgid "Come on... I don't have all day."
msgstr "어서... 하루 종일 기다릴 순 없어."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFYura
#. VoiceType = SFFL_NPCFYura
#. Face = Confused
#. SoundFileID = 009E8DDC
#. ScriptNotes = Player hasn't spoken for a while. / Confused
#. EDID: [0105CF13]
#. REC: INFO:NAM1
msgctxt "00216C"
msgid "Anybody home?"
msgstr "누구 있어?"

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman01Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Confident
#. SoundFileID = 00776DCF
#. ScriptNotes = Confident / to Player Default
#. Prompt = I get that. Relationships aren't for everyone.
#. DialogueAfter = Player Default: But if you never try, you could lose him, and the regret would be worse.
#. EDID: SFFL_MS03_Yura_RelationshipResponse01
#. REC: INFO:NAM1
msgctxt "00216D"
msgid "Until then, it's better this way."
msgstr "그때까지는 이 상태가 나아."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman01Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Concerned
#. SoundFileID = 000BD899
#. ScriptNotes = Concerned / to Player Default
#. Prompt = I get that. Relationships aren't for everyone.
#. DialogueBefore = Player Default: I get that. Relationships aren't for everyone.
#. EDID: SFFL_MS03_Yura_RelationshipResponse01
#. REC: INFO:NAM1
msgctxt "00216E"
msgid "I only hope Roman understands. I keep saying I'm going to get it together, but who knows when that'll be. "
msgstr "로만이 이해해 줬으면 좋겠어. 정리하겠다고 계속 말은 하는데, 그게 언제가 될지는 모르겠어. "

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFAtka
#. VoiceType = SFFL_NPCFAtka
#. Face = Confused
#. SoundFileID = 00C5FB06
#. ScriptNotes = Yelling at the player in combat. Confused panic. / Confused
#. EDID: [0106D5B7]
#. REC: INFO:NAM1
msgctxt "00216F"
msgid "Why are you doing this?"
msgstr "왜 이러는 거야?"

#. List: 2
#. QuestName = SFFL_MS03_Support
#. DialogCallType = NPCResponse
#. Speaker = NPCFYura
#. VoiceType = SFFL_NPCFYura
#. Face = Angry
#. SoundFileID = 00E3B3BB
#. ScriptNotes = Taunt. / Angry
#. EDID: [0106D5B6]
#. REC: INFO:NAM1
msgctxt "002170"
msgid "Never should've trusted you!"
msgstr "널 믿지 말았어야 했어!"

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_MS03DoneScene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Amused
#. SoundFileID = 00289F67
#. ScriptNotes = Amused / to Atka
#. DialogueBefore = Yura: A little extra? I knew you were holding out on me. &&& Atka: Please, first of all, you're family, and second of all, you don't even deserve half of what I offered you.|I swear, Yura, you're so irresponsible, I can't believe we're related.
#. EDID: [010358C1]
#. REC: INFO:NAM1
msgctxt "002171"
msgid "Hey, you aren't the only one! "
msgstr "야, 안 믿기는 건 나도 그렇거든! "

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_MS03DoneScene
#. DialogCallType = NPCResponse
#. Speaker = Atka
#. VoiceType = SFFL_NPCFAtka
#. Face = Irritated
#. SoundFileID = 0036CD73
#. ScriptNotes = Irritated / to Yura
#. DialogueAfter = Yura: Hey, you aren't the only one!
#. EDID: [010358B5]
#. REC: INFO:NAM1
msgctxt "002172"
msgid "I swear, Yura, you're so irresponsible, I can't believe we're related."
msgstr "정말이지, 유라, 넌 너무 무책임해. 우리가 자매라는 게 안 믿긴다니까."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_MS03DoneScene
#. DialogCallType = NPCResponse
#. Speaker = Atka
#. VoiceType = SFFL_NPCFAtka
#. Face = Irritated
#. SoundFileID = 00CEDAE5
#. ScriptNotes = Irritated / to Yura
#. DialogueBefore = Yura: A little extra? I knew you were holding out on me.
#. EDID: [010358B5]
#. REC: INFO:NAM1
msgctxt "002173"
msgid "Please, first of all, you're family, and second of all, you don't even deserve half of what I offered you."
msgstr "꿈 깨. 첫째로 우린 가족이고, 둘째로 넌 일당의 절반도 받을 자격 없어."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman01Scene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Yura
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 009BF4B0
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: I get that. Relationships aren't for everyone. &&& Yura: I only hope Roman understands. I keep saying I'm going to get it together, but who knows when that'll be. |Until then, it's better this way.
#. DialogueAfter = Player Default: Don't you think I've thought of that?
#. EDID: [0105BF6E]
#. REC: INFO:NAM1
msgctxt "002174"
msgid "But if you never try, you could lose him, and the regret would be worse."
msgstr "하지만 시도조차 안 하면 로만을 잃을 수도 있어. 크게 후회하게 될 거야."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman01Scene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 002D04FB
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: He really likes you, Yura. Give him a chance. &&& Yura: Give him a chance so I can screw it all up? |Roman's great, really, but the moment you start dating someone, that means you start letting them in and I really suck at that.
#. DialogueAfter = Player Default: You know... you're right. Roman's seen me at my worst and still hasn't given up on me.
#. EDID: [0105BF91]
#. REC: INFO:NAM1
msgctxt "002175"
msgid "I know how you feel, but I also know you can work past that together."
msgstr "네 마음은 알아. 하지만 너희라면 함께 극복할 수 있을 거야."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman01Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Smirk
#. SoundFileID = 004320E0
#. ScriptNotes = Smirk / to Player Default
#. Prompt = I have a feeling you wouldn't disappoint Roman.
#. DialogueBefore = Player Default: I have a feeling you wouldn't disappoint Roman.
#. DialogueAfter = Yura: I guess I have a lot to think about thanks to you.
#. EDID: [0105BF99]
#. REC: INFO:NAM1
msgctxt "002176"
msgid "Well sure, not right now. But give it time."
msgstr "뭐 그럴지도. 어쨌든 지금 당장은 아냐. 시간을 두고 지켜볼게."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman01Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Thinking
#. SoundFileID = 008B36EA
#. ScriptNotes = Thinking / to Player Default
#. Prompt = What makes you think you aren't relationship material?
#. DialogueBefore = Player Default: What makes you think you aren't relationship material?
#. DialogueAfter = Yura: He really likes you, Yura. Give him a chance.
#. EDID: [0105BF74]
#. REC: INFO:NAM1
msgctxt "002177"
msgid "Let's just say I've got some issues that don't let me make the best decisions and leave it at that. "
msgstr "내가 좀 문제가 있어서 매번 바보 같은 선택만 골라 하거든. 그러니까 그냥 그런가 보다 하고 더는 묻지 말아 줘. "

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman01Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Grateful
#. SoundFileID = 00819241
#. ScriptNotes = Grateful / to Player Default
#. DialogueBefore = Yura: Roman's the best.
#. DialogueAfter = Yura: I really wish I deserved someone like him, but I'm just not relationship material. Not right now.
#. EDID: [0105BF76]
#. REC: INFO:NAM1
msgctxt "002178"
msgid "I can't believe he did all this for me. "
msgstr "로만이 날 위해 그런 일을 해줬다니 믿기지 않아. "

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_AtkaScene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Confident
#. SoundFileID = 0077992B
#. ScriptNotes = Confident / to Player Default
#. DialogueAfter = Player Default: Steady jobs suck. Freelance all the way.
#. EDID: [0105C373]
#. REC: INFO:NAM1
msgctxt "002179"
msgid "I think she got it from our parents who couldn't handle the fact that I never went to college or bothered with a steady job."
msgstr "내가 대학에도 안 가고 안정적인 직장도 구하지 않은 걸 받아들이지 못한 우리 부모님에게서 그런 생각을 물려받은 것 같아."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_AtkaScene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Confident
#. SoundFileID = 00589F18
#. ScriptNotes = Confident / to Player Default
#. DialogueBefore = Player Default: So what's the deal with you and Atka?
#. EDID: [0105C373]
#. REC: INFO:NAM1
msgctxt "00217A"
msgid "Atka's always trying to get me to do stuff so she can \"teach me responsibility.\" "
msgstr "아트카는 늘 나한테 뭔가를 시켜서 \"책임감\"을 가르치려 해."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman03Scene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00CFFDD3
#. ScriptNotes = / to Yura
#. DialogueAfter = Yura: Roman's the best. He always knows what to say to keep me sane.
#. EDID: [0105CF0F]
#. REC: INFO:NAM1
msgctxt "00217B"
msgid "What can you tell me about Roman?"
msgstr "로만에 대해 말해 줄 수 있는 게 있어?"

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman02Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Amused
#. SoundFileID = 00F948E4
#. ScriptNotes = Amused / to Player Default
#. EDID: [0105CE91]
#. REC: INFO:NAM1
msgctxt "00217C"
msgid "As for that ransom, though... He must've been hoping I'd get the credits from Atka because he knows I don't have that kinda money."
msgstr "그 몸값 말인데... 내가 그런 돈이 없다는 걸 아니까 아트카에게서 크레딧을 받아 오길 바랐던 거겠지."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman02Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Confident
#. SoundFileID = 00CB1648
#. ScriptNotes = Confident / to Player Default
#. EDID: [0105CE91]
#. REC: INFO:NAM1
msgctxt "00217D"
msgid "He gets along with Atka fine and he loves Milli. I think he just wanted to make things interesting for me."
msgstr "그는 아트카와도 잘 지내고 밀리도 좋아해. 그냥 나한테 뭔가 재미있는 일을 만들어 주고 싶었던 것 같아."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman02Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Thinking
#. SoundFileID = 009CAB83
#. ScriptNotes = Thinking / to Player Default
#. DialogueBefore = Player Default: Why would Roman target your sister for ransom?
#. EDID: [0105CE91]
#. REC: INFO:NAM1
msgctxt "00217E"
msgid "I think he did it for me, as weird as that sounds."
msgstr "이상하게 들리겠지만, 그가 날 위해 그랬던 것 같아."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_AtkaScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Yura
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00D8E137
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: So what's the deal with you and Atka? &&& Yura: Atka's always trying to get me to do stuff so she can "teach me responsibility." |I think she got it from our parents who couldn't handle the fact that I never went to college or bothered with a steady job.
#. DialogueAfter = Player Default: Understatement of the year. I'm not exactly successful in my own eyes either, but at least it's the life I want to live.
#. EDID: [0105CE98]
#. REC: INFO:NAM1
msgctxt "00217F"
msgid "The parents' view of success doesn't always match the child's."
msgstr "부모가 보는 성공이 자식의 생각과 항상 같지는 않아."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_AtkaScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Yura
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00FA829D
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: So what's the deal with you and Atka? &&& Yura: Atka's always trying to get me to do stuff so she can "teach me responsibility." |I think she got it from our parents who couldn't handle the fact that I never went to college or bothered with a steady job.
#. DialogueAfter = Player Default: I know, which is probably why I let her talk me into these stupid situations to begin with.
#. EDID: [0105CEAC]
#. REC: INFO:NAM1
msgctxt "002180"
msgid "Atka just wants to make sure you're taken care of."
msgstr "아트카는 네가 잘 지내는지 확인하고 싶을 뿐이야."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_AtkaScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Yura
