#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman01Scene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Yura
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0027FE6C
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: What makes you think you aren't relationship material? &&& Yura: Let's just say I've got some issues that don't let me make the best decisions and leave it at that.
#. DialogueAfter = Player Default: I know he would, but he doesn't need to deal with all my emotional baggage.
#. EDID: [0105BF9E]
#. REC: INFO:NAM1
msgctxt "000C77"
msgid "So you have to work through some things. Roman would understand."
msgstr "그러니까 너 스스로 극복해야 할 문제가 있는 것뿐이잖아. 로만은 이해해 줄 거야."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman01Scene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Yura
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00663457
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Roman wanted me to put in a good word for him with you. &&& Yura: Roman's the best. &&& Yura: I can't believe he did all this for me. &&& Yura: I really wish I deserved someone like him, but I'm just not relationship material. Not right now.
#. DialogueAfter = Player Default: Roman? He's the best friend anyone can ask for. Reliable, good listener, totally gets me.
#. EDID: [0105BF79]
#. REC: INFO:NAM1
msgctxt "000C78"
msgid "How do you feel about him? "
msgstr "로만에 대해 어떻게 생각해? "

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_MS03DoneRomanDeadScene
#. DialogCallType = NPCResponse
#. Speaker = Atka
#. VoiceType = SFFL_NPCFAtka
#. Face = Concerned
#. SoundFileID = 00978575
#. ScriptNotes = Concerned / to Yura
#. DialogueAfter = Yura: You think so? But I'm so stupid! I never let him in because who could love someone like me? I screw up everything.
#. EDID: [0105BF8F]
#. REC: INFO:NAM1
msgctxt "000C79"
msgid "You guys were inseparable, and I know he loved you, too."
msgstr "너희는 항상 붙어 다녔잖아. 로만도 널 사랑했을 거야."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_MS03DoneRomanDeadScene
#. DialogCallType = NPCResponse
#. Speaker = Atka
#. VoiceType = SFFL_NPCFAtka
#. Face = Concerned
#. SoundFileID = 001DD2EC
#. ScriptNotes = Concerned / to Yura
#. DialogueBefore = Atka: Yura, I'm so sorry. I know how close you were. &&& Yura: I... I loved him, Atka... and I never got to tell him.
#. EDID: [0105BF8F]
#. REC: INFO:NAM1
msgctxt "000C7A"
msgid "I'm sure deep down he knew. He had to."
msgstr "로만도 내심 알고 있었을 거야. 분명히 그랬을 거야."

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Atka_TL_YuraScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 002B0D23
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Can you tell me more about Yura? &&& Atka: You pretty much experienced my sister in a nutshell.|She's the queen of work avoidance. I think she'd rather die than hold down a real job.|I just want some stability in her life, so I don't have to worry about her all the time.
#. DialogueAfter = Player Default: Because she's my sister, and she's all I have.
#. EDID: [0105CE8F]
#. REC: INFO:NAM1
msgctxt "000C7B"
msgid "Why do you worry about Yura?"
msgstr "왜 유라를 걱정해?"

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman01Scene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = Yura
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 009E5729
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: Roman wanted me to put in a good word for him with you. &&& Yura: Roman's the best. &&& Yura: I can't believe he did all this for me. &&& Yura: I really wish I deserved someone like him, but I'm just not relationship material. Not right now.
#. DialogueAfter = Player Default: Let's just say I've got some issues that don't let me make the best decisions and leave it at that.
#. EDID: [0105BF7E]
#. REC: INFO:NAM1
msgctxt "000C7C"
msgid "What makes you think you aren't relationship material?"
msgstr "왜 네가 연애할 만한 인간이 아니라고 생각해?"

#. List: 2
#. QuestName = SFFL_MS03_Support
#. SceneName = SFFL_MS03_PostQuest_Yura_TL_Roman01Scene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Confident
#. SoundFileID = 008235F6
#. ScriptNotes = Confident / to Player Default
#. Prompt = Why don't you think you deserve him?
#. DialogueAfter = Yura: He really likes you, Yura. Give him a chance.
#. EDID: [0105BF95]
#. REC: INFO:NAM1
