#. DialogueBefore = Player Default: I'm here to see the specials.
#. EDID: [0106BE01]
#. REC: INFO:NAM1
msgctxt "001BCB"
msgid "Good thing we received a new shipment, then!"
msgstr "그럼 새 선적물이 들어와서 다행이군요!"

#. List: 2
#. QuestName = SFFL_BE_EC03
