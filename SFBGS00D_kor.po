#. EDID: [010276DB]
#. REC: INFO:NAM1
msgctxt "0156E2"
msgid "There's nothing wrong with you. You appear in perfect health."
msgstr "아무 문제 없어. 완벽하게 건강해 보이는데."

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = InPain
#. SoundFileID = 004DD1EC
#. ScriptNotes = InPain
#. EDID: [01083DC6]
#. REC: INFO:NAM1
msgctxt "015710"
msgid "Hey!"
msgstr "이봐!"

#. List: 2
#. QuestName = SFBGS038_CREW_EliteCrew_Muria
#. DialogCallType = NPCResponse
#. Speaker = Muria
#. VoiceType = NPCFMuria
#. Face = Serious
#. SoundFileID = 0015EC2C
#. EDID: [01083D1F]
#. REC: INFO:NAM1
msgctxt "015711"
