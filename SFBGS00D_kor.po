#. QuestName = SFFL_SE_EC07
#. SceneName = SFFL_SE_EC07_100_HailAccepted
#. DialogCallType = NPCResponse
#. Speaker = GalBankShip
#. VoiceType = SFFL_SE_EC07_Hannah_Voice
#. Face = Spaceship / Grateful
