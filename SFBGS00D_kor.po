#. DialogueAfter = Atka: Excuse me.
#. EDID: [01035874]
#. REC: INFO:NAM1
msgctxt "001284"
msgid "As you can see, Atka decided to come home earlier than expected."
msgstr "보시다시피, 아트카가 예정보다 일찍 집에 돌아오게 됐거든."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_MainEndScene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Concerned
#. SoundFileID = 002451EC
#. ScriptNotes = Refocusing her attention to the issue at hand, her sister returning early. / Concerned / to Player Default
#. Prompt = Milli was petnapped. I had to get her back.
#. EDID: [01035874]
#. REC: INFO:NAM1
msgctxt "001285"
msgid "Never mind. Focus..."
msgstr "관두자. 딴 데 신경 쓸 때가 아니지..."

#. List: 2
#. QuestName = SFFL_MS03
#. SceneName = SFFL_MS03_3200_Yura_MainEndScene
#. DialogCallType = NPCResponse
#. Speaker = Yura
#. VoiceType = SFFL_NPCFYura
#. Face = Disbelief
#. SoundFileID = 00153BD8
