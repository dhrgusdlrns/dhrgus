#. Face = Grateful
#. SoundFileID = 00F490F1
#. ScriptNotes = Grateful
#. EDID: SFFL_R02_TargetSpared_SharedInfo03
#. REC: INFO:NAM1
msgctxt "001D9B"
msgid "I'm gonna disappear. I promise. "
msgstr "난 사라질게. 약속해."

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralNPC_Scene
#. DialogCallType = NPCResponse
#. Speaker = GenNPC
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Shocked
#. SoundFileID = 00DFCCFC
#. ScriptNotes = shocked - suddenly realizing your life is in grave danger / Shocked / to Player Default
#. Prompt = You're in danger. Someone put a target on your back.
#. DialogueBefore = Player Default: You're in danger. Someone put a target on your back.
#. DialogueAfter = GenNPC: Give me something that I can say is proof that I killed you. Then leave, and never look back.
#. EDID: [0104609D]
#. REC: INFO:NAM1
msgctxt "001D9C"
msgid "That... oh no, what am I supposed to do? "
msgstr "그건... 아, 안 돼. 난 이제 어떻게 해야 하지?"

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralNPC_Scene
#. DialogCallType = NPCResponse
#. Speaker = GenNPC
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Nervous
#. SoundFileID = 008990BA
#. ScriptNotes = pleading - hoping that player will accept your money and spare your life / Nervous / to Player Default
#. DialogueBefore = GenNPC: Wait, no! Don't do this!
#. DialogueAfter = Player Default: [Attack] Not interested.
#. EDID: [010590DA]
#. REC: INFO:NAM1
msgctxt "001D9D"
msgid "Wait! Wait! Just... here, take my money, take all of it. It's not much but... just let me leave, okay? I'll leave the Settled Systems forever!"
msgstr "잠깐! 잠깐! 그냥... 여기, 내 돈을 가져가. 전부 가져가. 많진 않지만... 제발 보내줘, 알겠지? 개척 성계를 영원히 떠날게!"

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralNPC_Scene
#. DialogCallType = NPCResponse
#. Speaker = GenNPC
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Shocked
#. SoundFileID = 007B462C
#. ScriptNotes = Shocked / to Player Default
#. DialogueBefore = GenNPC:
#. EDID: [010590F0]
#. REC: INFO:NAM1
msgctxt "001D9E"
msgid "Wait, no! Don't do this!"
msgstr "잠깐, 안 돼! 이러지 마!"

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralNPC_Scene
#. DialogCallType = NPCResponse
#. Speaker = GenNPC
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Grateful
#. SoundFileID = 003B02B5
#. ScriptNotes = grateful, player decided to spare your life / Grateful / to Player Default
#. Prompt = [Accept <Global=SFFL_R02_BribeAmount> Credits] Give me the credits and your ID, and don't ever show your face around here again.
#. DialogueBefore = Player Default: [Accept <Global=SFFL_R02_BribeAmount> Credits] Give me the credits and your ID, and don't ever show your face around here again.
#. EDID: [010590EA]
#. REC: INFO:NAM1
msgctxt "001D9F"
msgid "Good, just take it. I'm out of here!"
msgstr "좋아, 그냥 가져가. 난 여기서 나갈 거야!"

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralNPC_Scene
#. DialogCallType = NPCResponse
#. Speaker = GenNPC
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Grateful
#. SoundFileID = 00D321E8
#. ScriptNotes = grateful, player decided to spare your life / Grateful / to Player Default
#. Prompt = [Accept <Global=SFFL_R02_BribeAmount> Credits] Give me the credits and your ID, and don't ever show your face around here again.
#. DialogueBefore = Player Default: [Accept <Global=SFFL_R02_BribeAmount> Credits] Give me the credits and your ID, and don't ever show your face around here again.
#. EDID: [010590E9]
#. REC: INFO:NAM1
msgctxt "001DA0"
msgid "Oh, thank god... I just have to get my things, then I'm gone for good. I swear."
msgstr "아, 다행이다... 짐만 챙기면 영영 사라질게. 맹세해."

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_Intro
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. Alias = TheArbitrator
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0044B77F
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: No need to explain yourself. We've been through this before, you and I. &&& TheArbitrator: If that's the case, I guess I'll skip the preamble. &&& TheArbitrator: I'm not gonna beat around the bush. I'm looking for someone that is willing to kill people - people that may or may not deserve it - for money. No questions asked.|Are you that special someone?
#. DialogueAfter = Player Default: Move on, then.
#. EDID: [0102A42D]
#. REC: INFO:NAM1
msgctxt "001DA1"
msgid "I'm not doing that."
msgstr "난 그런 일은 안 해."

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_TurnIn
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00283875
#. ScriptNotes = / to TheArbitrator
#. DialogueAfter = TheArbitrator: If this happens again and I find out, that will be the end of our dealings together.
#. EDID: [0102A43C]
#. REC: INFO:NAM1
msgctxt "001DA2"
msgid "I took out the target. Here's your proof. "
msgstr "목표물을 처리했다. 증거는 여기 있다. "

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralNPC_Scene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 00F58CB0
#. ScriptNotes = / to Player Default
#. DialogueBefore = GenNPC: Huh? Who are you, and what do you want?
#. DialogueAfter = GenNPC: Wait, no! Don't do this!
#. EDID: [0102A436]
#. REC: INFO:NAM1
msgctxt "001DA3"
msgid "[Attack] Someone wants you dead. I'm here to make that happen."
msgstr "[공격] 누군가 네가 죽길 원해. 난 그걸 실행하러 왔고."

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_GeneralNPC_Scene
#. DialogCallType = NPCResponse
#. Speaker = GenNPC
#. VoiceType = SFFL_NPCMGenericMale02 / SFFL_NPCMGenericMale01 / SFFL_NPCFGenericFemale01 / SFFL_NPCFGenericFemale02
#. Face = Neutral
#. SoundFileID = 000CFC4B
#. ScriptNotes = standoffish - you don't know who this person is yet and are suspicious of them / to Player Default
#. DialogueAfter = Player Default: [Attack] Someone wants you dead. I'm here to make that happen.
#. EDID: [0102A430]
#. REC: INFO:NAM1
msgctxt "001DA4"
msgid "Huh? Who are you, and what do you want?"
msgstr "뭐? 넌 누구고, 뭘 원하는 거야?"

#. List: 2
#. QuestName = SFFL_R02
#. SceneName = SFFL_R02_Intro
#. DialogCallType = NPCResponse
