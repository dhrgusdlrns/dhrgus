#. DialogueBefore = Player Default: It doesn't really matter. The point is, I'm here.
#. EDID: [01040494]
#. REC: INFO:NAM1
msgctxt "000B9F"
msgid "Fair enough. I'm still damn glad you came."
msgstr "좋아. 그래도 네가 와 줘서 정말 다행이야."

#. List: 2
#. QuestName = SFFL_AnchorpointZ03
#. SceneName = SFFL_AnchorpointZ03_MilesScene
#. DialogCallType = PlayerDialogue
#. Speaker = Player
#. VoiceType = PlayerVoiceMale01 / PlayerVoiceFemale01
#. Face = Neutral
#. SoundFileID = 0081CF45
#. ScriptNotes = / to Player Default
#. DialogueBefore = Player Default: I'm here to rescue you. &&& MilesCutler: You have no idea how happy I am to hear those words. &&& MilesCutler: If you're here, that must mean Lucia made it out. Thank goodness.
#. DialogueAfter = Player Default: I'm sorry, did you say my father?
#. EDID: [010404AD]
#. REC: INFO:NAM1
msgctxt "000BA0"
msgid "She sent a message to your father, and he sent me."
msgstr "그녀가 네 아버지에게 메시지를 보냈고, 그가 나를 보냈어."

#. List: 2
#. QuestName = SFFL_AnchorpointZ03
#. SceneName = SFFL_AnchorpointZ03_CuttuEndScene
