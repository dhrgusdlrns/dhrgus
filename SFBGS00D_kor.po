#. DialogueAfter = CuttyClean: A long-overdue change.
#. EDID: [0106BB87]
#. REC: INFO:NAM1
msgctxt "000DB7"
msgid "You look different."
msgstr "달라 보이네."

#. List: 2
#. QuestName = SFFL_DialogueAnchorpoint
#. SceneName = SFFL_DialogueAnchorpoint_CuttyMilesScene
#. DialogCallType = NPCResponse
#. Speaker = MilesCutler
#. VoiceType = SFFL_NPCMMilesCutler
#. Face = Neutral
