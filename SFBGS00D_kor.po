#. EDID: [0106B170]
#. REC: INFO:NAM1
msgctxt "001F29"
msgid "Didn't expect that, now, did ya?"
msgstr "예상 못 했지? 그렇지?"

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_Pirate01_Scene
#. DialogCallType = NPCResponse
#. Speaker = PirateShip01
#. VoiceType = SFFL_NPCMGenericMale03
#. Face = Spaceship / SinisterSmile
#. SoundFileID = 00544218
#. ScriptNotes = Aggressive pirates grav jumping into the area to attach the player's ship in an ambush. / SinisterSmile
#. EDID: [0106AD53]
#. REC: INFO:NAM1
msgctxt "001F2A"
msgid "Prepare to be destroyed!"
msgstr "파괴될 준비나 해라!"

#. List: 2
#. QuestName = SFFL_SE_EC06
#. SceneName = SFFL_SE_EC06_Pirate01_Scene
#. DialogCallType = NPCResponse
#. Speaker = PirateShip01
#. VoiceType = SFFL_NPCMGenericMale03
#. Face = Spaceship / Defiant
