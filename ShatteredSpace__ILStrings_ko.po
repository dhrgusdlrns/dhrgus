#. TYPE: SceneDialogue
#. SUBTYPE: Custom
msgctxt "012383"
msgid "All Must Serve."
msgstr "모두가 섬겨야 한다."

#. VOICE TYPE: SFBGS001_VaruunGuardMale02
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunGuards
#. TOPIC: 010838BF
#. INFO GROUP: SFBGS001_HVGenericGuards_Hellos
#. TYPE: Miscellaneous
#. SUBTYPE: Hello
msgctxt "012382"
msgid "Obedience is paramount."
msgstr "복종하는 것이 제일 중요합니다."

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_NPCMComrakAbbas
#. FACE: Angry
#. QUEST: SFBGS001_Dialogue_LC15
#. TOPIC: 010D6C07
#. INFO GROUP: SFBGS001_Dialogue_LC15_BlockingHellosComrak
#. TYPE: Miscellaneous
#. SUBTYPE: BlockingHello
msgctxt "012381"
msgid "Get away from me, murderer."
msgstr "저리 꺼져. 이 살인자."

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_NPCMComrakAbbas
#. FACE: Angry
#. QUEST: SFBGS001_Dialogue_LC15
#. TOPIC: 010D6C07
#. INFO GROUP: SFBGS001_Dialogue_LC15_BlockingHellosComrak
#. TYPE: Miscellaneous
#. SUBTYPE: BlockingHello
msgctxt "012380"
msgid "I don't have anything to say to you."
msgstr "하고 싶은 말 없다."

#. VOICE TYPE: SFBGS001_NPCMComrakAbbas
#. FACE: Neutral
#. QUEST: SFBGS001_Dialogue_LC15
#. TOPIC: 010D6C07
#. INFO GROUP: SFBGS001_Dialogue_LC15_BlockingHellosComrak
#. TYPE: Miscellaneous
#. SUBTYPE: BlockingHello
msgctxt "01237F"
msgid "You're not one of us. I'm not supposed to talk to you."
msgstr "우리 편이 아니잖아. 이야기를 나누면 안 돼."

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_NPCFRaljiraAbbas
#. FACE: Angry
#. QUEST: SFBGS001_Dialogue_LC15
#. TOPIC: 010D6C07
#. INFO GROUP: SFBGS001_Dialogue_LC15_BlockingHellosRaljira
#. TYPE: Miscellaneous
#. SUBTYPE: BlockingHello
msgctxt "01237E"
msgid "You are not welcome here, killer."
msgstr "여긴 살인자는 필요 없어."

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_NPCFRaljiraAbbas
#. FACE: Angry
#. QUEST: SFBGS001_Dialogue_LC15
#. TOPIC: 010D6C07
#. INFO GROUP: SFBGS001_Dialogue_LC15_BlockingHellosRaljira
#. TYPE: Miscellaneous
#. SUBTYPE: BlockingHello
msgctxt "01237D"
msgid "You have betrayed our trust. You are worthless."
msgstr "넌 우리의 신뢰를 배신했어. 넌 가치 없는 놈이야."

#. VOICE TYPE: SFBGS001_NPCFRaljiraAbbas
#. FACE: Neutral
#. QUEST: SFBGS001_Dialogue_LC15
#. TOPIC: 010D6C07
#. INFO GROUP: SFBGS001_Dialogue_LC15_BlockingHellosRaljira
#. TYPE: Miscellaneous
#. SUBTYPE: BlockingHello
msgctxt "01237C"
msgid "You have no business being here, husk."
msgstr "여기에 볼일이 있을 리 없잖아. 허물 주제에."

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_NPCMGamiralAbbas
#. FACE: Angry
#. QUEST: SFBGS001_Dialogue_LC15
#. TOPIC: 010D6C07
#. INFO GROUP: SFBGS001_Dialogue_LC15_BlockingHellosGamiral
#. TYPE: Miscellaneous
#. SUBTYPE: BlockingHello
msgctxt "01237B"
msgid "We will not forget, and we will never forgive."
msgstr "잊지도 않을 거고, 용서하지도 않을 거야."

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_NPCMGamiralAbbas
#. FACE: Angry
#. QUEST: SFBGS001_Dialogue_LC15
#. TOPIC: 010D6C07
#. INFO GROUP: SFBGS001_Dialogue_LC15_BlockingHellosGamiral
#. TYPE: Miscellaneous
#. SUBTYPE: BlockingHello
msgctxt "01237A"
msgid "You would dare show your face here, after what you did to Kaviil?"
msgstr "캐빌한테 그런 짓을 해놓고선 감히 얼굴을 들이밀어?"

#. VOICE TYPE: SFBGS001_NPCMGamiralAbbas
#. FACE: Neutral
#. QUEST: SFBGS001_Dialogue_LC15
#. TOPIC: 010D6C07
#. INFO GROUP: SFBGS001_Dialogue_LC15_BlockingHellosGamiral
#. TYPE: Miscellaneous
#. SUBTYPE: BlockingHello
msgctxt "012379"
msgid "Get off my farm."
msgstr "내 농장에서 꺼져."

#. SCRIPT NOTES: InPain
