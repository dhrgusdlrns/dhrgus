#. INFO GROUP: FormID 01158541
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013AD"
msgid "Devour them whole."
msgstr "통째로 삼켜버려."

#. SCRIPT NOTES: Generic House Dul'kehf greeting. Polite, business friendly. / Confident
#. VOICE TYPE: SFBGS001_VaruunGenericMale05
#. FACE: Confident
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD8A
#. INFO GROUP: SFBGS001_GenericExecutors_Hellos
#. TYPE: Miscellaneous
#. SUBTYPE: Hello
msgctxt "0013AC"
msgid "Serpent bless you."
msgstr "위대한 뱀께서 축복하시길."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_SharedDialogue
#. TOPIC: 0103AB9E
#. INFO GROUP: SFBGS001_SE_SharedInfo_NoReward_Group
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013AB"
msgid "Then all glory to you."
msgstr "그렇다면 모든 영광을 당신에게."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_SharedDialogue
#. TOPIC: 0103AB9E
#. INFO GROUP: SFBGS001_SE_SharedInfo_Ending_Group
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013AA"
msgid "May the Serpent's Crusade guide the Promised."
msgstr "뱀의 성전군이 약속받은 자를 인도하기를."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_SharedDialogue
#. TOPIC: 0103AB9E
#. INFO GROUP: SFBGS001_SE_SharedInfo_Ending_Group
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013A9"
msgid "We shall resume our patrol and destroy any heretics."
msgstr "우리는 순찰을 재개하고 이단자들을 파괴할 것이다."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_SharedDialogue
#. TOPIC: 0103AB9E
#. INFO GROUP: SFBGS001_SE_SharedInfo_Ending_Group
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013A8"
msgid "We will secure the area, but more prey awaits elsewhere. Glory to the Great Serpent."
msgstr "우리는 이 지역을 확보하겠지만, 더 많은 먹잇감이 다른 곳에서 기다리고 있다. 위대한 뱀에 영광을."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_SharedDialogue
#. TOPIC: 0103AB9E
#. INFO GROUP: SFBGS001_SE_SharedInfo_HailRejected_Group
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013A7"
msgid "If you wish to remain silent, so be it."
msgstr "침묵을 지키고 싶다면, 그렇게 하라."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_SharedDialogue
#. TOPIC: 0103AB9E
#. INFO GROUP: SFBGS001_SE_SharedInfo_HailRejected_Group
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013A6"
msgid "Have it your way. The Shrouding comes for us all."
msgstr "네 뜻대로 하라. 장막의 날이 우리 모두에게 다가오고 있다."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_SharedDialogue
#. TOPIC: 0103AB9E
#. INFO GROUP: SFBGS001_SE_SharedInfo_HailRejected_Group
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013A5"
msgid "No words are needed that are not the Serpent's call. Glory be with you."
msgstr "뱀의 부름이 아닌 말은 필요 없다. 영광이 함께하기를."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_SharedDialogue
#. TOPIC: 0103AB9E
#. INFO GROUP: SFBGS001_SE_SharedInfo_HailingAccepted_Group
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013A4"
msgid "We fight for the Serpent's Crusade. If you are of like mind, respond to the hail."
msgstr "우리는 뱀의 성전을 위해 싸운다. 뜻이 같다면, 교신에 응답하라."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_SharedDialogue
#. TOPIC: 0103AB9E
#. INFO GROUP: SFBGS001_SE_SharedInfo_HailingAccepted_Group
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013A3"
msgid "We wish to speak with you, in the name of the Serpent's Crusade."
msgstr "우리는 뱀의 성전의 이름으로 당신과 대화하기를 원한다."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_SharedDialogue
#. TOPIC: 0103AB9E
#. INFO GROUP: SFBGS001_SE_SharedInfo_HailingAccepted_Group
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013A2"
msgid "Hailing vessel in the name of the Serpent's Crusade. Acknowledge."
msgstr "뱀의 성전의 이름으로 우주선에 교신을 요청한다. 응답하라."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_SharedDialogue
#. TOPIC: 0103AB9E
#. INFO GROUP: SFBGS001_SE_SharedInfo_HailingAccepted_Group
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013A1"
msgid "The Serpent's Crusade continues. We beckon you to answer the hail."
msgstr "뱀의 성전은 계속된다. 교신에 응답하기를 바란다."

