#. TYPE: SceneDialogue
#. SUBTYPE: Custom
msgctxt "012567"
msgid "I know it..."
msgstr "기억이 나..."

#. DIALOGUE BEFORE: Play Audio At Player(Voice Note): Duck!
#. ALIAS: Play Audio At Player(Voice Note)
#. VOICE TYPE: SFBGS001_NPCFIrisUeda
#. FACE: Neutral
