#. TYPE: SceneDialogue
#. SUBTYPE: Custom
msgctxt "012184"
msgid "I can help."
msgstr "제가 도울 수 있습니다."

#. SCRIPT NOTES:  / to Player Default
#. ALIAS: NPC_Leader
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_OE_BonecrestOverrun
#. TOPIC: 010E7956
#. SCENE: SFBGS001_OE_BonecrestOverrun_MinerLeader01_Scene
#. TYPE: SceneDialogue
#. SUBTYPE: Custom
