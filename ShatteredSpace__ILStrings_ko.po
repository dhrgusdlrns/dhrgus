#. FACE: Angry
#. DIALOGUE AFTER: Karija: You utter fool! Do you have any idea what you have done?
#. QUEST: SFBGS001_MQ05
#. TOPIC: 010F64C5
#. SCENE: SFBGS001_MQ05_Stage1000_KarijaFinalFG
#. TYPE: SceneDialogue
#. SUBTYPE: Custom
msgctxt "0117A7"
msgid "No!"
msgstr "안돼!"

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Angry
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A8
#. INFO GROUP: SFBGS001_VaruunZealot_DetectFriendDie
#. TYPE: Detection
#. SUBTYPE: DetectFriendDie
msgctxt "0117A6"
msgid "What? Impossible!"
msgstr "뭐? 말도 안 돼!"

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Angry
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A8
#. INFO GROUP: SFBGS001_VaruunZealot_DetectFriendDie
#. TYPE: Detection
#. SUBTYPE: DetectFriendDie
msgctxt "0117A5"
msgid "By the Serpent!"
msgstr "뱀의 이름으로!"

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A6
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToLost
#. TYPE: Detection
#. SUBTYPE: CombatToLost
msgctxt "0117A4"
msgid "The accursed has escaped me!"
msgstr "저주받은 놈이 내게서 도망쳤다!"

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A6
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToLost
#. TYPE: Detection
#. SUBTYPE: CombatToLost
msgctxt "0117A3"
msgid "Find them! They cannot have gotten far!"
msgstr "놈을 찾아라! 멀리 가진 못했을 것이다!"

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A6
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToLost
#. TYPE: Detection
#. SUBTYPE: CombatToLost
msgctxt "0117A2"
msgid "This is futile! You cannot evade us!"
msgstr "소용없다! 우릴 피할 순 없어!"

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A6
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToLost
#. TYPE: Detection
#. SUBTYPE: CombatToLost
msgctxt "0117A1"
msgid "We mustn't allow the heretic to escape!"
msgstr "이단자를 놓쳐선 안 된다!"

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A6
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToLost
#. TYPE: Detection
#. SUBTYPE: CombatToLost
msgctxt "0117A0"
msgid "Come back and face me, coward!"
msgstr "돌아와서 내게 맞서라, 겁쟁아!"

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A6
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToLost
#. TYPE: Detection
#. SUBTYPE: CombatToLost
msgctxt "01179F"
msgid "You will know truth, coward!"
msgstr "진실을 알아라, 겁쟁아!"

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A6
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToLost
#. TYPE: Detection
#. SUBTYPE: CombatToLost
msgctxt "01179E"
msgid "Run from me, will you?!"
msgstr "내게서 도망칠 수 있을 것 같나?!"

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A6
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToLost
#. TYPE: Detection
#. SUBTYPE: CombatToLost
msgctxt "01179D"
msgid "The Serpent will have you!"
msgstr "위대한 뱀께서 널 거두실 것이다!"

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A7
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToNormal
#. TYPE: Detection
#. SUBTYPE: CombatToNormal
msgctxt "01179C"
msgid "And so it ends."
msgstr "이렇게 끝나는군."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A7
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToNormal
#. TYPE: Detection
#. SUBTYPE: CombatToNormal
msgctxt "01179B"
msgid "It could end no other way."
msgstr "이렇게 끝날 수밖에."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A7
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToNormal
#. TYPE: Detection
#. SUBTYPE: CombatToNormal
msgctxt "01179A"
msgid "The righteous prevail."
msgstr "정의가 승리한다."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A7
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToNormal
#. TYPE: Detection
#. SUBTYPE: CombatToNormal
msgctxt "011799"
msgid "Another offering for the Great Serpent."
msgstr "위대한 뱀께 바칠 또 다른 제물이다."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A7
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToNormal
#. TYPE: Detection
#. SUBTYPE: CombatToNormal
msgctxt "011798"
msgid "The Great Serpent shall feast."
msgstr "위대한 뱀께서 포식하시리라."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A7
#. INFO GROUP: SFBGS001_VaruunZealots_CombatToNormal
#. TYPE: Detection
#. SUBTYPE: CombatToNormal
msgctxt "011797"
msgid "Truth has been brought to the accursed."
msgstr "저주받은 자에게 진실이 당도했다."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A5
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToNormal
#. TYPE: Detection
#. SUBTYPE: AlertToNormal
msgctxt "011796"
msgid "There is nothing. Too bad..."
msgstr "아무것도 없군. 유감이군..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A5
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToNormal
#. TYPE: Detection
#. SUBTYPE: AlertToNormal
msgctxt "011795"
msgid "Perhaps I was mistaken..."
msgstr "내가 잘못 본 건가..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A5
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToNormal
#. TYPE: Detection
#. SUBTYPE: AlertToNormal
msgctxt "011794"
msgid "Mustn't be so on edge..."
msgstr "너무 긴장하지 말아야지..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A5
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToNormal
#. TYPE: Detection
#. SUBTYPE: AlertToNormal
msgctxt "011793"
msgid "Great Serpent, calm me..."
msgstr "위대한 뱀이시여, 저를 진정시켜 주소서..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A5
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToNormal
#. TYPE: Detection
#. SUBTYPE: AlertToNormal
msgctxt "011792"
msgid "We must calm ourselves..."
msgstr "우린 진정해야 한다..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A5
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToNormal
#. TYPE: Detection
#. SUBTYPE: AlertToNormal
msgctxt "011791"
msgid "I'd hoped for a challenge..."
msgstr "도전 과제를 기대했는데..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A5
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToNormal
#. TYPE: Detection
#. SUBTYPE: AlertToNormal
msgctxt "011790"
msgid "The mind plays tricks..."
msgstr "착각이었나..."

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Angry
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A4
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToCombat
#. TYPE: Detection
#. SUBTYPE: AlertToCombat
msgctxt "01178F"
msgid "You thought you could hide?!"
msgstr "숨을 수 있을 줄 알았나?!"

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Angry
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A4
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToCombat
#. TYPE: Detection
#. SUBTYPE: AlertToCombat
msgctxt "01178E"
msgid "The Great Serpent reveals you!"
msgstr "위대한 뱀께서 널 드러내셨다!"

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Angry
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A4
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToCombat
#. TYPE: Detection
#. SUBTYPE: AlertToCombat
msgctxt "01178D"
msgid "There you are, accursed brute!"
msgstr "거기 있었군, 저주받은 짐승아!"

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Angry
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A4
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToCombat
#. TYPE: Detection
#. SUBTYPE: AlertToCombat
msgctxt "01178C"
msgid "Now you are mine!"
msgstr "이제 넌 내 거다!"

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Angry
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A4
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToCombat
#. TYPE: Detection
#. SUBTYPE: AlertToCombat
msgctxt "01178B"
msgid "Your punishment begins!"
msgstr "네놈의 형벌이 시작된다!"

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Angry
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A4
#. INFO GROUP: SFBGS001_VaruunZealots_AlertToCombat
#. TYPE: Detection
#. SUBTYPE: AlertToCombat
msgctxt "01178A"
msgid "A heretic! Here!"
msgstr "이단자다! 저기 있다!"

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A3
#. INFO GROUP: VaruunZealots_AlertIdleDUPLICATE000
#. TYPE: Detection
#. SUBTYPE: AlertIdle
msgctxt "011789"
msgid "I know what I heard..."
msgstr "내가 뭘 들었는지 알고 있다..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A3
#. INFO GROUP: VaruunZealots_AlertIdleDUPLICATE000
#. TYPE: Detection
#. SUBTYPE: AlertIdle
msgctxt "011788"
msgid "Great Serpent... reveal what I cannot see..."
msgstr "위대한 뱀이시여... 제게 보이지 않는 것을 보여주소서..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A3
#. INFO GROUP: VaruunZealots_AlertIdleDUPLICATE000
#. TYPE: Detection
#. SUBTYPE: AlertIdle
msgctxt "011787"
msgid "I sense a disturbance..."
msgstr "뭔가 이상한 기운이 느껴져..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A3
#. INFO GROUP: VaruunZealots_AlertIdleDUPLICATE000
#. TYPE: Detection
#. SUBTYPE: AlertIdle
msgctxt "011786"
msgid "Feel like I'm being watched..."
msgstr "누군가 날 지켜보는 것 같아..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A3
#. INFO GROUP: VaruunZealots_AlertIdleDUPLICATE000
#. TYPE: Detection
#. SUBTYPE: AlertIdle
msgctxt "011785"
msgid "Great Serpent guide me... help me find what eludes me..."
msgstr "위대한 뱀이시여, 절 인도하소서... 제게서 벗어난 것을 찾도록 도와주소서..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A3
#. INFO GROUP: VaruunZealots_AlertIdleDUPLICATE000
#. TYPE: Detection
#. SUBTYPE: AlertIdle
msgctxt "011784"
msgid "I'd swear I heard..."
msgstr "분명히 들었는데..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A3
#. INFO GROUP: SFBGS001_VaruunZealots_AlertIdle_Suspicious
#. TYPE: Detection
#. SUBTYPE: AlertIdle
msgctxt "011783"
msgid "I know you can hear me..."
msgstr "내 말이 들린다는 걸 안다..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A3
#. INFO GROUP: SFBGS001_VaruunZealots_AlertIdle_Suspicious
#. TYPE: Detection
#. SUBTYPE: AlertIdle
msgctxt "011782"
msgid "You cannot evade me forever..."
msgstr "영원히 날 피할 순 없다..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A3
#. INFO GROUP: SFBGS001_VaruunZealots_AlertIdle_Suspicious
#. TYPE: Detection
#. SUBTYPE: AlertIdle
msgctxt "011781"
msgid "Evasion is futile..."
msgstr "소용없는 짓이다..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A3
#. INFO GROUP: SFBGS001_VaruunZealots_AlertIdle_Suspicious
#. TYPE: Detection
#. SUBTYPE: AlertIdle
msgctxt "011780"
msgid "I know you're near... the Great Serpent guides me..."
msgstr "네가 근처에 있다는 걸 안다... 위대한 뱀께서 날 인도하신다..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A3
#. INFO GROUP: SFBGS001_VaruunZealots_AlertIdle_Suspicious
#. TYPE: Detection
#. SUBTYPE: AlertIdle
msgctxt "01177F"
msgid "The Great Serpent will have you eventually..."
msgstr "위대한 뱀께서 결국 널 찾아내실 것이다..."

#. SCRIPT NOTES: Puzzled
#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Puzzled
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A3
#. INFO GROUP: SFBGS001_VaruunZealots_AlertIdle_Suspicious
#. TYPE: Detection
#. SUBTYPE: AlertIdle
msgctxt "01177E"
msgid "The longer you make me look, the worse it will be for you..."
msgstr "날 더 찾게 만들수록, 네놈에게 더 고통스러울 것이다..."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_SuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "01177D"
msgid "Let them resist and run blindly towards judgment. The darkness awaits them."
msgstr "저항하고 심판을 향해 맹목적으로 달려가도록 내버려 두어라. 어둠이 저들을 기다린다."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_SuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "01177C"
msgid "Heretics are unworthy of mercy. Those who have rejected the Great Serpent have sealed their fate."
msgstr "이단자들은 자비를 받을 가치가 없다. 위대한 뱀을 거부한 자들은 그들의 운명을 결정지었다."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_SuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "01177B"
msgid "Great Serpent, inject your venom into my veins. Steel me for battle."
msgstr "위대한 뱀이시여, 제 혈관에 당신의 독을 주입하소서. 전투를 위해 저를 단련시키소서."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_SuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "01177A"
msgid "I am coiled, ready to strike..."
msgstr "나는 똬리를 틀었고, 공격할 준비가 되었다..."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_SuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "011779"
msgid "His judgement is at hand..."
msgstr "그분의 심판이 가까이 오리라..."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_SuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "011778"
msgid "The Great Serpent hungers..."
msgstr "위대한 뱀께서 굶주리셨다..."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_SuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "011777"
msgid "Hark! The hiss! A dirge for heretics..."
msgstr "들어라! 쉿 소리! 이단자들을 위한 장송곡..."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "011776"
msgid "Great Serpent, aid us in our plight. Grant us strength as we deliver heretics unto darkness..."
msgstr "위대한 뱀이시여, 우리의 고난을 도우소서. 이단자들을 어둠 속으로 인도할 때 우리에게 힘을 주소서..."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "011775"
msgid "The Shrouding is at hand."
msgstr "장막의 날이 가까이 왔다."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "011774"
msgid "I harbor no doubts. The truth of all existence has been revealed to me."
msgstr "나는 의심하지 않는다. 모든 존재의 진실이 내게 밝혀졌다."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "011773"
msgid "The accursed mock and jeer at us. How can they be so blind?"
msgstr "저주받은 자들이 우리를 조롱하고 야유한다. 어찌 저리도 눈이 멀었을까?"

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "011772"
msgid "Hungry... Could use some groat. I must maintain my strength."
msgstr "허기진다... 그로트를 좀 먹어야겠다. 힘을 유지해야 해."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "011771"
msgid "Ah, sloff. Where did I misplace it...?"
msgstr "아, 허물지네. 어디다 뒀더라...?"

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "011770"
msgid "Heretics may put up a good fight... but it is all useless in the end."
msgstr "이단자들이 잘 싸울지도 모르지... 하지만 결국엔 다 소용없다."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "01176F"
msgid "I have not visited Dazra in years... I forget what it's like."
msgstr "다즈라에 간 지 몇 년이 지났는데... 어떤 곳인지 잊었군."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "01176E"
msgid "I shall see my family again in time. For they were Promised, just as I am."
msgstr "때가 되면 내 가문을 다시 만날 것이다. 그들 또한 나처럼 약속받은 자들이었으니."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "01176D"
msgid "His eyes are galaxies..."
msgstr "그분의 눈은 은하시도다..."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "01176C"
msgid "I fear nothing, for it is the Promised who are feared."
msgstr "나는 아무것도 두렵지 않다. 두려움을 받는 자는 바로 약속받은 자들이니까."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "01176B"
msgid "The unworthy cannot hope to comprehend the truth, and so they can only be offerings."
msgstr "가치 없는 자들은 진실을 이해할 가망이 없기에, 그저 제물이 될 뿐이다."

#. VOICE TYPE: SFBGS001_VaruunZealotFemale03
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunZealots_NewVoicesOnly
#. TOPIC: 010CE1A2
#. INFO GROUP: VaruunZealot_Idle_NotSuspiciousDUPLICATE000
#. TYPE: Miscellaneous
#. SUBTYPE: Idle
msgctxt "01176A"
msgid "His scales... oh, how they shimmer."
msgstr "그분의 비늘은... 오, 어찌 저리도 빛나시는가."

