#. FACE: Shocked
#. QUEST: SFBGS001_MQ02
#. TOPIC: 011112B1
#. INFO GROUP: SFBGS001_MQ02_SharedInfos_AnaskoScene_Generic0104
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0136BE"
msgid "He appears again!"
msgstr "다시 나타나셨어!"

#. SCRIPT NOTES: Shocked
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Shocked
#. QUEST: SFBGS001_MQ02
#. TOPIC: 011112B1
#. INFO GROUP: SFBGS001_MQ02_SharedInfos_AnaskoScene_Generic0104
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0136BD"
msgid "Great Serpent, it's happening again!"
msgstr "위대한 뱀이시여! 또 이런 일이!"

#. SCRIPT NOTES: Shocked
#. VOICE TYPE: SFBGS001_VaruunGenericMale05
#. FACE: Shocked
#. QUEST: SFBGS001_MQ02
#. TOPIC: 011112B1
#. INFO GROUP: SFBGS001_MQ02_SharedInfos_AnaskoScene_Generic0508
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0136BC"
msgid "Speaker, please! Come back to us!"
msgstr "대변자님! 제발요! 돌아와 주세요!"

#. SCRIPT NOTES: Shocked
#. VOICE TYPE: SFBGS001_VaruunGenericMale05
#. FACE: Shocked
#. QUEST: SFBGS001_MQ02
#. TOPIC: 011112B1
#. INFO GROUP: SFBGS001_MQ02_SharedInfos_AnaskoScene_Generic0508
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0136BB"
msgid "Great Serpent, save us!"
msgstr "위대한 뱀이시여! 우리를 구원하소서!"

#. SCRIPT NOTES: Shocked
#. VOICE TYPE: SFBGS001_VaruunGenericMale05
#. FACE: Shocked
#. QUEST: SFBGS001_MQ02
#. TOPIC: 011112B1
#. INFO GROUP: SFBGS001_MQ02_SharedInfos_AnaskoScene_Generic0508
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0136BA"
msgid "Speaker, we need you!"
msgstr "대변자님! 당신이 필요합니다!"

#. SCRIPT NOTES: Thinking
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Thinking
#. QUEST: SFBGS001_MQ02
#. TOPIC: 011112B0
#. INFO GROUP: SFBGS001_MQ02_BlockingHellos_Generic0104
#. TYPE: Miscellaneous
#. SUBTYPE: BlockingHello
