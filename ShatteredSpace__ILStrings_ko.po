#. VOICE TYPE: SFBGS001_NPCFSaharRaztan
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD88
#. INFO GROUP: SFBGS001_SaharRaztan_WFI
#. TYPE: Miscellaneous
#. SUBTYPE: WaitingForPlayerInput
msgctxt "01291A"
msgid "Are you confused about something?"
msgstr "뭐 헷갈리는 거라도 있어?"

#. VOICE TYPE: SFBGS001_NPCFSaharRaztan
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD88
#. INFO GROUP: SFBGS001_SaharRaztan_WFI
#. TYPE: Miscellaneous
#. SUBTYPE: WaitingForPlayerInput
msgctxt "012919"
msgid "Anything else?"
msgstr "또 있어?"

#. VOICE TYPE: SFBGS001_NPCFSaharRaztan
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD88
#. INFO GROUP: SFBGS001_SaharRaztan_WFI
#. TYPE: Miscellaneous
#. SUBTYPE: WaitingForPlayerInput
msgctxt "012918"
msgid "There really is no need to be nervous. I promise that the machine is safe."
msgstr "긴장할 필요 없어. 이 기계는 안전하다고 약속할게."

#. VOICE TYPE: SFBGS001_NPCFZamiraValik
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD88
#. INFO GROUP: SFBGS001_ZamiraValik_WFI
#. TYPE: Miscellaneous
#. SUBTYPE: WaitingForPlayerInput
msgctxt "012917"
msgid "Is the stress of it all getting to you too?"
msgstr "스트레스 때문에 너도 힘든 거야?"

#. VOICE TYPE: SFBGS001_NPCFZamiraValik
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD88
#. INFO GROUP: SFBGS001_ZamiraValik_WFI
#. TYPE: Miscellaneous
#. SUBTYPE: WaitingForPlayerInput
msgctxt "012916"
msgid "It can be hard to get your mind right during times like these."
msgstr "이런 시기에는 정신 차리기가 어려울 수 있지."

#. VOICE TYPE: SFBGS001_NPCFZamiraValik
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD88
#. INFO GROUP: SFBGS001_ZamiraValik_WFI
#. TYPE: Miscellaneous
#. SUBTYPE: WaitingForPlayerInput
msgctxt "012915"
msgid "Do you still want to talk?"
msgstr "아직도 이야기하고 싶어?"

#. VOICE TYPE: SFBGS001_NPCMAmilaAdlam
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD88
#. INFO GROUP: SFBGS001_AmilaAdlam_WFI
#. TYPE: Miscellaneous
#. SUBTYPE: WaitingForPlayerInput
msgctxt "012914"
msgid "Anasko Va'ruun chose to speak to a dullard?"
msgstr "아나스코 바룬께서 이런 아둔한 자와 대화를 하셨던 건가?"

#. VOICE TYPE: SFBGS001_NPCMAmilaAdlam
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD88
#. INFO GROUP: SFBGS001_AmilaAdlam_WFI
#. TYPE: Miscellaneous
#. SUBTYPE: WaitingForPlayerInput
msgctxt "012913"
msgid "Ugh, come on, say something, will you?"
msgstr "어휴, 제발, 뭐라도 말해 줘."

#. VOICE TYPE: SFBGS001_NPCMAmilaAdlam
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD88
#. INFO GROUP: SFBGS001_AmilaAdlam_WFI
#. TYPE: Miscellaneous
#. SUBTYPE: WaitingForPlayerInput
msgctxt "012912"
msgid "Just spit something out so I can be on my way."
msgstr "할 말 있으면 말해. 가던 길이나 가게."

#. VOICE TYPE: SFBGS001_NPCFDanikaHagan
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD88
#. INFO GROUP: SFBGS001_DanikaHagan_WFI
#. TYPE: Miscellaneous
#. SUBTYPE: WaitingForPlayerInput
msgctxt "012911"
msgid "We do not have time for this."
msgstr "우리 이럴 시간 없어요."

#. VOICE TYPE: SFBGS001_NPCFDanikaHagan
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD88
#. INFO GROUP: SFBGS001_DanikaHagan_WFI
#. TYPE: Miscellaneous
#. SUBTYPE: WaitingForPlayerInput
msgctxt "012910"
msgid "We need to move this discussion along."
msgstr "얼른 얘기를 마쳐야 한다고요."

#. VOICE TYPE: SFBGS001_NPCFDanikaHagan
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD88
#. INFO GROUP: SFBGS001_DanikaHagan_WFI
#. TYPE: Miscellaneous
#. SUBTYPE: WaitingForPlayerInput
msgctxt "01290F"
msgid "What is going on?"
msgstr "무슨 일이죠?"

#. VOICE TYPE: SFBGS001_NPCFSaharRaztan
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 01033565
#. INFO GROUP: SFBGS001_SaharRaztan_Goodbyes
#. TYPE: Miscellaneous
#. SUBTYPE: Goodbye
msgctxt "01290E"
msgid "Come back if you want to feel like a new person again."
msgstr "새사람이 된 기분을 느끼고 싶으면 다시 와."

#. VOICE TYPE: SFBGS001_NPCFSaharRaztan
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 01033565
#. INFO GROUP: SFBGS001_SaharRaztan_Goodbyes
#. TYPE: Miscellaneous
#. SUBTYPE: Goodbye
msgctxt "01290D"
msgid "I could always use the business, so come back soon."
msgstr "언제든 장사는 환영이니까, 또 와."

#. VOICE TYPE: SFBGS001_NPCFSaharRaztan
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 01033565
#. INFO GROUP: SFBGS001_SaharRaztan_Goodbyes
#. TYPE: Miscellaneous
#. SUBTYPE: Goodbye
msgctxt "01290C"
msgid "Be seeing you."
msgstr "또 봐."

#. VOICE TYPE: SFBGS001_NPCFZamiraValik
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 01033565
#. INFO GROUP: SFBGS001_ZamiraValik_Goodbye
#. TYPE: Miscellaneous
#. SUBTYPE: Goodbye
msgctxt "01290B"
msgid "I will pray for you."
msgstr "널 위해 기도할게."

#. VOICE TYPE: SFBGS001_NPCFZamiraValik
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 01033565
#. INFO GROUP: SFBGS001_ZamiraValik_Goodbye
#. TYPE: Miscellaneous
#. SUBTYPE: Goodbye
msgctxt "01290A"
msgid "I hope everything turns out well for you."
msgstr "모든 일이 잘 풀렸으면 좋겠어."

#. VOICE TYPE: SFBGS001_NPCFSahimaKadic
#. FACE: Neutral
#. QUEST: SFBGS001_CREW_EliteCrew_SahimaKadic
#. TOPIC: 01003AAD
#. INFO GROUP: SFBGSDLC001_CREW_Sahima_Goodbye
#. TYPE: Miscellaneous
#. SUBTYPE: Goodbye
msgctxt "012909"
msgid "See you around."
msgstr "나중에 봐."

#. SCRIPT NOTES: cold, annoyed / Serious
#. VOICE TYPE: SFBGS001_NPCMVorisNerun
#. FACE: Serious
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 01033565
#. INFO GROUP: SFBGS001_VorisNerun_Goodbyes
#. TYPE: Miscellaneous
#. SUBTYPE: Goodbye
msgctxt "012908"
msgid "Hmmph."
msgstr "흠."

#. VOICE TYPE: SFBGS001_NPCFHantonIrara
#. FACE: Neutral
