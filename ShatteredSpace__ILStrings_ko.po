#. TYPE: SceneDialogue
#. SUBTYPE: Custom
msgctxt "011A98"
msgid "I don't want any trouble."
msgstr "전 문제를 일으키고 싶지 않아요."

#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunCitizens
#. TOPIC: 010D1F39
#. INFO GROUP: SFBGS001_GenericCitizens_ReactToWarn_NonHumanTarget
#. TYPE: Combat
#. SUBTYPE: ReactToWarn
msgctxt "011A97"
msgid "There is no need for violence here."
msgstr "그렇게 폭력을 쓸 필요는 없다고."

#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunCitizens
#. TOPIC: 010D1F39
#. INFO GROUP: SFBGS001_GenericCitizens_ReactToWarn_NonHumanTarget
#. TYPE: Combat
#. SUBTYPE: ReactToWarn
msgctxt "011A96"
msgid "Someone help!"
msgstr "도와주세요!"

#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunCitizens
#. TOPIC: 010D1F39
#. INFO GROUP: SFBGS001_GenericCitizens_ReactToWarn_NonHumanTarget
#. TYPE: Combat
#. SUBTYPE: ReactToWarn
msgctxt "011A95"
msgid "By Jinan, you must not escalate things."
msgstr "지난이시여. 갑자기 싸우려고 하진 마."

#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunCitizens
#. TOPIC: 010D1F39
#. INFO GROUP: SFBGS001_GenericCitizens_ReactToWarn_NonHumanTarget
#. TYPE: Combat
#. SUBTYPE: ReactToWarn
msgctxt "011A94"
msgid "Serpent's breath, give us help!"
msgstr "뱀의 숨결이시여, 저희를 도와주세요!"

#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunCitizens
#. TOPIC: 010D1F39
#. INFO GROUP: SFBGS001_GenericCitizens_ReactToWarn_NonHumanTarget
#. TYPE: Combat
#. SUBTYPE: ReactToWarn
msgctxt "011A93"
msgid "Give us aid, please!"
msgstr "도와주세요, 얼른!"

#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVGenericVaruunCitizens
#. TOPIC: 010D1F35
#. TYPE: Combat
#. SUBTYPE: StealTakeback
