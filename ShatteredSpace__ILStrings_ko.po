msgid "Put that back, now!"
msgstr "그거 당장 내려놔요!"

#. VOICE TYPE: SFBGS001_NPCFTevinaVethaal
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueUnique
#. TOPIC: 011030FD
#. INFO GROUP: FormID 01103134
#. TYPE: Combat
#. SUBTYPE: Assault
