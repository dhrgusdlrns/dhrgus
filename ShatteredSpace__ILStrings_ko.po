#. TOPIC: 0111B6BC
#. INFO GROUP: FormID 0111B6C4
#. TYPE: Combat
#. SUBTYPE: Taunt
msgctxt "013E2A"
msgid "Revenge for Epsilon's fallen!"
msgstr "엡실론의 쓰러진 자들을 위한 복수다!"

#. SCRIPT NOTES: Angry
#. VOICE TYPE: VaruunZealotMale01
#. FACE: Angry
#. QUEST: SFBGS001_RE_MQ03_PostQuest
#. TOPIC: 0111B6BC
#. INFO GROUP: FormID 0111B6C4
#. TYPE: Combat
#. SUBTYPE: Taunt
msgctxt "013E29"
msgid "Die, Ka'dic puppet!"
msgstr "죽어라, 카딕의 꼭두각시!"

#. SCRIPT NOTES: Angry
#. VOICE TYPE: VaruunZealotMale01
#. FACE: Angry
