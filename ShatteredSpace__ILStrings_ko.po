msgstr "바로 여기다."

#. VOICE TYPE: SFBGS001_NPCMOrahim
#. FACE: Neutral
#. QUEST: SFBGS001_MS02
#. TOPIC: 010D5F35
#. INFO GROUP: SFBGS001_MS02_OrahimHellos
#. TYPE: Miscellaneous
#. SUBTYPE: Hello
msgctxt "0119B7"
msgid "I trust you are sufficiently prepared?"
msgstr "준비는 충분히 돼 있겠지?"

#. VOICE TYPE: SFBGS001_NPCMOrahim
#. FACE: Neutral
#. QUEST: SFBGS001_MS02
#. TOPIC: 010D5F35
#. INFO GROUP: SFBGS001_MS02_OrahimHellos
#. TYPE: Miscellaneous
#. SUBTYPE: Hello
msgctxt "0119B6"
