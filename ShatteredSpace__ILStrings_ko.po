msgstr "다른 필요한 게 있으면 여기 있을게."

#. VOICE TYPE: SFBGS001_NPCMDumarHasadi
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 01033565
#. INFO GROUP: SFBGS001_DumarHasadi_Goodbyes
#. TYPE: Miscellaneous
#. SUBTYPE: Goodbye
msgctxt "0127FD"
