msgid "Weapon's ready to roll!"
msgstr "무장 준비 완료!"

#. SCRIPT NOTES: Angry
#. VOICE TYPE: RobotModelAGeneric
#. FACE: Angry
#. QUEST: SFBGS001_DialogueHVGenericRobotModelA
#. TOPIC: 010D2479
#. INFO GROUP: FormID 010D2493
#. TYPE: Detection
#. SUBTYPE: AlertToCombat
msgctxt "01077D"
msgid "I have located an enemy. I am attacking it now."
msgstr "적을 발견했습니다. 공격을 개시합니다."

#. VOICE TYPE: SFBGS001_NPCFSahimaKadic
#. FACE: Neutral
#. QUEST: SFBGS001_CREW_EliteCrew_SahimaKadic
#. TOPIC: 01003AD4
#. BRANCH: DLC001_CREW_EliteCrew_SahimaKadiicNewBranch0
#. INFO GROUP: DLC001_CREW_EliteCrew_SahimaKadic_ShipBoardingOther
#. TYPE: PlayerDialogue
#. SUBTYPE: Custom
msgctxt "0104F4"
msgid "Let us turn any hostiles penitent."
msgstr "만나게 되는 적을 전부 회개시키도록 하자."

#. VOICE TYPE: SFBGS001_NPCFSahimaKadic
#. FACE: Neutral
#. QUEST: SFBGS001_CREW_EliteCrew_SahimaKadic
#. TOPIC: 01003AD0
#. BRANCH: DLC001_CREW_EliteCrew_SahimaKadiicNewBranch0
#. INFO GROUP: SFBGSDLC001_DLC001_CREW_EliteCrew_SahimaKadic_Trade
#. TYPE: PlayerDialogue
#. SUBTYPE: Custom
msgctxt "0104F3"
msgid "The Serpent compels us to work as one."
msgstr "뱀께서는 우리가 하나가 된 듯이 일하길 바라셔."

#. SCRIPT NOTES: Irritated
#. VOICE TYPE: SFBGS001_NPCFSahimaKadic
#. FACE: Irritated
#. QUEST: SFBGS001_CREW_EliteCrew_SahimaKadic
#. TOPIC: 01003AB6
#. INFO GROUP: SFBGS001_MS01_CREW_Sahima_LostToNormal
#. TYPE: Detection
#. SUBTYPE: LostToNormal
msgctxt "0104ED"
msgid "They ran off!"
msgstr "도망갔어!"

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_NPCMTaneSalavea
#. FACE: Angry
#. QUEST: SFBGS001_CREW_EliteCrew_TaneSalavea
#. TOPIC: 01003A63
#. INFO GROUP: SFBGSDLC001_CREW_Smuggler_LostToCombat
#. TYPE: Detection
#. SUBTYPE: LostToCombat
msgctxt "0104EC"
msgid "Found them!"
msgstr "찾았다!"

#. SCRIPT NOTES: Angry
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Angry
#. QUEST: SFBGS001_DialogueHVGenericVaruunShips
#. TOPIC: 010CE1A1
#. INFO GROUP: SFBGS001_VaruunZealotShips_Taunt
#. TYPE: Combat
#. SUBTYPE: Taunt
