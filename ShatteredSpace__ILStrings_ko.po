#. TYPE: SceneDialogue
#. SUBTYPE: Custom
msgctxt "012180"
msgid "Just passing through."
msgstr "그냥 지나가는 길입니다."

#. SCRIPT NOTES:  / to Player Default
#. ALIAS: NPC_Leader
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Neutral
#. QUEST: SFBGS001_OE_BonecrestOverrun
#. TOPIC: 010E7951
#. SCENE: SFBGS001_OE_BonecrestOverrun_MinerLeader02_Scene
#. TYPE: SceneDialogue
#. SUBTYPE: Custom
