#. TYPE: SceneDialogue
#. SUBTYPE: Custom
msgctxt "0013AF"
msgid "It is done."
msgstr "완료됐다."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. PROMPT: Salvage rights are enough for me.
#. DIALOGUE BEFORE: Player Default: Salvage rights are enough for me.
#. ALIAS: HailingShipVaruun
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Spaceship / Neutral
#. QUEST: SFBGS001_SE_Player_Attack12
#. TOPIC: 0115852D
#. SCENE: SFBGS001_Attack12_200b_AttackerHailAccepted
#. INFO GROUP: FormID 01158541
#. TYPE: Miscellaneous
#. SUBTYPE: SharedInfo
msgctxt "0013AE"
msgid "Leave no bone unpicked."
msgstr "뼈 하나도 남기지 마라."

#. SCRIPT NOTES: Ship dialogue no cubic needed
#. PROMPT: Salvage rights are enough for me.
#. DIALOGUE BEFORE: Player Default: Salvage rights are enough for me.
