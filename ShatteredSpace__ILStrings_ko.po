#. VOICE TYPE: SFBGS001_NPCXMirekKadic
#. FACE: Irritated
#. QUEST: SFBGS001_MQ03
#. TOPIC: 010E3DAD
#. INFO GROUP: SFBGS001_MQ03_0280_MirekHellos
#. TYPE: Miscellaneous
#. SUBTYPE: Hello
msgctxt "011EFC"
msgid "Serpent grant me patience."
msgstr "뱀이시여, 인내심을 주소서."

#. SCRIPT NOTES: Believes the player killed her nephew. / Disgust
#. VOICE TYPE: SFBGS001_NPCFVitoriaVethaal
#. FACE: Disgust
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD8A
#. INFO GROUP: SFBGS001_MQ_VitoriaHellos
#. TYPE: Miscellaneous
#. SUBTYPE: Hello
msgctxt "011EFB"
msgid "Leave me be."
msgstr "날 좀 내버려둬."

#. SCRIPT NOTES: Concerned
#. VOICE TYPE: SFBGS001_NPCXMirekKadic
#. FACE: Concerned
#. QUEST: SFBGS001_MQ03
#. TOPIC: 010E3DAD
#. INFO GROUP: SFBGS001_MQ03_0270_MirekHellos
#. TYPE: Miscellaneous
#. SUBTYPE: Hello
msgctxt "011EFA"
msgid "Remember what I said. The Zealots are people, too."
msgstr "내가 한 말 명심해. 광신도들도 사람이야."

#. SCRIPT NOTES: Concerned
#. VOICE TYPE: SFBGS001_NPCXMirekKadic
#. FACE: Concerned
#. QUEST: SFBGS001_MQ03
#. TOPIC: 010E3DAD
#. INFO GROUP: SFBGS001_MQ03_0270_MirekHellos
#. TYPE: Miscellaneous
#. SUBTYPE: Hello
msgctxt "011EF9"
msgid "Do your job well, and hopefully, I'll still have one to go back to."
msgstr "일 잘 해 보라고. 나도 나중에 다시 복귀할 수 있게 되길 바랄게."

#. SCRIPT NOTES: Concerned
#. VOICE TYPE: SFBGS001_NPCXMirekKadic
#. FACE: Concerned
