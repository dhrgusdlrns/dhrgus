#. FACE: Neutral
#. QUEST: SFBGS001_DialogueUnique
#. TOPIC: 011030F8
#. INFO GROUP: FormID 0110312D
#. TYPE: Combat
#. SUBTYPE: Steal
msgctxt "012AC3"
msgid "You are not walking away with that."
msgstr "그걸 가지고 도망칠 수는 없을 겁니다."

#. VOICE TYPE: SFBGS001_NPCFTevinaVethaal
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueUnique
#. TOPIC: 011030F8
#. INFO GROUP: FormID 0110312D
#. TYPE: Combat
#. SUBTYPE: Steal
msgctxt "012AC2"
msgid "Stop this nonsense."
msgstr "그만두시죠."

#. VOICE TYPE: SFBGS001_NPCFTevinaVethaal
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueUnique
#. TOPIC: 011030FA
#. INFO GROUP: FormID 01103144
#. TYPE: Combat
#. SUBTYPE: StealTakeback
msgctxt "012AC1"
msgid "Give it back, or I call the guards!"
msgstr "돌려놔요. 안 그러면 경비대를 부르겠어요!"

#. VOICE TYPE: SFBGS001_NPCFTevinaVethaal
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueUnique
#. TOPIC: 011030FA
#. INFO GROUP: FormID 01103144
#. TYPE: Combat
#. SUBTYPE: StealTakeback
msgctxt "012AC0"
msgid "Enough of this, give it back!"
msgstr "그만하고, 돌려놔요!"

#. VOICE TYPE: SFBGS001_NPCFTevinaVethaal
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueUnique
#. TOPIC: 011030FA
#. INFO GROUP: FormID 01103144
#. TYPE: Combat
#. SUBTYPE: StealTakeback
msgctxt "012ABF"
msgid "Return that this instant!"
msgstr "당장 돌려놔요!"

#. VOICE TYPE: SFBGS001_NPCFTevinaVethaal
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueUnique
#. TOPIC: 011030F9
#. INFO GROUP: FormID 0110313F
#. TYPE: Combat
#. SUBTYPE: StealTakebackSuccess
msgctxt "012ABE"
msgid "Do not ever attempt that again."
msgstr "다시는 그런 짓 하지 마세요."

#. VOICE TYPE: SFBGS001_NPCFTevinaVethaal
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueUnique
#. TOPIC: 011030F9
#. INFO GROUP: FormID 0110313F
#. TYPE: Combat
#. SUBTYPE: StealTakebackSuccess
msgctxt "012ABD"
msgid "Next time I call the guards, and they are not kind to thieves."
msgstr "다음엔 경비대를 부를 거예요. 경비대는 도둑에게 친절하지 않아요."

#. VOICE TYPE: SFBGS001_NPCFTevinaVethaal
#. FACE: Neutral
#. QUEST: SFBGS001_DialogueUnique
#. TOPIC: 011030F9
#. INFO GROUP: FormID 0110313F
#. TYPE: Combat
#. SUBTYPE: StealTakebackSuccess
msgctxt "012ABC"
msgid "That was regrettable, do not do that again."
msgstr "유감스러운 일이군요. 다시는 그러지 마세요."

#. VOICE TYPE: SFBGS001_NPCFTevinaVethaal
