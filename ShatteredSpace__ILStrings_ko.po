#. INFO GROUP: SFBGS001_VorisNerun_Goodbyes
#. TYPE: Miscellaneous
#. SUBTYPE: Goodbye
msgctxt "014046"
msgid "Adherent."
msgstr "지지자."

#. SCRIPT NOTES: Generic House Veth'aal greeting. Solemn, reverent. / Serious
#. VOICE TYPE: SFBGS001_VaruunGenericMale02
#. FACE: Serious
#. QUEST: SFBGS001_DialogueHVDazra
#. TOPIC: 0102FD8A
#. INFO GROUP: SFBGS001_GenericWardens_Hellos
